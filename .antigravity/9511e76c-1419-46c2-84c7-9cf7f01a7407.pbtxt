      replacement_content: "import React, { useState, useEffect } from \"react\";\nimport {\n  SleepRecord,\n  MealItem,\n  DietAdvice,\n  WorkoutRecord,\n  WorkoutPlan,\n  SkillChallenge,\n  ReadingNote,\n  LearningPath,\n  MustDoTask,\n} from \"./types\";\nimport SleepSection from \"./components/SleepSection\";\nimport DietSection from \"./components/DietSection\";\nimport WorkoutSection from \"./components/WorkoutSection\";\nimport ChallengeSection from \"./components/ChallengeSection\";\nimport LearningSection from \"./components/LearningSection\";\nimport {\n  Moon,\n  Utensils,\n  Dumbbell,\n  Compass,\n  BookOpen,\n  Calendar,\n  Sparkles,\n  Award,\n  CheckCircle2,\n  Bookmark,\n  Smartphone,\n  Check,\n  Heart,\n  ChevronRight,\n  Database,\n  ArrowDownToLine,\n  ArrowUpToLine,\n  AlertTriangle,\n  Plus,\n  Trash2\n} from \"lucide-react\";\nimport { motion, AnimatePresence } from \"motion/react\";\n\nconst MOTTO_LIST = [\n  \"\350\207\252\345\276\213\344\270\215\346\230\257\346\235\237\347\274\232\357\274\214\350\200\214\346\230\257\351\200\232\345\276\200\350\207\252\347\224\261\345\224\257\344\270\200\347\232\204\350\267\257\345\276\204\343\200\202\",\n  \"\344\275\240\344\273\212\345\244\251\347\232\204\351\200\211\346\213\251\357\274\214\345\206\263\345\256\232\344\272\206\344\275\240\344\270\211\345\271\264\345\220\216\347\232\204\346\250\241\346\240\267\343\200\202\",\n  \"\344\270\215\347\247\257\350\267\254\346\255\245\357\274\214\346\227\240\344\273\245\350\207\263\345\215\203\351\207\214\357\274\233\344\270\215\347\247\257\345\260\217\346\265\201\357\274\214\346\227\240\344\273\245\346\210\220\346\261\237\346\265\267\343\200\202\",\n  \"\346\257\217\344\270\200\344\270\252\344\270\215\346\233\276\350\265\267\350\210\236\347\232\204\346\227\245\345\255\220\357\274\214\351\203\275\346\230\257\345\257\271\347\224\237\345\221\275\347\232\204\350\276\234\350\264\237\343\200\202\",\n  \"\346\227\251\346\231\250\345\217\253\351\206\222\344\275\240\347\232\204\344\270\215\350\257\245\346\230\257\351\227\271\351\222\237\357\274\214\350\200\214\345\272\224\350\257\245\346\230\257\344\274\237\345\244\247\347\232\204\346\242\246\346\203\263\343\200\202\",\n  \"\346\211\200\350\260\223\345\205\211\350\276\211\345\262\201\346\234\210\357\274\214\346\216\247\345\210\266\350\207\252\346\210\221\357\274\214\346\226\271\350\203\275\346\211\247\346\216\214\346\234\252\346\235\245\347\224\237\345\221\275\347\232\204\345\244\232\351\207\215\347\273\264\345\272\246\343\200\202\",\n];\n\nexport default function App() {\n  const [activeTab, setActiveTab] = useState<\"sleep\" | \"diet\" | \"workout\" | \"challenge\" | \"learning\">(\"sleep\");\n  const [motto, setMotto] = useState(\"\");\n\n  // States initialized from LocalStorage\n  const [sleepRecords, setSleepRecords] = useState<SleepRecord[]>(() => {\n    const raw = localStorage.getItem(\"sd_sleep_records\");\n    return raw ? JSON.parse(raw) : [];\n  });\n\n  const [mealItems, setMealItems] = useState<MealItem[]>(() => {\n    const raw = localStorage.getItem(\"sd_meal_items\");\n    return raw ? JSON.parse(raw) : [];\n  });\n\n  const [dietAdvice, setDietAdvice] = useState<DietAdvice | null>(() => {\n    const raw = localStorage.getItem(\"sd_diet_advice\");\n    return raw ? JSON.parse(raw) : null;\n  });\n\n  const [workoutRecords, setWorkoutRecords] = useState<WorkoutRecord[]>(() => {\n    const raw = localStorage.getItem(\"sd_workout_records\");\n    return raw ? JSON.parse(raw) : [];\n  });\n\n  const [workoutPlans, setWorkoutPlans] = useState<WorkoutPlan[]>(() => {\n    const raw = localStorage.getItem(\"sd_workout_plans\");\n    return raw ? JSON.parse(raw) : [];\n  });\n\n  const [skillChallenges, setSkillChallenges] = useState<SkillChallenge[]>(() => {\n    const raw = localStorage.getItem(\"sd_skill_challenges\");\n    return raw ? JSON.parse(raw) : [];\n  });\n\n  const [readingNotes, setReadingNotes] = useState<ReadingNote[]>(() => {\n    const raw = localStorage.getItem(\"sd_reading_notes\");\n    return raw ? JSON.parse(raw) : [];\n  });\n\n  const [learningPaths, setLearningPaths] = useState<LearningPath[]>(() => {\n    const raw = localStorage.getItem(\"sd_learning_paths\");\n    return raw ? JSON.parse(raw) : [];\n  });\n\n  // Must-Do Tasks State\n  const [mustDoTasks, setMustDoTasks] = useState<MustDoTask[]>(() => {\n    const raw = localStorage.getItem(\"sd_must_do_tasks\");\n    return raw ? JSON.parse(raw) : [\n      { id: \"1\", period: \"today\", text: \"\344\273\212\346\227\245\351\230\205\350\257\27320\345\210\206\351\222\237\346\210\226\345\244\215\347\233\230\347\254\224\350\256\260\", completed: false, createdAt: new Date().toISOString().split(\"T\")[0] },\n      { id: \"2\", period: \"week\", text: \"\346\234\254\345\221\250\350\207\263\345\260\221\346\205\242\350\267\221\346\211\223\345\215\241\344\270\200\346\254\2415\345\205\254\351\207\214\", completed: false, createdAt: new Date().toISOString().split(\"T\")[0] },\n      { id: \"3\", period: \"month\", text: \"\346\234\254\346\234\210\346\224\273\345\205\213\344\270\200\351\227\250\344\270\223\344\270\232\346\240\270\345\277\203\346\212\200\350\203\275\351\207\214\347\250\213\347\242\221\", completed: false, createdAt: new Date().toISOString().split(\"T\")[0] },\n    ];\n  });\n\n  // Backup states\n  const [showBackupPanel, setShowBackupPanel] = useState(false);\n  const [newTaskPeriod, setNewTaskPeriod] = useState<\"today\" | \"week\" | \"month\">(\"today\");\n  const [newTaskText, setNewTaskText] = useState(\"\");\n\n  // Synced local storage effects\n  useEffect(() => {\n    localStorage.setItem(\"sd_sleep_records\", JSON.stringify(sleepRecords));\n  }, [sleepRecords]);\n\n  useEffect(() => {\n    localStorage.setItem(\"sd_meal_items\", JSON.stringify(mealItems));\n  }, [mealItems]);\n\n  useEffect(() => {\n    localStorage.setItem(\"sd_diet_advice\", JSON.stringify(dietAdvice));\n  }, [dietAdvice]);\n\n  useEffect(() => {\n    localStorage.setItem(\"sd_workout_records\", JSON.stringify(workoutRecords));\n  }, [workoutRecords]);\n\n  useEffect(() => {\n    localStorage.setItem(\"sd_workout_plans\", JSON.stringify(workoutPlans));\n  }, [workoutPlans]);\n\n  useEffect(() => {\n    localStorage.setItem(\"sd_skill_challenges\", JSON.stringify(skillChallenges));\n  }, [skillChallenges]);\n\n  useEffect(() => {\n    localStorage.setItem(\"sd_reading_notes\", JSON.stringify(readingNotes));\n  }, [readingNotes]);\n\n  useEffect(() => {\n    localStorage.setItem(\"sd_learning_paths\", JSON.stringify(learningPaths));\n  }, [learningPaths]);\n\n  useEffect(() => {\n    localStorage.setItem(\"sd_must_do_tasks\", JSON.stringify(mustDoTasks));\n  }, [mustDoTasks]);\n\n  // Daily Wisdom Randomizer\n  useEffect(() => {\n    const rand = MOTTO_LIST[Math.floor(Math.random() * MOTTO_LIST.length)];\n    setMotto(rand);\n  }, [activeTab]);\n\n  // Statistics & Progress Widget\n  const getTodayStats = () => {\n    const todayStr = new Date().toISOString().split(\"T\")[0];\n\n    const sleepLogged = sleepRecords.some((r) => r.date === todayStr);\n    const dietLoggedCount = mealItems.filter((m) => m.date === todayStr).length;\n    const workoutLogged = workoutRecords.some((w) => w.date === todayStr);\n    const ongoingChallengesCount = skillChallenges.filter((c) => c.status === \"\350\277\233\350\241\214\344\270\255\").length;\n    const learningMilestonesCompletedToday = learningPaths.some((p) =>\n      p.milestones.some((m) => m.completed)\n    );\n    const loggedNewReadingNote = readingNotes.some((n) => n.date === todayStr);\n\n    let progressPoints = 0;\n    if (sleepLogged) progressPoints += 20;\n    if (dietLoggedCount > 0) progressPoints += Math.min(20, dietLoggedCount * 7);\n    if (workoutLogged) progressPoints += 20;\n    if (ongoingChallengesCount > 0) progressPoints += 15;\n    if (loggedNewReadingNote || learningMilestonesCompletedToday) progressPoints += 25;\n\n    return {\n      sleepLogged,\n      dietLoggedCount,\n      workoutLogged,\n      ongoingChallengesCount,\n      learningDone: loggedNewReadingNote || learningMilestonesCompletedToday,\n      totalScore: Math.min(100, progressPoints),\n    };\n  };\n\n  const todayStats = getTodayStats();\n\n  // Incomplete counts for Prominent Reminders\n  const incompleteToday = mustDoTasks.filter((t) => t.period === \"today\" && !t.completed).length;\n  const incompleteWeek = mustDoTasks.filter((t) => t.period === \"week\" && !t.completed).length;\n  const incompleteMonth = mustDoTasks.filter((t) => t.period === \"month\" && !t.completed).length;\n  const totalIncomplete = incompleteToday + incompleteWeek + incompleteMonth;\n\n  // Handlers for route state changes\n  const handleAddSleep = (rec: SleepRecord) => {\n    setSleepRecords([rec, ...sleepRecords]);\n  };\n  const handleDeleteSleep = (id: string) => {\n    setSleepRecords(sleepRecords.filter((r) => r.id !== id));\n  };\n\n  const handleAddMeal = (meal: MealItem) => {\n    setMealItems([meal, ...mealItems]);\n  };\n  const handleDeleteMeal = (id: string) => {\n    setMealItems(mealItems.filter((m) => m.id !== id));\n  };\n  const handleClearMeals = () => {\n    const todayStr = new Date().toISOString().split(\"T\")[0];\n    setMealItems(mealItems.filter((m) => m.date !== todayStr));\n    setDietAdvice(null);\n  };\n\n  const handleAddWorkout = (rec: WorkoutRecord) => {\n    setWorkoutRecords([rec, ...workoutRecords]);\n  };\n  const handleDeleteWorkout = (id: string) => {\n    setWorkoutRecords(workoutRecords.filter((w) => w.id !== id));\n  };\n  const handleAddWorkoutPlan = (plan: WorkoutPlan) => {\n    setWorkoutPlans([...workoutPlans, plan]);\n  };\n\n  const handleAddChallenge = (ch: SkillChallenge) => {\n    setSkillChallenges([ch, ...skillChallenges]);\n  };\n  const handleUpdateChallengeStatus = (id: string, status: \"\350\277\233\350\241\214\344\270\255\" | \"\345\267\262\345\256\214\346\210\220\" | \"\345\267\262\346\224\276\345\274\203\") => {\n    setSkillChallenges(\n      skillChallenges.map((ch) => {\n        if (ch.id === id) {\n          return {\n            ...ch,\n            status,\n            completedDate: status === \"\345\267\262\345\256\214\346\210\220\" ? new Date().toISOString().split(\"T\")[0] : undefined,\n          };\n        }\n        return ch;\n      })\n    );\n  };\n  const handleDeleteChallenge = (id: string) => {\n    setSkillChallenges(skillChallenges.filter((ch) => ch.id !== id));\n  };\n\n  const handleAddReadingNote = (note: ReadingNote) => {\n    setReadingNotes([note, ...readingNotes]);\n  };\n  const handleDeleteReadingNote = (id: string) => {\n    setReadingNotes(readingNotes.filter((n) => n.id !== id));\n  };\n  const handleAddLearningPath = (path: LearningPath) => {\n    const updated = learningPaths.map((p) => ({ ...p, active: false }));\n    setLearningPaths([path, ...updated]);\n  };\n  const handleToggleMilestone = (pathId: string, phaseTitle: string) => {\n    setLearningPaths(\n      learningPaths.map((p) => {\n        if (p.id === pathId) {\n          return {\n            ...p,\n            milestones: p.milestones.map((m) => {\n              if (m.title === phaseTitle) {\n                return { ...m, completed: !m.completed };\n              }\n              return m;\n            }),\n          };\n        }\n        return p;\n      })\n    );\n  };\n  const handleDeleteLearningPath = (id: string) => {\n    setLearningPaths(learningPaths.filter((p) => p.id !== id));\n  };\n\n  // Must Do functions\n  const handleAddMustDoTask = (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!newTaskText.trim()) return;\n    const t: MustDoTask = {\n      id: crypto.randomUUID(),\n      period: newTaskPeriod,\n      text: newTaskText.trim(),\n      completed: false,\n      createdAt: new Date().toISOString().split(\"T\")[0]\n    };\n    setMustDoTasks([...mustDoTasks, t]);\n    setNewTaskText(\"\");\n  };\n\n  const handleToggleMustDoTask = (id: string) => {\n    setMustDoTasks(\n      mustDoTasks.map((t) => (t.id === id ? { ...t, completed: !t.completed } : t))\n    );\n  };\n\n  const handleDeleteMustDoTask = (id: string) => {\n    setMustDoTasks(mustDoTasks.filter((t) => t.id !== id));\n  };\n\n  // Import / Export backup mechanics\n  const handleExportData = () => {\n    const backup: Record<string, any> = {\n      sd_sleep_records: sleepRecords,\n      sd_meal_items: mealItems,\n      sd_diet_advice: dietAdvice,\n      sd_workout_records: workoutRecords,\n      sd_workout_plans: workoutPlans,\n      sd_skill_challenges: skillChallenges,\n      sd_reading_notes: readingNotes,\n      sd_learning_paths: learningPaths,\n      sd_must_do_tasks: mustDoTasks,\n    };\n    \n    const blob = new Blob([JSON.stringify(backup, null, 2)], { type: \"application/json\" });\n    const url = URL.createObjectURL(blob);\n    const a = document.createElement(\"a\");\n    a.href = url;\n    a.download = `self_discipline_assistant_backup_${new Date().toISOString().split(\"T\")[0]}.json`;\n    a.click();\n    URL.revokeObjectURL(url);\n  };\n\n  const handleImportData = (e: React.ChangeEvent<HTMLInputElement>) => {\n    const file = e.target.files?.[0];\n    if (!file) return;\n\n    const reader = new FileReader();\n    reader.onload = (event) => {\n      try {\n        const json = JSON.parse(event.target?.result as string);\n        if (typeof json !== \"object\") throw new Error(\"\346\227\240\346\225\210\347\232\204\345\244\207\344\273\275\347\273\223\346\236\204\");\n\n        // Parse individual items\n        if (json.sd_sleep_records) setSleepRecords(json.sd_sleep_records);\n        if (json.sd_meal_items) setMealItems(json.sd_meal_items);\n        if (json.sd_diet_advice !== undefined) setDietAdvice(json.sd_diet_advice);\n        if (json.sd_workout_records) setWorkoutRecords(json.sd_workout_records);\n        if (json.sd_workout_plans) setWorkoutPlans(json.sd_workout_plans);\n        if (json.sd_skill_challenges) setSkillChallenges(json.sd_skill_challenges);\n        if (json.sd_reading_notes) setReadingNotes(json.sd_reading_notes);\n        if (json.sd_learning_paths) setLearningPaths(json.sd_learning_paths);\n        if (json.sd_must_do_tasks) setMustDoTasks(json.sd_must_do_tasks);\n\n        alert(\"\360\237\216\211 \346\225\260\346\215\256\345\257\274\345\205\245\346\211\223\345\215\241\345\214\205\346\210\220\345\212\237\357\274\201\346\211\200\346\234\211\350\207\252\345\276\213\346\241\243\346\241\210\345\267\262\345\256\211\345\205\250\350\275\275\345\205\245\343\200\202\");\n      } catch (err) {\n        alert(\"\345\257\274\345\205\245\350\247\243\346\236\220\345\244\261\350\264\245\357\274\214\350\257\267\347\241\256\344\277\235\346\202\250\344\270\212\344\274\240\347\232\204\346\230\257\347\224\261\346\234\254\345\272\224\347\224\250\345\257\274\345\207\272\347\232\204\346\240\207\345\207\206 JSON \346\225\260\346\215\256\345\214\205\343\200\202\");\n      }\n    };\n    reader.readAsText(file);\n  };\n\n  return (\n    <div className=\"min-h-screen bg-slate-50 text-slate-900 flex flex-col font-sans antialiased\">\n      \n      {/* Absolute Header - Minimal Slate Charcoal Banner */}\n      <header className=\"sticky top-0 z-50 bg-white/95 backdrop-blur-md border-b border-slate-200/80 px-4 py-3 shadow-xs shrink-0 select-none\">\n        <div className=\"max-w-4xl mx-auto flex items-center justify-between\">\n          <div className=\"flex items-center gap-2\">\n            <div className=\"bg-slate-900 rounded-xl p-2.5 text-white\">\n              <Award size={18} className=\"text-emerald-400\" />\n            </div>\n            <div>\n              <h1 className=\"text-sm font-extrabold tracking-tight text-slate-900 flex items-center gap-1.5\">\n                <span>\350\207\252\345\276\213\344\277\256\350\241\214\347\256\241\345\256\266</span>\n                <span className=\"text-[9px] bg-slate-100 border border-slate-200 text-slate-500 font-bold px-1.5 py-0.5 rounded-full flex items-center gap-0.5\">\n                  <Smartphone size={8} />\n                  <span>\346\236\201\347\256\200\351\243\216</span>\n                </span>\n              </h1>\n              <p className=\"text-[9px] text-slate-400 font-medium font-mono\">2026 \351\253\230\345\244\204\345\276\256\345\205\211 \346\257\217\346\227\245\350\267\265\350\241\214</p>\n            </div>\n          </div>\n\n          <div className=\"flex items-center gap-3\">\n            {/* Backup toggle button */}\n            <button\n              onClick={() => setShowBackupPanel(!showBackupPanel)}\n              className=\"p-1 px-2 text-[10px] border border-slate-200 hover:bg-slate-50 text-slate-500 hover:text-slate-700 rounded-lg flex items-center gap-1 cursor-pointer transition-all font-semibold\"\n              title=\"\346\225\260\346\215\256\345\244\207\344\273\275\344\270\216\345\257\274\345\205\245\345\257\274\345\207\272\"\n            >\n              <Database size={11} className=\"text-slate-400\" />\n              <span>\346\225\260\346\215\256\345\244\207\344\273\275</span>\n            </button>\n\n            {/* Core Daily Mini Score panel */}\n            <div className=\"flex items-center gap-1.5 bg-slate-50 border border-slate-100 p-1 rounded-xl\">\n              <div className=\"text-right\">\n                <div className=\"text-[8px] text-slate-400 font-bold uppercase tracking-wider\">\344\273\212\346\227\245\346\214\207\346\225\260</div>\n                <div className=\"text-[9px] text-slate-500 font-bold font-mono\">\n                  {todayStats.totalScore === 100 ? \"\360\237\221\221 \345\244\247\345\234\206\346\273\241\" : `\350\276\276\346\210\220 ${todayStats.totalScore}%`}\n                </div>\n              </div>\n              <div className=\"h-8.5 w-8.5 rounded-full bg-slate-900 flex items-center justify-center font-extrabold text-xs text-white shadow-xs font-mono border border-slate-800\">\n                {todayStats.totalScore}\n              </div>\n            </div>\n          </div>\n        </div>\n      </header>\n\n      {/* Backup and restore drop-down box */}\n      <AnimatePresence>\n        {showBackupPanel && (\n          <motion.section\n            initial={{ opacity: 0, height: 0 }}\n            animate={{ opacity: 1, height: \"auto\" }}\n            exit={{ opacity: 0, height: 0 }}\n            className=\"bg-slate-100 border-b border-slate-200 overflow-hidden text-xs text-slate-700\"\n          >\n            <div className=\"max-w-4xl mx-auto p-4 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3\">\n              <div className=\"space-y-0.5\">\n                <h4 className=\"font-bold text-slate-850 flex items-center gap-1\">\n                  <span>\360\237\222\276 \350\207\252\345\276\213\346\225\260\346\215\256\345\244\207\344\273\275\343\200\201\350\277\201\345\207\272\344\270\216\345\257\274\345\205\245</span>\n                </h4>\n                <p className=\"text-[11px] text-slate-500\">\n                  \346\234\254\345\234\260\346\211\223\345\215\241\350\256\260\345\275\225\345\255\230\345\202\250\345\234\250\346\202\250\346\211\213\346\234\272\346\265\217\350\247\210\345\231\250\347\232\204 localStorage \344\270\255\357\274\214\351\200\232\350\277\207\345\244\207\344\273\275\345\217\257\351\230\262\344\270\242\345\244\261\346\210\226\347\247\273\346\244\215\345\210\260\345\205\266\345\256\203\350\256\276\345\244\207\343\200\202\n                </p>\n              </div>\n\n              <div className=\"flex items-center gap-2\">\n                <button\n                  onClick={handleExportData}\n                  className=\"bg-white hover:bg-slate-50 border border-slate-200 rounded-lg px-2.5 py-1.5 text-[11px] font-semibold text-slate-700 flex items-center gap-1 cursor-pointer transition-all active:scale-[0.98]\"\n                >\n                  <ArrowDownToLine size={12} className=\"text-slate-500\" />\n                  <span>\345\257\274\345\207\272\345\244\207\344\273\275 JSON</span>\n                </button>\n\n                <div className=\"relative\">\n                  <input\n                    type=\"file\"\n                    accept=\".json\"\n                    onChange={handleImportData}\n                    className=\"absolute inset-0 opacity-0 cursor-pointer w-full h-full\"\n                  />\n                  <button\n                    type=\"button\"\n                    className=\"bg-slate-850 hover:bg-slate-950 text-white rounded-lg px-2.5 py-1.5 text-[11px] font-semibold flex items-center gap-1 cursor-not-allowed pointer-events-none\"\n                  >\n                    <ArrowUpToLine size={12} className=\"text-slate-350\" />\n                    <span>\345\257\274\345\205\245\345\244\207\344\273\275 JSON</span>\n                  </button>\n                  {/* Real clickable uploader overlay */}\n                  <label className=\"absolute inset-0 cursor-pointer\">\n                    <input\n                      type=\"file\"\n                      accept=\".json\"\n                      onChange={handleImportData}\n                      className=\"hidden\"\n                    />\n                    <div className=\"w-full h-full\"></div>\n                  </label>\n                </div>\n              </div>\n            </div>\n          </motion.section>\n        )}\n      </AnimatePresence>\n\n      {/* Inspirational Quote and Prompt Bulletins */}\n      <section className=\"bg-white border-b border-slate-150 px-4 py-3 shrink-0\">\n        <div className=\"max-w-4xl mx-auto space-y-3\">\n          {/* Quote */}\n          <div className=\"text-center rounded-lg bg-slate-50 p-1.5 border border-slate-100\">\n            <p className=\"text-[11px] text-slate-650 leading-relaxed font-semibold italic\">\n              \342\200\234 {motto || \"\350\207\252\345\276\213\351\223\270\345\260\261\346\233\264\345\245\275\347\232\204\346\234\252\346\235\245\343\200\202\"} \342\200\235\n            </p>\n          </div>\n\n          {/* Prominent reminders of Today\'s/This Week\'s/This Month\'s Incomplete Committed Tasks */}\n          {totalIncomplete > 0 && (\n            <div className=\"bg-amber-50/50 border border-amber-200/80 rounded-xl p-3 flex gap-2.5 items-start text-amber-950 animate-pulse\">\n              <AlertTriangle size={15} className=\"shrink-0 text-amber-600 mt-0.5\" />\n              <div className=\"space-y-0.5 flex-1\">\n                <span className=\"font-extrabold text-[11px]\">\342\217\263 \350\207\252\345\276\213\350\252\223\350\250\200\346\217\220\351\206\222\357\274\232\346\202\250\346\234\211 {totalIncomplete} \351\241\271\345\205\263\351\224\256\345\277\205\345\201\232\350\257\272\350\250\200\346\234\211\345\276\205\345\261\245\350\241\214\357\274\201</span>\n                <p className=\"text-[10px] text-amber-900 leading-relaxed font-medium\">\n                  \344\273\212\346\227\245\346\234\211 <span className=\"font-bold underline\">{incompleteToday}</span> \351\241\271\343\200\201\346\234\254\345\221\250\346\234\211 <span className=\"font-bold underline\">{incompleteWeek}</span> \351\241\271\343\200\201\346\234\254\346\234\210\346\234\211 <span className=\"font-bold underline\">{incompleteMonth}</span> \351\241\271\344\273\215\346\234\252\345\261\245\347\272\246\343\200\202\350\265\267\347\202\271\345\206\263\345\256\232\351\253\230\345\272\246\357\274\214\347\253\213\345\215\263\345\234\250\344\270\213\346\226\271\350\252\223\350\250\200\346\235\277\346\211\223\345\215\241\357\274\201\n                </p>\n              </div>\n            </div>\n          )}\n\n          {/* Checklist horizontal strip */}\n          <div className=\"flex justify-between items-center bg-slate-50/50 rounded-xl p-2.5 border border-slate-100 overflow-x-auto text-[11px] gap-2 select-none\">\n            <div className=\"flex items-center gap-1.5 shrink-0\">\n              <Calendar size={12} className=\"text-slate-500\" />\n              <span className=\"font-bold text-slate-700\">\344\273\212\346\227\245\345\260\217\346\211\223\345\215\241:</span>\n            </div>\n            <div className=\"flex items-center gap-3 shrink-0\">\n              <span className=\"flex items-center gap-1\">\n                <span className={`h-4 w-4 rounded-full flex items-center justify-center border text-[9px] ${\n                  todayStats.sleepLogged ? \"bg-slate-800 border-slate-800 text-white font-bold\" : \"border-slate-300 text-transparent\"\n                }`}>\342\234\223</span>\n                <span className={todayStats.sleepLogged ? \"text-slate-900 font-bold\" : \"text-slate-400\"}>\344\275\234\346\201\257\345\267\262\347\231\273</span>\n              </span>\n\n              <span className=\"flex items-center gap-1\">\n                <span className={`h-4 w-4 rounded-full flex items-center justify-center border text-[9px] ${\n                  todayStats.dietLoggedCount > 0 ? \"bg-emerald-600 border-emerald-650 text-white font-bold\" : \"border-slate-300 text-transparent\"\n                }`}>\342\234\223</span>\n                <span className={todayStats.dietLoggedCount > 0 ? \"text-emerald-950 font-bold\" : \"text-slate-400\"}>\n                  \351\244\220\351\245\256({todayStats.dietLoggedCount})\n                </span>\n              </span>\n\n              <span className=\"flex items-center gap-1\">\n                <span className={`h-4 w-4 rounded-full flex items-center justify-center border text-[9px] ${\n                  todayStats.workoutLogged ? \"bg-orange-500 border-orange-550 text-white font-bold\" : \"border-slate-300 text-transparent\"\n                }`}>\342\234\223</span>\n                <span className={todayStats.workoutLogged ? \"text-orange-950 font-bold\" : \"text-slate-400\"}>\350\277\220\345\212\250\346\211\223\345\215\241</span>\n              </span>\n\n              <span className=\"flex items-center gap-1\">\n                <span className={`h-4 w-4 rounded-full flex items-center justify-center border text-[9px] ${\n                  todayStats.learningDone ? \"bg-slate-800 border-slate-800 text-white font-bold\" : \"border-slate-300 text-transparent\"\n                }`}>\342\234\223</span>\n                <span className={todayStats.learningDone ? \"text-slate-905 font-bold\" : \"text-slate-400\"}>\351\230\205\350\257\273\346\262\211\346\267\200</span>\n              </span>\n            </div>\n          </div>\n        </div>\n      </section>\n\n      {/* Main Work Area */}\n      <main className=\"flex-1 overflow-y-auto px-4 py-5 pb-16\">\n        <div className=\"max-w-4xl mx-auto space-y-6\">\n          \n          {/* MUST-DO TASKS COMMITMENT DASHBOARD CARD */}\n          <section className=\"bg-white border border-slate-200/60 rounded-xl p-5 shadow-xs space-y-4\">\n            <div className=\"flex items-center justify-between border-b border-slate-50 pb-2\">\n              <div className=\"flex items-center gap-2\">\n                <span className=\"text-slate-850\">\360\237\216\257</span>\n                <h3 className=\"text-sm font-extrabold text-slate-800\">\n                  \344\273\212\345\244\251 / \346\234\254\345\221\250 / \346\234\254\346\234\210 \347\273\235\345\257\271\345\277\205\351\241\273\350\246\201\345\201\232\347\232\204 N \344\273\266\344\272\213 (\350\252\223\350\250\200\346\211\277\350\257\272\346\235\277)\n                </h3>\n              </div>\n              <span className=\"text-[10px] text-slate-400 font-semibold font-mono\">\346\234\252\347\253\237\346\211\277\350\257\272: {totalIncomplete} \344\273\266</span>\n            </div>\n\n            {/* Quick add must-do task */}\n            <form onSubmit={handleAddMustDoTask} className=\"grid grid-cols-1 sm:grid-cols-12 gap-2\">\n              <div className=\"sm:col-span-3\">\n                <select\n                  value={newTaskPeriod}\n                  onChange={(e) => setNewTaskPeriod(e.target.value as \"today\" | \"week\" | \"month\")}\n                  className=\"w-full text-xs border border-slate-200 rounded-lg p-2.5 bg-white text-slate-700 font-bold focus:outline-none\"\n                >\n                  <option value=\"today\">\360\237\223\205 \344\273\212\345\244\251\345\277\205\351\241\273\345\201\232</option>\n                  <option value=\"week\">\360\237\227\223\357\270\217 \346\234\254\345\221\250\345\277\205\351\241\273\345\201\232</option>\n                  <option value=\"month\">\360\237\223\212 \346\234\254\346\234\210\345\277\205\351\241\273\345\201\232</option>\n                </select>\n              </div>\n              <div className=\"sm:col-span-7\">\n                <input\n                  type=\"text\"\n                  required\n                  placeholder=\"\347\253\213\344\270\213\346\226\251\351\222\211\346\210\252\351\223\201\347\232\204\345\274\272\345\212\233\350\252\223\346\204\277\357\274\201\344\276\213\345\246\202\357\274\232\346\231\232\344\270\21211\347\202\271\345\211\215\347\273\235\345\257\271\344\270\212\345\272\212\345\205\263\346\234\272...\"\n                  value={newTaskText}\n                  onChange={(e) => setNewTaskText(e.target.value)}\n                  className=\"w-full text-xs border border-slate-205 rounded-lg p-2.5 focus:outline-none focus:ring-1 focus:ring-slate-400 bg-white\"\n                />\n              </div>\n              <div className=\"sm:col-span-2\">\n                <button\n                  type=\"submit\"\n                  className=\"w-full bg-slate-900 hover:bg-slate-950 text-white rounded-lg p-2.5 text-xs font-bold transition-all flex items-center justify-center gap-1 cursor-pointer\"\n                >\n                  <Plus size={13} />\n                  <span>\345\212\240\345\205\245\350\252\223\350\250\200</span>\n                </button>\n              </div>\n            </form>\n\n            {/* Render 3 Columns representation of today/week/month */}\n            <div className=\"grid grid-cols-1 md:grid-cols-3 gap-4 pt-2\">\n              {/* TODAY COLUMN */}\n              <div className=\"bg-slate-50/60 border border-slate-200/50 p-3.5 rounded-xl space-y-3\">\n                <div className=\"flex items-center justify-between border-b border-slate-100 pb-1.5 select-none\">\n                  <span className=\"text-xs font-extrabold text-slate-800 flex items-center gap-1\">\n                    <span>\360\237\223\205</span>\n                    <span>\344\273\212\345\244\251\345\277\205\345\201\232</span>\n                  </span>\n                  <span className=\"text-[9.5px] bg-slate-200 text-slate-700 px-1.5 rounded font-bold font-mono\">\n                    \345\276\205\345\212\236: {incompleteToday}\n                  </span>\n                </div>\n\n                <div className=\"space-y-2 max-h-44 overflow-y-auto pr-1\">\n                  {mustDoTasks.filter(t => t.period === \"today\").length === 0 ? (\n                    <p className=\"text-[10px] text-slate-400 text-center py-4\">\346\234\254\346\227\245\346\234\252\347\253\213\350\252\223\343\200\202\345\206\231\344\270\213\344\270\200\344\273\266\347\273\235\345\257\271\350\246\201\345\201\232\347\232\204\344\272\213\345\220\247\357\274\201</p>\n                  ) : (\n                    mustDoTasks.filter(t => t.period === \"today\").map(t => (\n                      <div key={t.id} className=\"flex items-start justify-between gap-1.5 p-2 bg-white rounded-lg border border-slate-150 group\">\n                        <label className=\"flex items-start gap-2 cursor-pointer flex-1 text-[11px]\">\n                          <input\n                            type=\"checkbox\"\n                            checked={t.completed}\n                            onChange={() => handleToggleMustDoTask(t.id)}\n                            className=\"mt-0.5 accent-slate-800 scale-102\"\n                          />\n                          <span className={`leading-snug text-slate-700 ${t.completed ? \"line-through text-slate-400 font-light\" : \"font-semibold\"}`}>\n                            {t.text}\n                          </span>\n                        </label>\n                        <button\n                          onClick={() => handleDeleteMustDoTask(t.id)}\n                          className=\"text-slate-350 hover:text-rose-500 p-0.5 opacity-100 md:opacity-0 group-hover:opacity-100 transition-opacity cursor-pointer shrink-0\"\n                        >\n                          <Trash2 size={11} />\n                        </button>\n                      </div>\n                    ))\n                  )}\n                </div>\n              </div>\n\n              {/* WEEK COLUMN */}\n              <div className=\"bg-slate-50/60 border border-slate-200/50 p-3.5 rounded-xl space-y-3\">\n                <div className=\"flex items-center justify-between border-b border-slate-100 pb-1.5 select-none\">\n                  <span className=\"text-xs font-extrabold text-slate-800 flex items-center gap-1\">\n                    <span>\360\237\227\223\357\270\217</span>\n                    <span>\346\234\254\345\221\250\345\277\205\345\201\232</span>\n                  </span>\n                  <span className=\"text-[9.5px] bg-slate-200 text-slate-700 px-1.5 rounded font-bold font-mono\">\n                    \345\276\205\345\212\236: {incompleteWeek}\n                  </span>\n                </div>\n\n                <div className=\"space-y-2 max-h-44 overflow-y-auto pr-1\">\n                  {mustDoTasks.filter(t => t.period === \"week\").length === 0 ? (\n                    <p className=\"text-[10px] text-slate-400 text-center py-4\">\346\234\254\345\221\250\346\234\252\347\253\213\350\252\223\343\200\202\344\277\235\346\214\201\345\211\215\350\241\214\357\274\201</p>\n                  ) : (\n                    mustDoTasks.filter(t => t.period === \"week\").map(t => (\n                      <div key={t.id} className=\"flex items-start justify-between gap-1.5 p-2 bg-white rounded-lg border border-slate-150 group\">\n                        <label className=\"flex items-start gap-2 cursor-pointer flex-1 text-[11px]\">\n                          <input\n                            type=\"checkbox\"\n                            checked={t.completed}\n                            onChange={() => handleToggleMustDoTask(t.id)}\n                            className=\"mt-0.5 accent-slate-800 scale-102\"\n                          />\n                          <span className={`leading-snug text-slate-700 ${t.completed ? \"line-through text-slate-400 font-light\" : \"font-semibold\"}`}>\n                            {t.text}\n                          </span>\n                        </label>\n                        <button\n                          onClick={() => handleDeleteMustDoTask(t.id)}\n                          className=\"text-slate-350 hover:text-rose-500 p-0.5 opacity-100 md:opacity-0 group-hover:opacity-100 transition-opacity cursor-pointer shrink-0\"\n                        >\n                          <Trash2 size={11} />\n                        </button>\n                      </div>\n                    ))\n                  )}\n                </div>\n              </div>\n\n              {/* MONTH COLUMN */}\n              <div className=\"bg-slate-50/60 border border-slate-200/50 p-3.5 rounded-xl space-y-3\">\n                <div className=\"flex items-center justify-between border-b border-slate-100 pb-1.5 select-none\">\n                  <span className=\"text-xs font-extrabold text-slate-800 flex items-center gap-1\">\n                    <span>\360\237\223\212</span>\n                    <span>\346\234\254\346\234\210\345\277\205\345\201\232</span>\n                  </span>\n                  <span className=\"text-[9.5px] bg-slate-200 text-slate-700 px-1.5 rounded font-bold font-mono\">\n                    \345\276\205\345\212\236: {incompleteMonth}\n                  </span>\n                </div>\n\n                <div className=\"space-y-2 max-h-44 overflow-y-auto pr-1\">\n                  {mustDoTasks.filter(t => t.period === \"month\").length === 0 ? (\n                    <p className=\"text-[10px] text-slate-400 text-center py-4\">\346\234\254\346\234\210\346\234\252\347\253\213\350\252\223\343\200\202\350\241\214\347\250\263\350\207\264\350\277\234\357\274\201</p>\n                  ) : (\n                    mustDoTasks.filter(t => t.period === \"month\").map(t => (\n                      <div key={t.id} className=\"flex items-start justify-between gap-1.5 p-2 bg-white rounded-lg border border-slate-150 group\">\n                        <label className=\"flex items-start gap-2 cursor-pointer flex-1 text-[11px]\">\n                          <input\n                            type=\"checkbox\"\n                            checked={t.completed}\n                            onChange={() => handleToggleMustDoTask(t.id)}\n                            className=\"mt-0.5 accent-slate-800 scale-102\"\n                          />\n                          <span className={`leading-snug text-slate-700 ${t.completed ? \"line-through text-slate-400 font-light\" : \"font-semibold\"}`}>\n                            {t.text}\n                          </span>\n                        </label>\n                        <button\n                          onClick={() => handleDeleteMustDoTask(t.id)}\n                          className=\"text-slate-350 hover:text-rose-500 p-0.5 opacity-100 md:opacity-0 group-hover:opacity-100 transition-opacity cursor-pointer shrink-0\"\n                        >\n                          <Trash2 size={11} />\n                        </button>\n                      </div>\n                    ))\n                  )}\n                </div>\n              </div>\n            </div>\n          </section>\n\n          {/* Active core screens tabs */}\n          <AnimatePresence mode=\"wait\">\n            <motion.div\n              key={activeTab}\n              initial={{ opacity: 0, y: 10 }}\n              animate={{ opacity: 1, y: 0 }}\n              exit={{ opacity: 0, y: -10 }}\n              transition={{ duration: 0.12 }}\n            >\n              {activeTab === \"sleep\" && (\n                <SleepSection\n                  records={sleepRecords}\n                  onAddRecord={handleAddSleep}\n                  onDeleteRecord={handleDeleteSleep}\n                />\n              )}\n\n              {activeTab === \"diet\" && (\n                <DietSection\n                  meals={mealItems}\n                  onAddMeal={handleAddMeal}\n                  onDeleteMeal={handleDeleteMeal}\n                  onClearMeals={handleClearMeals}\n                  dietAdvice={dietAdvice}\n                  onSetDietAdvice={setDietAdvice}\n                />\n              )}\n\n              {activeTab === \"workout\" && (\n                <WorkoutSection\n                  records={workoutRecords}\n                  onAddRecord={handleAddWorkout}\n                  onDeleteRecord={handleDeleteWorkout}\n                  workoutPlans={workoutPlans}\n                  onAddPlan={handleAddWorkoutPlan}\n                />\n              )}\n\n              {activeTab === \"challenge\" && (\n                <ChallengeSection\n                  challenges={skillChallenges}\n                  onAddChallenge={handleAddChallenge}\n                  onUpdateChallengeStatus={handleUpdateChallengeStatus}\n                  onDeleteChallenge={handleDeleteChallenge}\n                />\n              )}\n\n              {activeTab === \"learning\" && (\n                <LearningSection\n                  readingNotes={readingNotes}\n                  onAddReadingNote={handleAddReadingNote}\n                  onDeleteReadingNote={handleDeleteReadingNote}\n                  learningPaths={learningPaths}\n                  onAddLearningPath={handleAddLearningPath}\n                  onToggleMilestone={handleToggleMilestone}\n                  onDeleteLearningPath={handleDeleteLearningPath}\n                />\n              )}\n            </motion.div>\n          </AnimatePresence>\n        </div>\n      </main>\n\n      {/* Mobile-optimized Sticky Bottom Navigation Tab Bar (Charcoal / Neutral High Contrast) */}\n      <nav className=\"fixed bottom-0 left-0 right-0 z-50 bg-white border-t border-slate-200 px-2 py-1.5 shadow-lg select-none pb-safe\">\n        <div className=\"max-w-4xl mx-auto grid grid-cols-5 text-center gap-1\">\n          {/* Tab 1: Sleep */}\n          <button\n            onClick={() => setActiveTab(\"sleep\")}\n            className={`py-1.5 px-1 flex flex-col items-center justify-center rounded-xl transition-all cursor-pointer ${\n              activeTab === \"sleep\"\n                ? \"bg-slate-100 text-slate-900 font-bold scale-[1.01]\"\n                : \"text-slate-500 hover:text-slate-800\"\n            }`}\n          >\n            <Moon size={16} className={activeTab === \"sleep\" ? \"stroke-[2.5] text-slate-900\" : \"stroke-2\"} />\n            <span className=\"text-[10px] mt-0.5 tracking-tight\">\347\235\241\347\234\240\344\275\234\346\201\257</span>\n          </button>\n\n          {/* Tab 2: Diet */}\n          <button\n            onClick={() => setActiveTab(\"diet\")}\n            className={`py-1.5 px-1 flex flex-col items-center justify-center rounded-xl transition-all cursor-pointer ${\n              activeTab === \"diet\"\n                ? \"bg-slate-100 text-slate-900 font-bold scale-[1.01]\"\n                : \"text-slate-500 hover:text-slate-800\"\n            }`}\n          >\n            <Utensils size={16} className={activeTab === \"diet\" ? \"stroke-[2.5] text-emerald-700\" : \"stroke-2\"} />\n            <span className=\"text-[10px] mt-0.5 tracking-tight\">\345\201\245\345\272\267\351\245\256\351\243\237</span>\n          </button>\n\n          {/* Tab 3: Workout */}\n          <button\n            onClick={() => setActiveTab(\"workout\")}\n            className={`py-1.5 px-1 flex flex-col items-center justify-center rounded-xl transition-all cursor-pointer ${\n              activeTab === \"workout\"\n                ? \"bg-slate-100 text-slate-900 font-bold scale-[1.01]\"\n                : \"text-slate-500 hover:text-slate-800\"\n            }`}\n          >\n            <Dumbbell size={16} className={activeTab === \"workout\" ? \"stroke-[2.5] text-orange-600\" : \"stroke-2\"} />\n            <span className=\"text-[10px] mt-0.5 tracking-tight\">\350\277\220\345\212\250\345\201\245\350\203\275</span>\n          </button>\n\n          {/* Tab 4: Challenge */}\n          <button\n            onClick={() => setActiveTab(\"challenge\")}\n            className={`py-1.5 px-1 flex flex-col items-center justify-center rounded-xl transition-all cursor-pointer ${\n              activeTab === \"challenge\"\n                ? \"bg-slate-100 text-slate-900 font-bold scale-[1.01]\"\n                : \"text-slate-500 hover:text-slate-800\"\n            }`}\n          >\n            <Compass size={16} className={activeTab === \"challenge\" ? \"stroke-[2.5] text-teal-600\" : \"stroke-2\"} />\n            <span className=\"text-[10px] mt-0.5 tracking-tight\">\345\210\233\346\204\217\345\260\235\346\226\260</span>\n          </button>\n\n          {/* Tab 5: Learning */}\n          <button\n            onClick={() => setActiveTab(\"learning\")}\n            className={`py-1.5 px-1 flex flex-col items-center justify-center rounded-xl transition-all cursor-pointer ${\n              activeTab === \"learning\"\n                ? \"bg-slate-100 text-slate-900 font-bold scale-[1.01]\"\n                : \"text-slate-500 hover:text-slate-800\"\n            }`}\n          >\n            <BookOpen size={16} className={activeTab === \"learning\" ? \"stroke-[2.5] text-slate-905\" : \"stroke-2\"} />\n            <span className=\"text-[10px] mt-0.5 tracking-tight\">\347\273\210\350\272\253\345\255\246\350\257\206</span>\n          </button>\n        </div>\n      </nav>\n    </div>\n  );\n}\n"
    }
