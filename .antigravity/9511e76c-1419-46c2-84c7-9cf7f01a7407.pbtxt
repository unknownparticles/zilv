  file_change {
    absolute_path_uri: "file:///src/components/DietSection.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState, useEffect } from \"react\";\nimport { MealItem, MealPeriod, DietAdvice } from \"../types\";\nimport { Utensils, Award, Sparkles, Loader2, Trash2, Heart, Scale, Camera, ShieldAlert, Check } from \"lucide-react\";\nimport { motion, AnimatePresence } from \"motion/react\";\n\ninterface DietSectionProps {\n  meals: MealItem[];\n  onAddMeal: (meal: MealItem) => void;\n  onDeleteMeal: (id: string) => void;\n  onClearMeals: () => void;\n  dietAdvice: DietAdvice | null;\n  onSetDietAdvice: (advice: DietAdvice | null) => void;\n}\n\nexport default function DietSection({\n  meals,\n  onAddMeal,\n  onDeleteMeal,\n  onClearMeals,\n  dietAdvice,\n  onSetDietAdvice,\n}: DietSectionProps) {\n  const [period, setPeriod] = useState<MealPeriod>(\"\346\227\251\351\244\220\");\n  const [foodText, setFoodText] = useState(\"\");\n  const [note, setNote] = useState(\"\");\n  const [isLoading, setIsLoading] = useState(false);\n  const [errorMessage, setErrorMessage] = useState(\"\");\n\n  // Photo analysis states\n  const [isAnalyzingImage, setIsAnalyzingImage] = useState(false);\n  const [imageAnalysisCount, setImageAnalysisCount] = useState<number>(0);\n  const [successRecognitionInfo, setSuccessRecognitionInfo] = useState<{\n    text: string;\n    period: string;\n    note: string;\n  } | null>(null);\n\n  // Load image upload counter\n  useEffect(() => {\n    const todayStr = new Date().toISOString().split(\"T\")[0];\n    const savedDate = localStorage.getItem(\"sd_camera_analysis_date\") || \"\";\n    const savedCount = localStorage.getItem(\"sd_camera_analysis_count_v1\") || \"0\";\n\n    if (savedDate === todayStr) {\n      setImageAnalysisCount(parseInt(savedCount, 10));\n    } else {\n      setImageAnalysisCount(0);\n      localStorage.setItem(\"sd_camera_analysis_date\", todayStr);\n      localStorage.setItem(\"sd_camera_analysis_count_v1\", \"0\");\n    }\n  }, []);\n\n  const handleSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!foodText.trim()) return;\n\n    const newMeal: MealItem = {\n      id: crypto.randomUUID(),\n      date: new Date().toISOString().split(\"T\")[0],\n      period,\n      text: foodText.trim(),\n      note: note.trim() || undefined,\n    };\n\n    onAddMeal(newMeal);\n    setFoodText(\"\");\n    setNote(\"\");\n    setSuccessRecognitionInfo(null);\n  };\n\n  // Convert and resize image for fast transmission and low server body sizes\n  const resizeAndBase64 = (file: File): Promise<string> => {\n    return new Promise((resolve, reject) => {\n      const reader = new FileReader();\n      reader.readAsDataURL(file);\n      reader.onload = (event) => {\n        const img = new Image();\n        img.src = event.target?.result as string;\n        img.onload = () => {\n          const canvas = document.createElement(\"canvas\");\n          const MAX_WIDTH = 600;\n          const MAX_HEIGHT = 600;\n          let width = img.width;\n          let height = img.height;\n\n          if (width > height) {\n            if (width > MAX_WIDTH) {\n              height *= MAX_WIDTH / width;\n              width = MAX_WIDTH;\n            }\n          } else {\n            if (height > MAX_HEIGHT) {\n              width *= MAX_HEIGHT / height;\n              height = MAX_HEIGHT;\n            }\n          }\n\n          canvas.width = width;\n          canvas.height = height;\n          const ctx = canvas.getContext(\"2d\");\n          ctx?.drawImage(img, 0, 0, width, height);\n          resolve(canvas.toDataURL(\"image/jpeg\", 0.75));\n        };\n        img.onerror = reject;\n      };\n      reader.onerror = reject;\n    });\n  };\n\n  const handleFileChange = async (e: React.ChangeEvent<HTMLInputElement>) => {\n    const file = e.target.files?.[0];\n    if (!file) return;\n\n    if (imageAnalysisCount >= 3) {\n      setErrorMessage(\"\342\232\240\357\270\217 \346\202\250\344\273\212\346\227\245\346\213\215\347\205\247\350\207\252\345\212\250\345\210\206\346\236\220\350\257\206\345\210\253\345\267\262\350\276\276 3 \346\254\241\344\270\212\351\231\220\357\274\214\346\216\245\344\270\213\346\235\245\350\257\267\347\224\250\345\267\246\350\276\271\350\241\250\345\215\225\346\211\213\345\212\250\347\231\273\350\256\260\357\274\214\346\230\216\345\244\251\351\233\266\347\202\271\344\274\232\351\207\215\347\275\256\346\211\223\345\215\241\351\242\235\345\272\246\343\200\202\");\n      return;\n    }\n\n    setIsAnalyzingImage(true);\n    setErrorMessage(\"\");\n    setSuccessRecognitionInfo(null);\n\n    try {\n      const base64Data = await resizeAndBase64(file);\n\n      const response = await fetch(\"/api/analyze-diet-image\", {\n        method: \"POST\",\n        headers: { \"Content-Type\": \"application/json\" },\n        body: JSON.stringify({ image: base64Data, mimeType: \"image/jpeg\" }),\n      });\n\n      if (!response.ok) {\n        throw new Error(\"AI \346\234\215\345\275\271\345\207\272\351\224\231\357\274\214\345\233\276\347\211\207\346\227\240\346\263\225\346\255\243\347\241\256\350\257\206\345\210\253\");\n      }\n\n      const data = await response.json();\n      if (data.text) {\n        // Auto fill in input elements\n        setFoodText(data.text);\n        if (data.period) {\n          setPeriod(data.period as MealPeriod);\n        }\n        if (data.note) {\n          setNote(data.note);\n        }\n\n        // Save progress to localStorage\n        const nextCount = imageAnalysisCount + 1;\n        setImageAnalysisCount(nextCount);\n        localStorage.setItem(\"sd_camera_analysis_count_v1\", nextCount.toString());\n        localStorage.setItem(\"sd_camera_analysis_date\", new Date().toISOString().split(\"T\")[0]);\n\n        setSuccessRecognitionInfo({\n          text: data.text,\n          period: data.period || \"\344\270\200\350\210\254\351\244\220\347\202\271\",\n          note: data.note || \"\347\254\246\345\220\210\345\235\207\350\241\241\345\216\237\345\210\231\"\n        });\n      } else {\n        throw new Error(\"\350\257\206\345\210\253\346\234\252\350\203\275\350\216\267\345\276\227\346\234\211\346\225\210\351\244\220\351\245\256\346\225\260\346\215\256\357\274\214\350\257\267\346\233\264\346\215\242\346\270\205\346\231\260\347\232\204\347\205\247\347\211\207\");\n      }\n    } catch (err: any) {\n      console.error(err);\n      setErrorMessage(err.message || \"\346\231\272\350\203\275\345\233\276\347\211\207\345\210\206\346\236\220\346\225\205\351\232\234\357\274\214\350\257\267\346\211\213\345\212\250\350\276\223\345\205\245\346\210\226\351\207\215\346\226\260\346\213\215\346\221\204\343\200\202\");\n    } finally {\n      setIsAnalyzingImage(false);\n    }\n  };\n\n  const getDietAnalysis = async () => {\n    if (meals.length === 0) {\n      setErrorMessage(\"\350\257\267\345\205\210\346\267\273\345\212\240\346\202\250\344\273\212\345\244\251\347\232\204\351\244\220\351\245\256\350\256\260\345\275\225\357\274\214\344\273\245\344\276\277AI\350\220\245\345\205\273\345\270\210\350\203\275\350\277\233\350\241\214\347\262\276\345\207\206\347\232\204\345\210\206\346\236\220\343\200\202\");\n      return;\n    }\n\n    setIsLoading(true);\n    setErrorMessage(\"\");\n    try {\n      const todayDate = new Date().toISOString().split(\"T\")[0];\n      const todayMeals = meals.filter((m) => m.date === todayDate);\n      if (todayMeals.length === 0) {\n        setErrorMessage(\"\344\273\212\345\244\251\350\277\230\346\262\241\346\234\211\350\256\260\345\275\225\344\273\273\344\275\225\351\244\220\351\245\256\357\274\201\350\257\267\346\267\273\345\212\240\344\273\212\345\244\251\345\220\203\347\232\204\351\244\220\347\202\271\343\200\202\");\n        setIsLoading(false);\n        return;\n      }\n\n      const response = await fetch(\"/api/diet-advice\", {\n        method: \"POST\",\n        headers: { \"Content-Type\": \"application/json\" },\n        body: JSON.stringify({ meals: todayMeals }),\n      });\n\n      if (!response.ok) {\n        throw new Error(\"\345\220\221\346\234\215\345\212\241\345\231\250\350\216\267\345\217\226\350\220\245\345\205\273\345\210\206\346\236\220\345\244\261\350\264\245\357\274\214\350\257\267\347\250\215\345\220\216\351\207\215\350\257\225\");\n      }\n\n      const adviceResult: DietAdvice = await response.json();\n      onSetDietAdvice(adviceResult);\n    } catch (err: any) {\n      console.error(err);\n      setErrorMessage(err.message || \"\350\216\267\345\217\226\345\210\206\346\236\220\350\266\205\346\227\266\357\274\214\350\257\267\351\207\215\346\226\260\347\202\271\345\207\273\345\260\235\350\257\225\343\200\202\");\n    } finally {\n      setIsLoading(false);\n    }\n  };\n\n  // Get current day\'s meals\n  const todayStr = new Date().toISOString().split(\"T\")[0];\n  const todayMeals = meals.filter((m) => m.date === todayStr);\n\n  return (\n    <div className=\"space-y-6\">\n      {/* Header Banner - High Contrast Charcoal and Green */}\n      <div className=\"bg-slate-900 border border-slate-800 rounded-2xl p-6 text-white relative overflow-hidden\">\n        <div className=\"absolute right-0 top-0 translate-x-4 -translate-y-4 text-emerald-500/10 pointer-events-none\">\n          <Utensils size={150} />\n        </div>\n        <div className=\"relative z-10 space-y-2\">\n          <div className=\"flex items-center gap-2 text-emerald-400 font-medium text-sm\">\n            <Sparkles size={16} />\n            <span>\344\270\200\346\227\245\344\270\211\351\244\220 \302\267 \345\276\252\345\272\217\350\220\245\345\205\273</span>\n          </div>\n          <h2 className=\"text-2xl font-bold tracking-tight\">\351\245\256\351\243\237\350\247\204\345\276\213\347\256\241\347\220\206</h2>\n          <p className=\"text-slate-400 text-xs max-w-sm leading-relaxed\">\n            \342\200\234\345\220\203\345\276\227\350\247\204\345\276\213\357\274\214\346\211\215\350\203\275\346\216\214\346\216\247\350\207\252\345\267\261\343\200\202\342\200\235 \346\224\257\346\214\201\346\211\213\346\234\272\347\233\264\346\216\245\346\213\215\347\205\247\346\213\215\347\205\247\350\257\206\345\210\253\351\244\220\351\245\256\346\210\220\345\210\206\357\274\214\345\205\215\351\231\244\346\211\213\345\267\245\351\200\220\351\241\271\346\211\223\345\255\227\347\232\204\347\227\233\350\213\246\343\200\202\n          </p>\n        </div>\n      </div>\n\n      {/* AI Smart Camera recognition panel */}\n      <div className=\"bg-white border border-slate-200/60 rounded-xl p-5 shadow-xs space-y-4\">\n        <div className=\"flex items-center justify-between border-b border-slate-100 pb-2\">\n          <div className=\"flex items-center gap-1.5 font-semibold text-slate-800 text-sm\">\n            <Camera size={16} className=\"text-emerald-600\" />\n            <span>\360\237\223\270 \344\270\200\351\224\256\346\231\272\350\203\275\346\213\215\347\205\247\345\210\206\346\236\220 (\347\234\201\346\227\266\347\245\236\345\231\250)</span>\n          </div>\n          <span className=\"text-[10px] bg-slate-100 text-slate-500 font-bold font-mono px-2 py-0.5 rounded-full\">\n            \344\273\212\346\227\245\345\211\251\344\275\231: {Math.max(0, 3 - imageAnalysisCount)} / 3 \346\254\241\n          </span>\n        </div>\n\n        {imageAnalysisCount >= 3 ? (\n          <div className=\"p-3 bg-amber-50 border border-amber-100 rounded-lg text-xs text-amber-800 flex gap-1.5 items-start\">\n            <ShieldAlert size={14} className=\"shrink-0 mt-0.5\" />\n            <span>\344\273\212\346\227\245 3 \346\254\241\345\233\276\347\211\207\350\257\206\345\210\253\344\275\223\351\252\214\346\254\241\346\225\260\345\267\262\347\224\250\345\260\275\357\274\201\344\270\272\344\272\206\344\277\235\346\214\201\345\220\210\347\220\206\344\275\223\351\252\214\357\274\214\346\216\245\344\270\213\346\235\245\347\232\204\351\244\220\350\241\245\350\257\267\347\224\250\344\270\213\346\226\271\346\211\213\345\212\250\345\275\225\345\205\245\357\274\210\346\230\216\345\244\251\351\233\266\347\202\271\345\260\206\345\244\215\345\216\237\357\274\211\343\200\202</span>\n          </div>\n        ) : (\n          <div className=\"flex flex-col items-center justify-center border-2 border-dashed border-slate-200 rounded-xl p-6 bg-slate-50/40 relative\">\n            <input\n              type=\"file\"\n              accept=\"image/*\"\n              capture=\"environment\"\n              onChange={handleFileChange}\n              disabled={isAnalyzingImage}\n              id=\"diet-camera-uploader\"\n              className=\"absolute inset-0 opacity-0 cursor-pointer w-full h-full\"\n            />\n            \n            {isAnalyzingImage ? (\n              <div className=\"flex flex-col items-center text-center space-y-2\">\n                <Loader2 size={32} className=\"text-emerald-500 animate-spin\" />\n                <p className=\"text-xs font-semibold text-slate-700 animate-pulse\">\346\255\243\345\234\250\347\262\276\347\273\206\345\257\271\351\275\220\344\270\216\350\257\206\345\210\253\347\233\230\344\270\255\351\244\220...</p>\n                <p className=\"text-[10px] text-slate-400\">Gemini \350\247\206\350\247\211\347\245\236\347\273\217\347\275\221\347\273\234\345\244\204\347\220\206\344\270\255</p>\n              </div>\n            ) : (\n              <div className=\"flex flex-col items-center text-center space-y-2\">\n                <Camera size={28} className=\"text-slate-400\" />\n                <div>\n                  <p className=\"text-xs font-semibold text-slate-700\">\360\237\223\270 \347\202\271\345\207\273\346\255\244\345\244\204\346\213\215\347\205\247 / \351\200\211\345\217\226\351\244\220\351\245\256\347\205\247\347\211\207</p>\n                  <p className=\"text-[10px] text-slate-400 mt-1\">\347\263\273\347\273\237\344\274\232\350\207\252\345\212\250\344\270\272\346\202\250\346\231\272\350\203\275\345\241\253\345\205\205\344\270\213\346\226\271\350\241\250\345\215\225\347\232\204\351\243\237\347\211\251\345\220\215\347\247\260\345\217\212\351\244\220\347\202\271\351\230\266\346\256\265</p>\n                </div>\n              </div>\n            )}\n          </div>\n        )}\n\n        {/* Successful Identification Feedback */}\n        <AnimatePresence>\n          {successRecognitionInfo && (\n            <motion.div\n              initial={{ opacity: 0, y: 10 }}\n              animate={{ opacity: 1, y: 0 }}\n              exit={{ opacity: 0 }}\n              className=\"bg-emerald-50 border border-emerald-100 p-3.5 rounded-xl text-xs space-y-1.5 text-slate-800\"\n            >\n              <div className=\"flex items-center gap-1.5 text-emerald-800 font-bold\">\n                <Check size={14} className=\"stroke-[3]\" />\n                <span>AI \346\231\272\350\203\275\350\257\206\345\210\253\345\241\253\345\205\205\346\210\220\345\212\237\357\274\201\345\267\262\345\212\240\350\275\275\350\207\263\344\270\213\346\226\271\350\241\250\345\215\225\343\200\202</span>\n              </div>\n              <div className=\"pl-5 space-y-0.5\">\n                <p><span className=\"font-semibold text-slate-600\">\350\257\206\345\210\253\345\220\215\347\247\260\357\274\232</span>{successRecognitionInfo.text}</p>\n                <p><span className=\"font-semibold text-slate-600\">\345\220\210\347\220\206\346\227\266\346\256\265\357\274\232</span>{successRecognitionInfo.period}</p>\n                <p><span className=\"font-semibold text-slate-600\">\344\270\200\345\217\245\350\257\235\347\256\200\350\257\204\357\274\232</span><span className=\"text-slate-500 italic\">\342\200\234 {successRecognitionInfo.note} \342\200\235</span></p>\n              </div>\n              <p className=\"text-[10px] text-emerald-800 pl-5 pt-1\">\360\237\222\241 \346\243\200\346\237\245\346\227\240\350\257\257\345\220\216\357\274\214\345\217\252\351\234\200\347\202\271\345\207\273\344\270\213\346\226\271\342\200\234\345\275\225\345\205\245\345\271\266\345\255\230\345\205\245\346\270\205\345\215\225\342\200\235\345\215\263\345\217\257\346\210\220\345\212\237\350\256\260\345\275\225\346\211\223\345\215\241\343\200\202</p>\n            </motion.div>\n          )}\n        </AnimatePresence>\n      </div>\n\n      {/* Grid Layout: Log Form and Todays Meal List */}\n      <div className=\"grid grid-cols-1 md:grid-cols-2 gap-6\">\n        {/* Fill Meal Form */}\n        <div className=\"bg-white border border-slate-200/60 rounded-xl p-5 shadow-xs space-y-4\">\n          <h3 className=\"text-sm font-semibold text-slate-800 flex items-center gap-2 border-b border-slate-50 pb-2\">\n            <Utensils size={16} className=\"text-emerald-600\" />\n            <span>\346\211\200\345\220\203\350\217\234\345\223\201\344\270\216\345\210\206\351\207\217\347\262\276\347\241\256\345\257\271\351\275\220</span>\n          </h3>\n\n          <form onSubmit={handleSubmit} className=\"space-y-4\">\n            <div className=\"space-y-2\">\n              <label className=\"text-xs text-slate-500 font-medium\">\351\244\220\347\202\271\346\227\266\346\256\265</label>\n              <div className=\"grid grid-cols-4 gap-2\">\n                {([\"\346\227\251\351\244\220\", \"\345\215\210\351\244\220\", \"\346\231\232\351\244\220\", \"\345\212\240\351\244\220\"] as MealPeriod[]).map((p) => (\n                  <button\n                    key={p}\n                    type=\"button\"\n                    onClick={() => setPeriod(p)}\n                    className={`py-2 text-xs font-semibold rounded-lg border text-center transition-all cursor-pointer ${\n                      period === p\n                        ? \"bg-slate-100 border-slate-800 text-slate-900 font-bold\"\n                        : \"border-slate-200 text-slate-600 hover:bg-slate-50\"\n                    }`}\n                  >\n                    {p}\n                  </button>\n                ))}\n              </div>\n            </div>\n\n            <div className=\"space-y-1\">\n              <label className=\"text-xs text-slate-500 font-medium\">\346\211\200\345\220\203\351\243\237\347\211\251</label>\n              <textarea\n                rows={3}\n                required\n                placeholder=\"\344\276\213\345\246\202\357\274\232\347\205\256\351\270\241\350\233\2132\344\270\252\357\274\214\347\207\225\351\272\246\347\262\2451\347\242\227\357\274\214\351\246\231\350\225\211...\"\n                value={foodText}\n                onChange={(e) => setFoodText(e.target.value)}\n                className=\"w-full text-xs border border-slate-200 rounded-lg p-2.5 focus:ring-1 focus:ring-slate-400 focus:outline-none\"\n              />\n            </div>\n\n            <div className=\"space-y-1\">\n              <label className=\"text-xs text-slate-500 font-medium\">\345\201\245\345\272\267\345\244\207\346\263\250 / \344\273\275\351\207\217\347\202\271\350\257\204\357\274\210\351\200\211\345\241\253\357\274\211</label>\n              <input\n                type=\"text\"\n                placeholder=\"\345\260\221\346\262\271\345\260\221\347\233\220\343\200\201\344\275\216\347\242\263\346\260\264\346\216\247\347\263\226\344\270\255...\"\n                value={note}\n                onChange={(e) => setNote(e.target.value)}\n                className=\"w-full text-xs border border-slate-200 rounded-lg p-2.5 focus:ring-1 focus:ring-slate-400 focus:outline-none\"\n              />\n            </div>\n\n            <button\n              type=\"submit\"\n              className=\"w-full bg-slate-800 hover:bg-slate-900 text-white rounded-lg p-2.5 text-xs font-semibold shadow hover:shadow-md transition-all active:scale-[0.99] cursor-pointer\"\n            >\n              \345\275\225\345\205\245\345\271\266\345\255\230\345\205\245\346\270\205\345\215\225\n            </button>\n          </form>\n        </div>\n\n        {/* Todays Meal List & Control */}\n        <div className=\"bg-white border border-slate-200/60 rounded-xl p-5 shadow-xs flex flex-col justify-between\">\n          <div>\n            <div className=\"flex items-center justify-between border-b border-slate-50 pb-2 mb-4\">\n              <h3 className=\"text-sm font-semibold text-slate-800 flex items-center gap-1.5\">\n                <span>\346\234\254\346\227\245\345\267\262\346\221\204\345\205\245\351\244\220\351\245\256\346\270\205\345\215\225</span>\n                <span className=\"text-xs font-normal text-slate-450\">({todayStr})</span>\n              </h3>\n              {todayMeals.length > 0 && (\n                <button\n                  type=\"button\"\n                  onClick={onClearMeals}\n                  className=\"text-[10px] text-slate-400 hover:text-rose-500 font-semibold cursor-pointer\"\n                >\n                  \346\270\205\351\231\244\344\273\212\346\227\245\351\244\220\347\202\271\n                </button>\n              )}\n            </div>\n\n            {todayMeals.length === 0 ? (\n              <div className=\"h-44 flex flex-col items-center justify-center text-slate-400 bg-slate-50/40 rounded-lg border border-dashed border-slate-100\">\n                <Utensils size={28} className=\"text-slate-300 mb-2\" />\n                <p className=\"text-xs\">\344\273\212\345\244\251\350\277\230\346\262\241\346\234\211\350\256\260\345\275\225\344\273\273\344\275\225\351\244\220\351\245\256\347\202\271\346\273\264\343\200\202</p>\n                <p className=\"text-[10px] text-slate-400 mt-1\">\345\217\257\344\273\245\344\275\277\347\224\250\347\205\247\347\211\207\345\277\253\346\213\215\350\257\206\345\210\253\357\274\214\346\210\226\345\234\250\345\267\246\350\276\271\347\256\200\345\215\225\346\211\223\345\215\241\347\231\273\350\256\260\357\274\201</p>\n              </div>\n            ) : (\n              <div className=\"space-y-2 max-h-48 overflow-y-auto pr-1\">\n                {todayMeals.map((m) => (\n                  <div\n                    key={m.id}\n                    className=\"flex items-start justify-between p-2.5 bg-slate-50/50 rounded-lg border border-slate-200/80 group\"\n                  >\n                    <div className=\"space-y-1\">\n                      <div className=\"flex items-center gap-2\">\n                        <span className=\"text-[10px] uppercase font-bold bg-emerald-50 text-emerald-850 px-1.5 py-0.5 rounded\">\n                          {m.period}\n                        </span>\n                        {m.note && (\n                          <span className=\"text-[10px] text-slate-400\">\n                            ({m.note})\n                          </span>\n                        )}\n                      </div>\n                      <p className=\"text-xs font-medium text-slate-700 leading-relaxed\">{m.text}</p>\n                    </div>\n\n                    <button\n                      onClick={() => onDeleteMeal(m.id)}\n                      className=\"text-slate-300 hover:text-rose-500 p-1 opacity-100 md:opacity-0 group-hover:opacity-100 focus:opacity-100 transition-opacity cursor-pointer\"\n                    >\n                      <Trash2 size={12} />\n                    </button>\n                  </div>\n                ))}\n              </div>\n            )}\n          </div>\n\n          <div className=\"pt-4 border-t border-slate-50\">\n            <button\n              onClick={getDietAnalysis}\n              disabled={isLoading || todayMeals.length === 0}\n              className={`w-full font-bold text-xs p-3 rounded-lg flex items-center justify-center gap-2 shadow transition-all cursor-pointer ${\n                isLoading || todayMeals.length === 0\n                  ? \"bg-slate-100 text-slate-400 shadow-none cursor-not-allowed\"\n                  : \"bg-slate-800 hover:bg-slate-900 text-white\"\n              }`}\n            >\n              {isLoading ? (\n                <>\n                  <Loader2 size={14} className=\"animate-spin\" />\n                  <span>AI\350\220\245\345\205\273\351\241\276\351\227\256\346\267\261\345\205\245\346\216\250\347\256\227\344\270\255...</span>\n                </>\n              ) : (\n                <>\n                  <Sparkles size={14} className=\"text-emerald-400\" />\n                  <span>\346\267\261\345\272\246\345\211\226\346\236\220\357\274\232\345\217\254\345\224\244 AI \350\220\245\345\205\273\345\270\210\350\277\233\350\241\214\345\205\250\351\235\242\350\257\204\344\274\260</span>\n                </>\n              )}\n            </button>\n            {errorMessage && <p className=\"text-[10px] text-rose-500 mt-2 text-center\">{errorMessage}</p>}\n          </div>\n        </div>\n      </div>\n\n      {/* AI Advice Output Card */}\n      <AnimatePresence>\n        {dietAdvice && (\n          <motion.div\n            initial={{ opacity: 0, y: 15 }}\n            animate={{ opacity: 1, y: 0 }}\n            exit={{ opacity: 0, y: -15 }}\n            className=\"bg-white border border-slate-200/60 shadow-xs rounded-2xl p-6 space-y-6\"\n          >\n            {/* Advice Header */}\n            <div className=\"flex items-center justify-between border-b border-slate-100 pb-4\">\n              <div className=\"flex items-center gap-3\">\n                <div className=\"bg-slate-100 p-2.5 rounded-xl text-slate-800\">\n                  <Award size={22} />\n                </div>\n                <div>\n                  <h3 className=\"text-sm font-semibold text-slate-800\">\344\273\212\346\227\245\345\201\245\345\272\267\351\245\256\351\243\237\346\265\213\350\257\204\346\212\245\345\221\212</h3>\n                  <p className=\"text-[10px] text-slate-400\">\347\224\261\350\207\252\345\276\213\345\212\251\346\211\213 AI \350\220\245\345\205\273\346\225\231\347\273\203\350\207\252\345\212\250\347\224\237\346\210\220</p>\n                </div>\n              </div>\n\n              {/* Diet Score Circle */}\n              <div className=\"flex items-center gap-2\">\n                <span className=\"text-xs text-slate-500 font-medium font-sans\">\347\273\274\345\220\210\350\206\263\351\243\237\350\257\204\347\272\247</span>\n                <div className=\"h-12 w-12 rounded-full border-4 border-emerald-500 flex items-center justify-center font-extrabold text-emerald-800 text-md bg-emerald-50 shadow-xs\">\n                  {dietAdvice.score}\n                </div>\n              </div>\n            </div>\n\n            {/* Estimated Nutrition Stats */}\n            <div className=\"grid grid-cols-4 gap-3\">\n              <div className=\"bg-slate-50 border border-slate-100 rounded-xl p-3 text-center\">\n                <div className=\"text-[10px] text-slate-600 font-medium mb-1\">\344\274\260\347\256\227\347\203\255\351\207\217</div>\n                <div className=\"text-sm font-extrabold text-slate-900 truncate\">{dietAdvice.calories} kcal</div>\n              </div>\n              <div className=\"bg-slate-50 border border-slate-100 rounded-xl p-3 text-center\">\n                <div className=\"text-[10px] text-slate-600 font-medium mb-1\">\347\242\263\346\260\264\345\214\226\345\220\210\347\211\251</div>\n                <div className=\"text-sm font-extrabold text-slate-900 truncate\">{dietAdvice.carb}</div>\n              </div>\n              <div className=\"bg-slate-50 border border-slate-100 rounded-xl p-3 text-center\">\n                <div className=\"text-[10px] text-slate-600 font-medium mb-1\">\350\233\213\347\231\275\350\264\250</div>\n                <div className=\"text-sm font-extrabold text-slate-900 truncate\">{dietAdvice.protein}</div>\n              </div>\n              <div className=\"bg-slate-50 border border-slate-100 rounded-xl p-3 text-center\">\n                <div className=\"text-[10px] text-slate-600 font-medium mb-1\">\345\244\251\347\204\266\350\204\202\350\202\252</div>\n                <div className=\"text-sm font-extrabold text-slate-900 truncate\">{dietAdvice.fat}</div>\n              </div>\n            </div>\n\n            {/* Detailed Evaluation */}\n            <div className=\"space-y-4\">\n              <div className=\"bg-slate-100 p-4 rounded-xl border border-slate-205 text-slate-800 space-y-1 text-xs\">\n                <h4 className=\"font-bold flex items-center gap-1 text-slate-850\">\n                  <Scale size={14} className=\"text-slate-650\" />\n                  <span>\350\206\263\351\243\237\347\273\223\346\236\204\347\273\274\345\220\210\345\211\226\346\236\220\357\274\232</span>\n                </h4>\n                <p className=\"leading-relaxed text-slate-650\">{dietAdvice.analysis}</p>\n              </div>\n\n              <div className=\"bg-emerald-50/50 p-4 rounded-xl border border-emerald-100 text-emerald-950 space-y-1 text-xs\">\n                <h4 className=\"font-bold flex items-center gap-1 text-emerald-800\">\n                  <Heart size={14} />\n                  <span>\344\270\252\346\200\247\345\214\226\351\245\256\351\243\237\346\224\271\345\226\204\345\273\272\350\256\256\357\274\232</span>\n                </h4>\n                <p className=\"leading-relaxed text-emerald-900\">{dietAdvice.advice}</p>\n              </div>\n            </div>\n          </motion.div>\n        )}\n      </AnimatePresence>\n    </div>\n  );\n}\n"
