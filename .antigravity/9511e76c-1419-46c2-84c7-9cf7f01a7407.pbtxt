  planner_response {
    modified_response: "\346\210\221\345\267\262\346\210\220\345\212\237\344\277\256\345\244\215\344\272\206\345\272\224\347\224\250\344\270\255\347\232\204\351\224\231\350\257\257\357\274\201\n\n### \344\277\256\345\244\215\351\227\256\351\242\230\350\257\264\346\230\216\n- **\346\240\271\346\234\254\345\216\237\345\233\240**\357\274\232\345\234\250\351\241\266\351\203\250\347\232\204\342\200\234\346\257\217\346\227\245\344\270\200\350\250\200\342\200\235\346\250\241\345\235\227\346\270\262\346\237\223\346\227\266\357\274\214\344\273\243\347\240\201\351\201\227\347\225\231\344\272\206\344\270\200\344\270\252\345\260\206\347\256\255\345\244\264\345\207\275\346\225\260\350\257\257\344\275\234\344\270\272 React \350\212\202\347\202\271\347\232\204\345\215\240\344\275\215\347\254\246 `{className => motto || ...}`\357\274\214\350\277\231\345\257\274\350\207\264 React \345\234\250\350\277\220\350\241\214\346\270\262\346\237\223\346\227\266\346\212\245\351\224\231 `Functions are not valid as a React child`\343\200\202\n- **\350\247\243\345\206\263\346\226\271\346\263\225**\357\274\232\345\260\206\345\205\266\346\224\271\344\270\272\347\233\264\346\216\245\344\275\277\347\224\250\347\212\266\346\200\201\345\200\274 `{motto || \"\350\207\252\345\276\213\351\223\270\345\260\261\346\233\264\345\245\275\347\232\204\346\234\252\346\235\245\343\200\202\"}`\357\274\214\344\275\277\345\205\266\346\255\243\347\241\256\346\270\262\346\237\223\344\270\272\346\240\274\345\274\217\346\225\264\351\275\220\347\232\204\345\255\227\347\254\246\344\270\262\346\226\207\346\234\254\343\200\202\n\n---\n\n### \360\237\214\237 \350\207\252\345\276\213\345\212\251\346\211\213 App \347\232\204\347\262\276\345\275\251\344\272\256\347\202\271\344\270\216\350\256\276\350\256\241\346\200\273\347\273\223\n\n\350\257\245\350\207\252\345\276\213\345\212\251\346\211\213\347\216\260\345\267\262\345\205\250\351\235\242\346\211\223\351\200\232\343\200\202\344\275\234\344\270\272\344\270\200\344\270\252\345\2