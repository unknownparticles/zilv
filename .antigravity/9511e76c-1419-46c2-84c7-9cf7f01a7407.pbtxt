    replacement_chunks {
      replacement_content: "import { useState } from \"react\";\nimport { MealItem, MealPeriod, DietAdvice } from \"../types\";\nimport { Utensils, Award, Sparkles, Loader2, Trash2, Heart, Scale } from \"lucide-react\";\nimport { motion, AnimatePresence } from \"motion/react\";\n\ninterface DietSectionProps {\n  meals: MealItem[];\n  onAddMeal: (meal: MealItem) => void;\n  onDeleteMeal: (id: string) => void;\n  onClearMeals: () => void;\n  dietAdvice: DietAdvice | null;\n  onSetDietAdvice: (advice: DietAdvice | null) => void;\n}\n\nexport default function DietSection({\n  meals,\n  onAddMeal,\n  onDeleteMeal,\n  onClearMeals,\n  dietAdvice,\n  onSetDietAdvice,\n}: DietSectionProps) {\n  const [period, setPeriod] = useState<MealPeriod>(\"\346\227\251\351\244\220\");\n  const [foodText, setFoodText] = useState(\"\");\n  const [note, setNote] = useState(\"\");\n  const [isLoading, setIsLoading] = useState(false);\n  const [errorMessage, setErrorMessage] = useState(\"\");\n\n  const handleSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!foodText.trim()) return;\n\n    const newMeal: MealItem = {\n      id: crypto.randomUUID(),\n      date: new Date().toISOString().split(\"T\")[0],\n      period,\n      text: foodText.trim(),\n      note: note.trim() || undefined,\n    };\n\n    onAddMeal(newMeal);\n    setFoodText(\"\");\n    setNote(\"\");\n  };\n\n  const getDietAnalysis = async () => {\n    if (meals.length === 0) {\n      setErrorMessage(\"\350\257\267\345\205\210\346\267\273\345\212\240\346\202\250\344\273\212\345\244\251\347\232\204\351\244\220\351\245\256\350\256\260\345\275\225\357\274\214\344\273\245\344\276\277AI\350\220\245\345\205\273\345\270\210\350\203\275\350\277\233\350\241\214\347\262\276\345\207\206\347\232\204\345\210\206\346\236\220\343\200\202\");\n      return;\n    }\n\n    setIsLoading(true);\n    setErrorMessage(\"\");\n    try {\n      const todayDate = new Date().toISOString().split(\"T\")[0];\n      const todayMeals = meals.filter((m) => m.date === todayDate);\n      if (todayMeals.length === 0) {\n        setErrorMessage(\"\344\273\212\345\244\251\350\277\230\346\262\241\346\234\211\350\256\260\345\275\225\344\273\273\344\275\225\351\244\220\351\245\256\357\274\201\350\257\267\346\267\273\345\212\240\344\273\212\345\244\251\345\220\203\347\232\204\351\244\220\347\202\271\343\200\202\");\n        setIsLoading(false);\n        return;\n      }\n\n      const response = await fetch(\"/api/diet-advice\", {\n        method: \"POST\",\n        headers: { \"Content-Type\": \"application/json\" },\n        body: JSON.stringify({ meals: todayMeals }),\n      });\n\n      if (!response.ok) {\n        throw new Error(\"\345\220\221\346\234\215\345\212\241\345\231\250\350\216\267\345\217\226\350\220\245\345\205\273\345\210\206\346\236\220\345\244\261\350\264\245\357\274\214\350\257\267\347\250\215\345\220\216\351\207\215\350\257\225\");\n      }\n\n      const adviceResult: DietAdvice = await response.json();\n      onSetDietAdvice(adviceResult);\n    } catch (err: any) {\n      console.error(err);\n      setErrorMessage(err.message || \"\350\216\267\345\217\226\345\210\206\346\236\220\350\266\205\346\227\266\357\274\214\350\257\267\351\207\215\346\226\260\347\202\271\345\207\273\345\260\235\350\257\225\343\200\202\");\n    } finally {\n      setIsLoading(false);\n    }\n  };\n\n  // Get current day\'s meals\n  const todayStr = new Date().toISOString().split(\"T\")[0];\n  const todayMeals = meals.filter((m) => m.date === todayStr);\n\n  return (\n    <div className=\"space-y-6\">\n      {/* Header Banner */}\n      <div className=\"bg-emerald-900 border border-emerald-800 rounded-2xl p-6 text-white relative overflow-hidden\">\n        <div className=\"absolute right-0 top-0 translate-x-4 -translate-y-4 text-emerald-500/15 pointer-events-none\">\n          <Utensils size={150} />\n        </div>\n        <div className=\"relative z-10 space-y-2\">\n          <div className=\"flex items-center gap-2 text-emerald-400 font-medium text-sm\">\n            <Sparkles size={16} />\n            <span>\344\270\200\346\227\245\344\270\211\351\244\220 \302\267 \345\276\252\345\272\217\350\220\245\345\205\273</span>\n          </div>\n          <h2 className=\"text-2xl font-semibold tracking-tight\">\351\245\256\351\243\237\350\247\204\345\276\213\347\256\241\347\220\206</h2>\n          <p className=\"text-emerald-100/80 text-sm max-w-sm leading-relaxed\">\n            \350\256\260\345\275\225\346\221\204\345\205\245\350\220\245\345\205\273\346\210\220\345\210\206\357\274\214\351\200\232\350\277\207 AI \350\220\245\345\205\273\350\207\252\345\276\213\345\270\210\347\232\204\346\267\261\345\272\246\347\202\271\350\257\204\344\270\216\347\247\221\345\255\246\350\247\204\345\210\222\357\274\214\350\260\203\346\225\264\344\275\240\346\257\217\346\227\245\347\242\263\346\260\264\345\222\214\344\274\230\350\264\250\350\204\202\350\202\252\343\200\202\n          </p>\n        </div>\n      </div>\n\n      {/* Grid Layout: Log Form and Todays Meal List */}\n      <div className=\"grid grid-cols-1 md:grid-cols-2 gap-6\">\n        {/* Fill Meal Form */}\n        <div className=\"bg-white border border-slate-100 rounded-xl p-5 shadow-sm space-y-4\">\n          <h3 className=\"text-sm font-semibold text-slate-800 flex items-center gap-2 border-b border-slate-50 pb-2\">\n            <Utensils size={16} className=\"text-emerald-600\" />\n            <span>\350\256\260\345\275\225\351\244\220\351\245\256\346\221\204\345\205\245</span>\n          </h3>\n\n          <form onSubmit={handleSubmit} className=\"space-y-4\">\n            <div className=\"space-y-2\">\n              <label className=\"text-xs text-slate-500 font-medium\">\351\244\220\347\202\271\346\227\266\346\256\265</label>\n              <div className=\"grid grid-cols-4 gap-2\">\n                {([\"\346\227\251\351\244\220\", \"\345\215\210\351\244\220\", \"\346\231\232\351\244\220\", \"\345\212\240\351\244\220\"] as MealPeriod[]).map((p) => (\n                  <button\n                    key={p}\n                    type=\"button\"\n                    onClick={() => setPeriod(p)}\n                    className={`py-2 text-xs font-semibold rounded-lg border text-center transition-all cursor-pointer ${\n                      period === p\n                        ? \"bg-emerald-50 border-emerald-400 text-emerald-700 font-bold\"\n                        : \"border-slate-200 text-slate-600 hover:bg-slate-50\"\n                    }`}\n                  >\n                    {p}\n                  </button>\n                ))}\n              </div>\n            </div>\n\n            <div className=\"space-y-1\">\n              <label className=\"text-xs text-slate-500 font-medium\">\346\211\200\345\220\203\351\243\237\347\211\251</label>\n              <textarea\n                rows={3}\n                required\n                placeholder=\"\344\276\213\345\246\202\357\274\232\351\273\221\351\272\246\351\235\242\345\214\2051\347\211\207\357\274\214\347\205\256\351\270\241\350\233\2132\344\270\252\357\274\214\347\211\233\345\245\2661\346\235\257\345\217\212\345\260\217\350\242\213\345\235\232\346\236\234\357\274\214\346\210\226\345\215\212\347\242\227\347\272\242\347\203\247\347\211\233\350\202\211\351\235\242\345\212\240\345\260\217\347\231\275\350\217\234...\"\n                value={foodText}\n                onChange={(e) => setFoodText(e.target.value)}\n                className=\"w-full text-xs border border-slate-200 rounded-lg p-2.5 focus:ring-1 focus:ring-emerald-500 focus:outline-none\"\n              />\n            </div>\n\n            <div className=\"space-y-1\">\n              <label className=\"text-xs text-slate-500 font-medium\">\345\244\207\346\263\250\357\274\210\351\200\211\345\241\253\357\274\211</label>\n              <input\n                type=\"text\"\n                placeholder=\"\345\246\202: \350\201\232\351\244\220\343\200\201\345\260\221\346\262\271\345\260\221\347\233\220\343\200\201\345\260\221\347\263\226\346\216\247\345\210\266\344\270\255...\"\n                value={note}\n                onChange={(e) => setNote(e.target.value)}\n                className=\"w-full text-xs border border-slate-200 rounded-lg p-2.5 focus:ring-1 focus:ring-emerald-500 focus:outline-none\"\n              />\n            </div>\n\n            <button\n              type=\"submit\"\n              className=\"w-full bg-gradient-to-r from-emerald-600 to-emerald-700 hover:from-emerald-700 hover:to-emerald-800 text-white rounded-lg p-2.5 text-xs font-semibold shadow hover:shadow-md transition-all active:scale-[0.99] cursor-pointer\"\n            >\n              \345\275\225\345\205\245\345\271\266\345\255\230\345\205\245\346\270\205\345\215\225\n            </button>\n          </form>\n        </div>\n\n        {/* Todays Meal List & Control */}\n        <div className=\"bg-white border border-slate-100 rounded-xl p-5 shadow-sm flex flex-col justify-between\">\n          <div>\n            <div className=\"flex items-center justify-between border-b border-slate-50 pb-2 mb-4\">\n              <h3 className=\"text-sm font-semibold text-slate-800 flex items-center gap-1.5\">\n                <span>\344\273\212\346\227\245\345\267\262\345\220\203\351\244\220\351\245\256</span>\n                <span className=\"text-xs font-normal text-slate-400\">({todayStr})</span>\n              </h3>\n              {todayMeals.length > 0 && (\n                <button\n                  type=\"button\"\n                  onClick={onClearMeals}\n                  className=\"text-[10px] text-slate-400 hover:text-rose-500 font-semibold cursor-pointer\"\n                >\n                  \346\270\205\351\231\244\344\273\212\346\227\245\n                </button>\n              )}\n            </div>\n\n            {todayMeals.length === 0 ? (\n              <div className=\"h-44 flex flex-col items-center justify-center text-slate-400/80 bg-slate-50/40 rounded-lg border border-dashed border-slate-100\">\n                <Utensils size={28} className=\"text-slate-300 mb-2\" />\n                <p className=\"text-xs\">\344\273\212\345\244\251\350\277\230\346\262\241\345\220\203\345\210\253\347\232\204\344\270\234\350\245\277\345\220\227\357\274\237</p>\n                <p className=\"text-[10px] text-slate-400 mt-1\">\350\257\267\345\234\250\345\267\246\344\276\247\345\241\253\345\206\231\357\274\214\347\204\266\345\220\216\345\217\254\345\224\244AI\350\220\245\345\205\273\345\270\210\350\257\204\344\274\260\357\274\201</p>\n              </div>\n            ) : (\n              <div className=\"space-y-2 max-h-48 overflow-y-auto pr-1\">\n                {todayMeals.map((m) => (\n                  <div\n                    key={m.id}\n                    className=\"flex items-start justify-between p-2.5 bg-slate-50/50 rounded-lg border border-slate-100 group\"\n                  >\n                    <div className=\"space-y-1\">\n                      <div className=\"flex items-center gap-2\">\n                        <span className=\"text-[10px] uppercase font-bold bg-emerald-100 text-emerald-800 px-1.5 py-0.5 rounded\">\n                          {m.period}\n                        </span>\n                        {m.note && (\n                          <span className=\"text-[10px] text-slate-400\">\n                            ({m.note})\n                          </span>\n                        )}\n                      </div>\n                      <p className=\"text-xs font-medium text-slate-700 leading-relaxed\">{m.text}</p>\n                    </div>\n\n                    <button\n                      onClick={() => onDeleteMeal(m.id)}\n                      className=\"text-slate-300 hover:text-rose-500 p-1 opacity-0 group-hover:opacity-100 focus:opacity-100 transition-opacity cursor-pointer\"\n                    >\n                      <Trash2 size={12} />\n                    </button>\n                  </div>\n                ))}\n              </div>\n            )}\n          </div>\n\n          <div className=\"pt-4 border-t border-slate-50\">\n            <button\n              onClick={getDietAnalysis}\n              disabled={isLoading || todayMeals.length === 0}\n              className={`w-full font-bold text-xs p-3 rounded-lg flex items-center justify-center gap-2 shadow transition-all cursor-pointer ${\n                isLoading || todayMeals.length === 0\n                  ? \"bg-slate-100 text-slate-400 shadow-none cursor-not-allowed\"\n                  : \"bg-amber-500 hover:bg-amber-600 text-white\"\n              }`}\n            >\n              {isLoading ? (\n                <>\n                  <Loader2 size={14} className=\"animate-spin\" />\n                  <span>AI\350\220\245\345\205\273\351\241\276\351\227\256\345\210\206\346\236\220\346\265\213\347\256\227\344\270\255...</span>\n                </>\n              ) : (\n                <>\n                  <Sparkles size={14} />\n                  <span>\346\267\261\345\272\246\345\211\226\346\236\220\357\274\232AI \350\220\245\345\205\273\350\207\252\345\276\213\345\270\210\347\202\271\350\257\204</span>\n                </>\n              )}\n            </button>\n            {errorMessage && <p className=\"text-[10px] text-rose-500 mt-2 text-center\">{errorMessage}</p>}\n          </div>\n        </div>\n      </div>\n\n      {/* AI Advice Output Card */}\n      <AnimatePresence>\n        {dietAdvice && (\n          <motion.div\n            initial={{ opacity: 0, y: 15 }}\n            animate={{ opacity: 1, y: 0 }}\n            exit={{ opacity: 0, y: -15 }}\n            className=\"bg-white border border-slate-100 shadow-md rounded-2xl p-6 space-y-6\"\n          >\n            {/* Advice Header */}\n            <div className=\"flex items-center justify-between border-b border-slate-100 pb-4\">\n              <div className=\"flex items-center gap-3\">\n                <div className=\"bg-amber-100 p-2.5 rounded-xl text-amber-700\">\n                  <Award size={22} />\n                </div>\n                <div>\n                  <h3 className=\"text-sm font-semibold text-slate-800\">\344\273\212\346\227\245\345\201\245\345\272\267\351\245\256\351\243\237\346\265\213\350\257\204\346\212\245\345\221\212</h3>\n                  <p className=\"text-[10px] text-slate-400\">\347\224\261\350\207\252\345\276\213\345\212\251\346\211\213 AI \350\220\245\345\205\273\346\225\231\347\273\203\350\207\252\345\212\250\347\224\237\346\210\220</p>\n                </div>\n              </div>\n\n              {/* Diet Score Circle */}\n              <div className=\"flex items-center gap-2\">\n                <span className=\"text-xs text-slate-500 font-medium\">\346\234\254\346\227\245\350\206\263\351\243\237\350\257\204\345\210\206</span>\n                <div className=\"h-12 w-12 rounded-full border-4 border-emerald-500 flex items-center justify-center font-bold text-emerald-700 text-md bg-emerald-50 shadow\">\n                  {dietAdvice.score}\n                </div>\n              </div>\n            </div>\n\n            {/* Estimated Nutrition Stats */}\n            <div className=\"grid grid-cols-4 gap-3\">\n              <div className=\"bg-orange-50/50 border border-orange-100/50 rounded-xl p-3 text-center\">\n                <div className=\"text-[10px] text-orange-600 font-medium mb-1\">\344\274\260\347\256\227\347\203\255\351\207\217</div>\n                <div className=\"text-sm font-extrabold text-orange-850 truncate\">{dietAdvice.calories} kcal</div>\n              </div>\n              <div className=\"bg-sky-50/50 border border-sky-100/50 rounded-xl p-3 text-center\">\n                <div className=\"text-[10px] text-sky-600 font-medium mb-1\">\347\242\263\346\260\264\345\214\226\345\220\210\347\211\251</div>\n                <div className=\"text-sm font-extrabold text-sky-850 truncate\">{dietAdvice.carb}</div>\n              </div>\n              <div className=\"bg-indigo-50/50 border border-indigo-100/50 rounded-xl p-3 text-center\">\n                <div className=\"text-[10px] text-indigo-600 font-medium mb-1\">\350\233\213\347\231\275\350\264\250</div>\n                <div className=\"text-sm font-extrabold text-indigo-850 truncate\">{dietAdvice.protein}</div>\n              </div>\n              <div className=\"bg-rose-50/50 border border-rose-100/50 rounded-xl p-3 text-center\">\n                <div className=\"text-[10px] text-rose-600 font-medium mb-1\">\350\204\202\350\202\252</div>\n                <div className=\"text-sm font-extrabold text-rose-850 truncate\">{dietAdvice.fat}</div>\n              </div>\n            </div>\n\n            {/* Detailed Evaluation */}\n            <div className=\"space-y-4\">\n              <div className=\"bg-emerald-50/40 p-4 rounded-xl border border-emerald-100/30 text-emerald-950 space-y-1 text-xs\">\n                <h4 className=\"font-bold flex items-center gap-1 text-emerald-800\">\n                  <Scale size={14} />\n                  <span>\350\206\263\351\243\237\347\273\223\346\236\204\347\273\274\345\220\210\345\211\226\346\236\220\357\274\232</span>\n                </h4>\n                <p className=\"leading-relaxed text-emerald-900\">{dietAdvice.analysis}</p>\n              </div>\n\n              <div className=\"bg-amber-50/40 p-4 rounded-xl border border-amber-100/30 text-amber-950 space-y-1 text-xs\">\n                <h4 className=\"font-bold flex items-center gap-1 text-amber-800\">\n                  <Heart size={14} />\n                  <span>\344\270\252\346\200\247\345\214\226\351\245\256\351\243\237\346\224\271\345\226\204\345\273\272\350\256\256\357\274\232</span>\n                </h4>\n                <p className=\"leading-relaxed text-amber-900\">{dietAdvice.advice}</p>\n              </div>\n            </div>\n          </motion.div>\n        )}\n      </AnimatePresence>\n    </div>\n  );\n}\n"
    }
