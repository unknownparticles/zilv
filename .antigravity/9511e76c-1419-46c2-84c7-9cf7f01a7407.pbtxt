    replacement_chunks {
      replacement_content: "import React, { useState } from \"react\";\nimport { SkillChallenge } from \"../types\";\nimport { Sparkles, Loader2, Play, CheckCircle, Flame, Plus, Check, Compass, Eye, Trophy, Trash2 } from \"lucide-react\";\nimport { motion, AnimatePresence } from \"motion/react\";\n\ninterface ChallengeSectionProps {\n  challenges: SkillChallenge[];\n  onAddChallenge: (challenge: SkillChallenge) => void;\n  onUpdateChallengeStatus: (id: string, status: \"\350\277\233\350\241\214\344\270\255\" | \"\345\267\262\345\256\214\346\210\220\" | \"\345\267\262\346\224\276\345\274\203\") => void;\n  onDeleteChallenge: (id: string) => void;\n}\n\nconst DEFAULT_INTEREST_TAGS = [\n  \"\347\247\221\346\212\200\344\270\216\346\236\201\345\256\242\347\224\265\350\204\221\",\n  \"\347\276\216\351\243\237\347\203\271\351\245\252\347\203\230\347\204\231\",\n  \"\346\227\245\345\270\270\346\211\213\344\275\234\347\276\216\345\255\246\",\n  \"\345\210\233\346\204\217\345\206\231\344\275\234/\345\217\244\345\205\270\350\257\227\350\257\215\",\n  \"\345\215\232\345\274\210\347\220\206\350\264\242\346\212\225\350\265\204\",\n  \"\350\257\255\350\250\200\350\241\250\350\276\276/\350\204\261\345\217\243\347\247\200\",\n  \"\346\210\267\345\244\226\346\216\242\347\264\242\344\270\216\346\224\200\350\241\214\",\n  \"\345\237\272\347\241\200\347\264\240\346\217\217/\346\216\222\347\211\210\350\256\276\350\256\241\",\n  \"\345\217\244\345\205\270\351\237\263\344\271\220\344\270\216\350\201\206\345\220\254\",\n];\n\nexport default function ChallengeSection({\n  challenges,\n  onAddChallenge,\n  onUpdateChallengeStatus,\n  onDeleteChallenge,\n}: ChallengeSectionProps) {\n  const [selectedInterests, setSelectedInterests] = useState<string[]>([\"\347\247\221\346\212\200\344\270\216\346\236\201\345\256\242\347\224\265\350\204\221\", \"\346\227\245\345\270\270\346\211\213\344\275\234\347\276\216\345\255\246\"]);\n  const [currentChallenge, setCurrentChallenge] = useState<SkillChallenge | null>(null);\n  const [isLoading, setIsLoading] = useState(false);\n  const [customInterest, setCustomInterest] = useState(\"\");\n  const [errorText, setErrorText] = useState(\"\");\n\n  const toggleInterest = (tag: string) => {\n    if (selectedInterests.includes(tag)) {\n      setSelectedInterests(selectedInterests.filter((t) => t !== tag));\n    } else {\n      setSelectedInterests([...selectedInterests, tag]);\n    }\n  };\n\n  const handleAddCustomInterest = (e: React.FormEvent) => {\n    e.preventDefault();\n    if (customInterest.trim() && !selectedInterests.includes(customInterest.trim())) {\n      setSelectedInterests([...selectedInterests, customInterest.trim()]);\n      setCustomInterest(\"\");\n    }\n  };\n\n  const handleTriggerChallenge = async () => {\n    setIsLoading(true);\n    setErrorText(\"\");\n    try {\n      const response = await fetch(\"/api/skill-challenge\", {\n        method: \"POST\",\n        headers: { \"Content-Type\": \"application/json\" },\n        body: JSON.stringify({\n          interests: selectedInterests,\n          completedChallenges: challenges.filter((c) => c.status === \"\345\267\262\345\256\214\346\210\220\"),\n        }),\n      });\n\n      if (!response.ok) {\n        throw new Error(\"\345\217\254\345\224\244\346\212\200\350\203\275\346\214\221\346\210\230\345\244\261\350\264\245\357\274\214\350\257\267\351\207\215\350\257\225\");\n      }\n\n      const rawChallenge = await response.json();\n      const generatedChallenge: SkillChallenge = {\n        id: crypto.randomUUID(),\n        title: rawChallenge.title,\n        category: rawChallenge.category,\n        estimatedTime: rawChallenge.estimatedTime,\n        difficulty: rawChallenge.difficulty,\n        description: rawChallenge.description,\n        steps: rawChallenge.steps,\n        rewardMindset: rawChallenge.rewardMindset,\n        status: \"\350\277\233\350\241\214\344\270\255\",\n        registeredDate: new Date().toISOString().split(\"T\")[0],\n      };\n\n      setCurrentChallenge(generatedChallenge);\n    } catch (err: any) {\n      console.error(err);\n      setErrorText(err.message || \"\346\234\215\345\212\241\345\231\250\345\223\215\345\272\224\350\266\205\346\227\266\357\274\214\350\257\267\351\207\215\346\226\260\347\202\271\345\207\273\350\216\267\345\217\226\343\200\202\");\n    } finally {\n      setIsLoading(false);\n    }\n  };\n\n  const handleAcceptChallenge = () => {\n    if (currentChallenge) {\n      onAddChallenge(currentChallenge);\n      setCurrentChallenge(null);\n    }\n  };\n\n  const activeChallenges = challenges.filter((c) => c.status === \"\350\277\233\350\241\214\344\270\255\");\n  const completedChallenges = challenges.filter((c) => c.status === \"\345\267\262\345\256\214\346\210\220\");\n\n  return (\n    <div className=\"space-y-6\">\n      {/* Header Banner - Graphite Charcoal & Teal details */}\n      <div className=\"bg-slate-900 border border-slate-800 rounded-2xl p-6 text-white relative overflow-hidden\">\n        <div className=\"absolute right-0 top-0 translate-x-4 -translate-y-4 text-teal-500/10 pointer-events-none\">\n          <Compass size={160} />\n        </div>\n        <div className=\"relative z-10 space-y-2\">\n          <div className=\"flex items-center gap-2 text-teal-400 font-medium text-sm\">\n            <Sparkles size={16} />\n            <span>\346\213\222\347\273\235\345\271\263\345\272\270 \302\267 \346\216\242\347\264\242\346\234\252\347\237\245</span>\n          </div>\n          <h2 className=\"text-2xl font-bold tracking-tight\">\346\226\260\345\245\207\345\205\264\350\266\243\346\214\221\346\210\230</h2>\n          <p className=\"text-slate-400 text-xs max-w-sm leading-relaxed\">\n            \342\200\234\350\207\252\345\276\213\344\270\215\346\204\217\345\221\263\347\235\200\346\236\257\347\207\245\357\274\214\350\200\214\346\230\257\344\270\272\344\272\206\345\216\273\346\216\242\347\264\242\346\233\264\345\244\247\347\232\204\344\270\226\347\225\214\343\200\202\342\200\235 \347\273\231\347\224\237\346\264\273\346\263\250\345\205\245\344\270\200\344\272\233\344\270\215\346\234\237\350\200\214\351\201\207\347\232\204\347\201\265\346\204\237\345\206\222\351\231\251\357\274\214\346\211\223\347\240\264\346\227\240\350\266\243\347\232\204\346\255\273\346\260\264\343\200\202\n          </p>\n        </div>\n      </div>\n\n      <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-6\">\n        {/* Left Side: Spark generator */}\n        <div className=\"lg:col-span-7 bg-white border border-slate-200/60 p-5 rounded-xl shadow-xs space-y-5 flex flex-col justify-between\">\n          <div className=\"space-y-4\">\n            <h3 className=\"text-sm font-semibold text-slate-800 flex items-center gap-1.5 border-b border-slate-50 pb-2\">\n              <Compass size={16} className=\"text-slate-700\" />\n              <span>\345\256\232\345\210\266\346\210\221\347\232\204\347\224\237\346\264\273\345\205\264\350\266\243\346\226\271\345\220\221</span>\n            </h3>\n\n            {/* Interest tag clouds */}\n            <div className=\"flex flex-wrap gap-2\">\n              {DEFAULT_INTEREST_TAGS.map((tag) => {\n                const active = selectedInterests.includes(tag);\n                return (\n                  <button\n                    key={tag}\n                    type=\"button\"\n                    onClick={() => toggleInterest(tag)}\n                    className={`px-3 py-1.5 text-xs rounded-full border transition-all cursor-pointer ${\n                      active\n                        ? \"bg-slate-100 border-slate-800 text-slate-900 font-bold\"\n                        : \"border-slate-200 text-slate-600 hover:bg-slate-50\"\n                    }`}\n                  >\n                    {tag}\n                  </button>\n                );\n              })}\n            </div>\n\n            {/* Custom tag form */}\n            <form onSubmit={handleAddCustomInterest} className=\"flex gap-2\">\n              <input\n                type=\"text\"\n                placeholder=\"\346\210\221\347\232\204\344\270\223\345\261\236\346\216\242\347\264\242\351\242\206\345\237\237\357\274\214\345\246\202\357\274\232\345\206\267\345\205\265\345\231\250\343\200\201\345\244\251\346\226\207\343\200\201\346\211\213\347\242\237...\"\n                value={customInterest}\n                onChange={(e) => setCustomInterest(e.target.value)}\n                className=\"flex-1 text-xs border border-slate-200 rounded-lg px-3 py-2.5 focus:ring-1 focus:ring-slate-500 focus:outline-none\"\n              />\n              <button\n                type=\"submit\"\n                className=\"bg-slate-800 hover:bg-slate-900 text-white rounded-lg px-4 py-2 text-xs font-semibold shrink-0 cursor-pointer\"\n              >\n                \350\277\275\345\212\240\345\210\206\347\261\273\n              </button>\n            </form>\n\n            <button\n              onClick={handleTriggerChallenge}\n              disabled={isLoading || selectedInterests.length === 0}\n              className={`w-full py-3 rounded-xl font-bold text-xs flex items-center justify-center gap-2 shadow transition-all cursor-pointer ${\n                isLoading || selectedInterests.length === 0\n                  ? \"bg-slate-100 text-slate-400 cursor-not-allowed shadow-none\"\n                  : \"bg-slate-800 hover:bg-slate-900 text-white\"\n              }`}\n            >\n              {isLoading ? (\n                <>\n                  <Loader2 size={13} className=\"animate-spin\" />\n                  <span>AI \346\255\243\345\234\250\350\204\221\346\232\264\346\226\260\346\212\200\350\203\275\346\214\221\346\210\230\344\273\273\345\212\241...</span>\n                </>\n              ) : (\n                <>\n                  <Sparkles size={14} className=\"text-teal-400\" />\n                  <span>\346\231\272\350\203\275\346\216\250\346\274\224\357\274\232AI \350\204\221\346\232\264\350\256\276\350\256\241\345\205\264\350\266\243\346\214\221\346\210\230</span>\n                </>\n              )}\n            </button>\n            {errorText && <p className=\"text-xs text-rose-500 mt-1\">{errorText}</p>}\n          </div>\n\n          {/* Current Spark Recommendation */}\n          <AnimatePresence mode=\"wait\">\n            {currentChallenge && (\n              <motion.div\n                initial={{ opacity: 0, scale: 0.98 }}\n                animate={{ opacity: 1, scale: 1 }}\n                exit={{ opacity: 0, scale: 0.98 }}\n                className=\"mt-6 border border-teal-200 bg-teal-50/10 p-5 rounded-xl space-y-4\"\n              >\n                <div className=\"flex items-center justify-between border-b border-teal-100 pb-2\">\n                  <div className=\"space-y-0.5\">\n                    <span className=\"text-[10px] text-teal-800 font-bold uppercase tracking-wider\">\n                      {currentChallenge.category}\n                    </span>\n                    <h4 className=\"text-sm font-bold text-slate-800\">{currentChallenge.title}</h4>\n                  </div>\n                  <div className=\"flex flex-col items-end gap-1\">\n                    <span className=\"text-[9px] bg-teal-100 text-teal-850 font-bold px-1.5 py-0.5 rounded\">\n                      \351\232\276\345\272\246: {currentChallenge.difficulty}\n                    </span>\n                    <span className=\"text-[10px] text-slate-500 font-mono\">{currentChallenge.estimatedTime}</span>\n                  </div>\n                </div>\n\n                <div className=\"text-xs space-y-3\">\n                  <p className=\"text-slate-600 italic leading-relaxed\">\342\200\234{currentChallenge.description}\342\200\234</p>\n\n                  <div className=\"space-y-1\">\n                    <span className=\"font-bold text-slate-800\">\360\237\216\257 \350\220\275\345\234\260\346\214\207\345\215\227\346\255\245\351\252\244\357\274\232</span>\n                    <ol className=\"list-decimal list-inside space-y-1 text-slate-650 pl-1\">\n                      {currentChallenge.steps.map((st, i) => (\n                        <li key={i}>{st}</li>\n                      ))}\n                    </ol>\n                  </div>\n\n                  <div className=\"bg-white p-3 rounded-lg border border-slate-200/60 space-y-1\">\n                    <span className=\"font-bold text-emerald-800 flex items-center gap-1.5\">\n                      <Trophy size={13} className=\"text-emerald-650\" />\n                      <span>\346\214\221\346\210\230\347\273\210\346\236\201\345\277\203\346\231\272\346\210\220\351\225\277\346\224\266\350\216\267:</span>\n                    </span>\n                    <p className=\"text-slate-650 leading-relaxed italic pr-2\">{currentChallenge.rewardMindset}</p>\n                  </div>\n                </div>\n\n                <div className=\"flex gap-2 pt-2 border-t border-slate-150\">\n                  <button\n                    onClick={() => setCurrentChallenge(null)}\n                    className=\"flex-1 bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold py-2 px-3 rounded-lg text-xs transition-colors cursor-pointer\"\n                  >\n                    \346\215\242\344\270\200\344\270\252\n                  </button>\n                  <button\n                    onClick={handleAcceptChallenge}\n                    className=\"flex-1 bg-slate-850 hover:bg-slate-950 text-white font-bold py-2 px-3 rounded-lg text-xs shadow-sm flex items-center justify-center gap-1 transition-colors cursor-pointer\"\n                  >\n                    <Check size={13} />\n                    <span>\346\216\245\345\217\227\345\271\266\346\224\276\345\205\245\346\214\221\346\210\230\345\272\223</span>\n                  </button>\n                </div>\n              </motion.div>\n            )}\n          </AnimatePresence>\n        </div>\n\n        {/* Right Side: Log of Accepted Challenges */}\n        <div className=\"lg:col-span-5 space-y-6\">\n          {/* Active Challenges list */}\n          <div className=\"bg-white border border-slate-200/60 rounded-xl p-5 shadow-xs space-y-4\">\n            <h3 className=\"text-sm font-semibold text-slate-800 flex items-center gap-2 border-b border-slate-50 pb-2\">\n              <Flame size={15} className=\"text-orange-500 font-medium\" />\n              <span>\350\277\233\350\241\214\344\270\255\347\232\204\345\205\264\350\266\243\346\216\242\347\264\242 ({activeChallenges.length})</span>\n            </h3>\n\n            {activeChallenges.length === 0 ? (\n              <p className=\"text-xs text-slate-400 text-center py-6\">\n                \346\232\202\346\234\252\345\220\257\345\212\250\344\273\273\344\275\225\345\206\222\351\231\251\350\241\214\344\270\272\343\200\202\350\257\225\347\235\200\345\234\250\345\267\246\344\276\247\350\256\276\345\256\232\344\275\240\347\232\204\351\242\206\345\237\237\357\274\214\347\204\266\345\220\216\345\217\254\345\224\244AI\347\224\237\346\210\220\350\204\221\346\232\264\343\200\202\n              </p>\n            ) : (\n              <div className=\"space-y-4\">\n                {activeChallenges.map((ch) => (\n                  <div key={ch.id} className=\"border border-slate-200/80 p-3 rounded-lg space-y-3 bg-slate-50/50\">\n                    <div className=\"flex justify-between items-start\">\n                      <div>\n                        <span className=\"text-[9px] font-bold text-teal-700 bg-teal-50 px-1.5 py-0.2 rounded\">{ch.category}</span>\n                        <h4 className=\"text-xs font-bold text-slate-800 leading-tight mt-1\">{ch.title}</h4>\n                      </div>\n                      <span className=\"text-[9px] bg-slate-100 text-slate-500 px-1 rounded font-mono\">{ch.estimatedTime}</span>\n                    </div>\n\n                    <p className=\"text-[11px] text-slate-500 leading-relaxed\">{ch.description}</p>\n\n                    <div className=\"flex gap-1 pt-1\">\n                      <button\n                        onClick={() => onUpdateChallengeStatus(ch.id, \"\345\267\262\345\256\214\346\210\220\")}\n                        className=\"flex-1 bg-emerald-50 hover:bg-emerald-100 text-emerald-800 py-1 px-2 rounded font-bold text-[10px] text-center transition-colors flex items-center justify-center gap-1 cursor-pointer\"\n                      >\n                        <Check size={11} />\n                        <span>\347\252\201\347\240\264\345\256\214\346\210\220!</span>\n                      </button>\n                      <button\n                        onClick={() => onUpdateChallengeStatus(ch.id, \"\345\267\262\346\224\276\345\274\203\")}\n                        className=\"bg-slate-100 hover:bg-slate-200 text-slate-500 py-1 px-2 rounded font-semibold text-[10px] text-center transition-colors cursor-pointer\"\n                      >\n                        \346\232\202\346\220\201\347\275\256\n                      </button>\n                    </div>\n                  </div>\n                ))}\n              </div>\n            )}\n          </div>\n\n          {/* Archive of Completed Spark Actions */}\n          <div className=\"bg-white border border-slate-200/60 rounded-xl p-5 shadow-xs space-y-4\">\n            <h3 className=\"text-sm font-semibold text-slate-800 flex items-center gap-2\">\n              <Trophy size={15} className=\"text-amber-500\" />\n              <span>\350\215\243\350\200\200\345\213\213\347\253\240\345\206\214\351\207\214\347\250\213\347\242\221 ({completedChallenges.length})</span>\n            </h3>\n\n            {completedChallenges.length === 0 ? (\n              <p className=\"text-xs text-slate-400 text-center py-2\">\344\277\235\346\214\201\345\245\275\345\245\207\357\274\214\347\253\213\345\210\273\345\257\271\345\271\263\345\272\270\347\232\204\347\224\237\346\264\273\345\256\243\346\210\230\357\274\201</p>\n            ) : (\n              <div className=\"divide-y divide-slate-100 max-h-56 overflow-y-auto pr-1\">\n                {completedChallenges.map((ch) => (\n                  <div key={ch.id} className=\"py-2.5 flex items-start justify-between group\">\n                    <div>\n                      <div className=\"flex items-center gap-1.5\">\n                        <span className=\"text-[10px] font-medium text-slate-450\">[{ch.category}]</span>\n                        <h4 className=\"text-xs font-bold text-slate-800 tracking-tight\">{ch.title}</h4>\n                      </div>\n                      <p className=\"text-[10px] text-emerald-600 flex items-center gap-1 mt-0.5 font-medium\">\n                        <CheckCircle size={10} />\n                        <span>\350\276\276\346\210\220\346\227\245\346\234\237 {ch.completedDate || new Date().toISOString().split(\"T\")[0]}</span>\n                      </p>\n                    </div>\n\n                    <button\n                      onClick={() => onDeleteChallenge(ch.id)}\n                      className=\"text-slate-300 hover:text-rose-550 p-1 opacity-0 group-hover:opacity-100 transition-opacity cursor-pointer\"\n                    >\n                      <Trash2 size={11} />\n                    </button>\n                  </div>\n                ))}\n              </div>\n            )}\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n}\n"
    }
