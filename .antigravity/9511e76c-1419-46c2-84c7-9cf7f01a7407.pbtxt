    replacement_chunks {
      replacement_content: "import { useState } from \"react\";\nimport { ReadingNote, LearningPath, LearningMilestone } from \"../types\";\nimport { BookOpen, Plus, Trash2, Calendar, Sparkles, Loader2, Bookmark, CheckSquare, Award, ExternalLink, HelpCircle, ChevronRight, FileText } from \"lucide-react\";\nimport { motion, AnimatePresence } from \"motion/react\";\n\ninterface LearningSectionProps {\n  readingNotes: ReadingNote[];\n  onAddReadingNote: (note: ReadingNote) => void;\n  onDeleteReadingNote: (id: string) => void;\n  learningPaths: LearningPath[];\n  onAddLearningPath: (path: LearningPath) => void;\n  onToggleMilestone: (pathId: string, phaseTitle: string) => void;\n  onDeleteLearningPath: (id: string) => void;\n}\n\nexport default function LearningSection({\n  readingNotes,\n  onAddReadingNote,\n  onDeleteReadingNote,\n  learningPaths,\n  onAddLearningPath,\n  onToggleMilestone,\n  onDeleteLearningPath,\n}: LearningSectionProps) {\n  // Reading Note States\n  const [bookTitle, setBookTitle] = useState(\"\");\n  const [author, setAuthor] = useState(\"\");\n  const [pagesRead, setPagesRead] = useState<number | \"\">(\"\");\n  const [totalPages, setTotalPages] = useState<number | \"\">(\"\");\n  const [notes, setNotes] = useState(\"\");\n\n  // Plan Path States\n  const [subject, setSubject] = useState(\"\");\n  const [days, setDays] = useState(30);\n  const [isLoadingPath, setIsLoadingPath] = useState(false);\n  const [errorMessage, setErrorMessage] = useState(\"\");\n\n  // Handle Reading Note Submit\n  const handleAddNote = (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!bookTitle.trim() || !notes.trim()) return;\n\n    const newNote: ReadingNote = {\n      id: crypto.randomUUID(),\n      date: new Date().toISOString().split(\"T\")[0],\n      title: bookTitle.trim(),\n      author: author.trim() || undefined,\n      pagesRead: pagesRead ? Number(pagesRead) : undefined,\n      totalPages: totalPages ? Number(totalPages) : undefined,\n      notes: notes.trim(),\n    };\n\n    onAddReadingNote(newNote);\n    \n    // reset form\n    setBookTitle(\"\");\n    setAuthor(\"\");\n    setPagesRead(\"\");\n    setTotalPages(\"\");\n    setNotes(\"\");\n  };\n\n  // Handle Generate Path Submit\n  const handleGeneratePath = async (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!subject.trim()) return;\n\n    setIsLoadingPath(true);\n    setErrorMessage(\"\");\n\n    try {\n      const response = await fetch(\"/api/learning-path\", {\n        method: \"POST\",\n        headers: { \"Content-Type\": \"application/json\" },\n        body: JSON.stringify({ subject: subject.trim(), days }),\n      });\n\n      if (!response.ok) {\n        throw new Error(\"\345\255\246\344\271\240\350\267\257\345\276\204\350\256\276\350\256\241\345\244\261\350\264\245\357\274\214\350\257\267\347\250\215\345\220\216\351\207\215\350\257\225\");\n      }\n\n      const rawPath = await response.json();\n      const newPath: LearningPath = {\n        id: crypto.randomUUID(),\n        subject: rawPath.subject,\n        overview: rawPath.overview,\n        estimatedDays: rawPath.estimatedDays,\n        milestones: rawPath.milestones.map((m: any) => ({ ...m, completed: false })),\n        active: true,\n        date: new Date().toISOString().split(\"T\")[0],\n      };\n\n      onAddLearningPath(newPath);\n      setSubject(\"\");\n    } catch (err: any) {\n      console.error(err);\n      setErrorMessage(err.message || \"\350\257\267\346\261\202\350\266\205\346\227\266\357\274\214\350\257\267\351\207\215\346\226\260\346\240\270\345\257\271\347\202\271\345\207\273\343\200\202\");\n    } finally {\n      setIsLoadingPath(false);\n    }\n  };\n\n  const activePath = learningPaths.find((p) => p.active);\n\n  return (\n    <div className=\"space-y-6\">\n      {/* Header Banner */}\n      <div className=\"bg-slate-900 border border-slate-800 rounded-2xl p-6 text-white relative overflow-hidden\">\n        <div className=\"absolute right-0 top-0 translate-x-4 -translate-y-4 text-indigo-500/10 pointer-events-none\">\n          <BookOpen size={160} />\n        </div>\n        <div className=\"relative z-10 space-y-2\">\n          <div className=\"flex items-center gap-2 text-indigo-400 font-medium text-sm\">\n            <Sparkles size={16} />\n            <span>\346\240\274\347\211\251\350\207\264\347\237\245 \302\267 \347\273\210\350\272\253\345\255\246\344\271\240</span>\n          </div>\n          <h2 className=\"text-2xl font-semibold tracking-tight\">\347\273\210\350\272\253\346\210\220\351\225\277\344\270\216\350\247\204\345\210\222</h2>\n          <p className=\"text-slate-450 text-sm max-w-sm leading-relaxed\">\n            \342\200\234\350\207\252\345\276\213\347\232\204\347\273\210\347\202\271\346\230\257\350\256\244\347\237\245\347\232\204\350\267\203\350\277\201\343\200\202\342\200\235 \350\256\260\345\275\225\346\257\217\344\270\200\346\254\241\346\267\261\345\272\246\351\230\205\350\257\273\347\232\204\347\201\265\346\204\237\347\201\253\350\212\261\357\274\214\345\256\232\345\210\266\351\225\277\346\234\237\351\207\214\347\250\213\347\242\221\345\271\266\351\200\220\347\272\247\346\211\223\345\215\241\350\267\250\350\266\212\343\200\202\n          </p>\n        </div>\n      </div>\n\n      <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-6\">\n        {/* Left Side: Study Path builder and Interactive current schedule */}\n        <div className=\"lg:col-span-7 space-y-6\">\n          {/* Active Study Program */}\n          <div className=\"bg-white border border-slate-100 rounded-xl p-5 shadow-sm space-y-5\">\n            <div className=\"flex items-center justify-between border-b border-slate-50 pb-2\">\n              <h3 className=\"text-sm font-semibold text-slate-800 flex items-center gap-2\">\n                <Award size={16} className=\"text-indigo-600\" />\n                <span>\346\210\221\345\275\223\345\211\215\347\232\204\345\255\246\344\271\240\344\277\256\350\241\214\350\256\241\345\210\222</span>\n              </h3>\n              {activePath && (\n                <button\n                  type=\"button\"\n                  onClick={() => onDeleteLearningPath(activePath.id)}\n                  className=\"text-[10px] text-slate-400 hover:text-rose-500 font-semibold cursor-pointer\"\n                >\n                  \346\224\276\345\274\203\346\255\244\345\255\246\347\247\221\350\256\241\345\210\222\n                </button>\n              )}\n            </div>\n\n            {activePath ? (\n              <div className=\"space-y-4 text-xs\">\n                {/* Subject description */}\n                <div className=\"p-3 bg-indigo-50/50 rounded-lg space-y-1\">\n                  <div className=\"flex items-center justify-between\">\n                    <span className=\"font-extrabold text-[#3a3b98] text-sm\">\343\200\212{activePath.subject}\343\200\213\344\270\273\347\272\277\350\256\241\345\210\222</span>\n                    <span className=\"text-[10px] font-mono text-indigo-700 bg-indigo-100/50 px-2 py-0.5 rounded font-bold\">\n                      \345\221\250\346\234\237: {activePath.estimatedDays}\n                    </span>\n                  </div>\n                  <p className=\"text-slate-600 leading-relaxed italic mt-1 font-medium\">\342\200\234{activePath.overview}\342\200\235</p>\n                </div>\n\n                {/* Progress Indicators */}\n                <div className=\"space-y-4 relative pl-3 border-l-2 border-indigo-100/80\">\n                  {activePath.milestones.map((ms, index) => (\n                    <div key={index} className=\"relative pl-4 space-y-1 group\">\n                      {/* Interactive dot */}\n                      <button\n                        onClick={() => onToggleMilestone(activePath.id, ms.title)}\n                        className={`absolute -left-[21px] top-0.5 h-4.5 w-4.5 rounded-full border-2 flex items-center justify-center transition-all cursor-pointer ${\n                          ms.completed\n                            ? \"bg-indigo-650 border-indigo-650 text-white\"\n                            : \"bg-white border-slate-300 hover:border-indigo-500 text-transparent\"\n                        }`}\n                        title={ms.completed ? \"\346\240\207\344\270\272\346\234\252\345\256\214\346\210\220\" : \"\346\240\207\344\270\272\345\267\262\345\256\214\346\210\220\"}\n                      >\n                        <CheckSquare size={10} className=\"stroke-[3]\" />\n                      </button>\n\n                      <div className=\"flex items-baseline justify-between\">\n                        <h4 className={`font-bold text-xs ${ms.completed ? \"text-slate-400 line-through\" : \"text-slate-800\"}`}>\n                          {ms.phase}\357\274\232{ms.title}\n                        </h4>\n                        <span className=\"text-[10px] font-mono text-indigo-600 font-semibold bg-indigo-50 px-1.5 py-0.2 rounded\">\n                          {ms.timeRange}\n                        </span>\n                      </div>\n                      <p className={`text-[11px] leading-relaxed ${ms.completed ? \"text-slate-350\" : \"text-slate-600\"}`}>\n                        {ms.content}\n                      </p>\n\n                      {ms.recommendedResources && ms.recommendedResources.length > 0 && (\n                        <div className=\"pt-1 select-none\">\n                          <span className={`text-[9px] font-semibold ${ms.completed ? \"text-slate-300\" : \"text-amber-700\"}`}>\n                            \360\237\223\232 \347\273\217\345\205\270\346\216\250\350\215\220\351\230\205\350\257\273\344\270\216\345\267\245\345\205\267:\n                          </span>\n                          <div className=\"flex flex-wrap gap-1 mt-0.5\">\n                            {ms.recommendedResources.map((res, i) => (\n                              <span\n                                key={i}\n                                className={`text-[9.5px] border py-0.5 px-2 rounded-full ${\n                                  ms.completed\n                                    ? \"border-slate-100 text-slate-300\"\n                                    : \"bg-amber-50/50 border-amber-100 text-amber-900\"\n                                }`}\n                              >\n                                {res}\n                              </span>\n                            ))}\n                          </div>\n                        </div>\n                      )}\n                    </div>\n                  ))}\n                </div>\n\n                {/* completion rate */}\n                {(() => {\n                  const done = activePath.milestones.filter((m) => m.completed).length;\n                  const total = activePath.milestones.length;\n                  const pct = Math.round((done / total) * 100);\n                  return (\n                    <div className=\"pt-2 border-t border-slate-100\">\n                      <div className=\"flex justify-between items-center text-[10px] text-slate-500 font-medium font-mono mb-1\">\n                        <span>\344\277\256\347\202\274\350\277\233\345\272\246\345\267\262\350\276\276\346\210\220</span>\n                        <span>{pct}% ({done}/{total})</span>\n                      </div>\n                      <div className=\"w-full h-1.5 bg-slate-100 rounded-full overflow-hidden\">\n                        <div style={{ width: `${pct}%` }} className=\"h-full bg-indigo-600 transition-all duration-500\"></div>\n                      </div>\n                    </div>\n                  );\n                })()}\n              </div>\n            ) : (\n              <div className=\"text-center py-6 bg-slate-50/60 rounded-xl border border-dashed border-slate-200\">\n                <p className=\"text-xs text-slate-500 leading-relaxed mb-4\">\n                  \346\232\202\346\234\252\345\256\232\345\210\266\344\273\273\344\275\225\345\244\247\351\203\250\345\244\264\347\237\245\350\257\206\346\216\242\347\264\242\344\273\273\345\212\241\343\200\202<br />\347\273\231\345\207\272\346\202\250\347\233\256\345\211\215\346\236\201\346\234\211\345\206\262\345\212\250\346\216\242\345\272\225\347\232\204\347\237\245\350\257\206\350\257\215\346\235\241\357\274\214\344\272\244\347\224\261 AI \345\212\240\351\200\237\350\256\276\350\256\241\357\274\201\n                </p>\n\n                {/* Builder Form */}\n                <form onSubmit={handleGeneratePath} className=\"max-w-md mx-auto space-y-3 px-4 text-left\">\n                  <div className=\"grid grid-cols-3 gap-2\">\n                    <div className=\"col-span-2 space-y-0.5\">\n                      <label className=\"text-[10px] text-slate-400 font-semibold uppercase\">\345\255\246\344\271\240\345\255\246\347\247\221\350\257\215\346\235\241 / \344\270\273\351\242\230</label>\n                      <input\n                        type=\"text\"\n                        required\n                        placeholder=\"\345\246\202\357\274\232\351\207\217\345\255\220\345\212\233\345\255\246\346\265\205\345\260\235\343\200\201\345\224\220\345\256\213\345\205\253\345\244\247\345\256\266\350\257\227\350\257\215\350\211\272\346\234\257\"\n                        value={subject}\n                        onChange={(e) => setSubject(e.target.value)}\n                        className=\"w-full text-xs border border-slate-200 rounded-lg p-2.5 focus:outline-none focus:ring-1 focus:ring-indigo-500 bg-white\"\n                      />\n                    </div>\n                    <div className=\"space-y-0.5\">\n                      <label className=\"text-[10px] text-slate-400 font-semibold uppercase\">\346\234\237\345\276\205\346\200\273\346\227\266\351\225\277</label>\n                      <select\n                        value={days}\n                        onChange={(e) => setDays(Number(e.target.value))}\n                        className=\"w-full text-xs border border-slate-200 rounded-lg p-2.5 bg-white text-slate-700 focus:outline-none focus:ring-1 focus:ring-indigo-500\"\n                      >\n                        <option value={15}>15 \345\244\251\347\252\201\345\207\273</option>\n                        <option value={30}>30 \345\244\251\344\277\256\350\241\214</option>\n                        <option value={60}>60 \345\244\251\345\233\272\345\214\226</option>\n                        <option value={100}>100 \345\244\251\347\255\221\345\237\272</option>\n                      </select>\n                    </div>\n                  </div>\n\n                  <button\n                    type=\"submit\"\n                    disabled={isLoadingPath || !subject.trim()}\n                    className={`w-full py-2.5 text-xs rounded-lg font-bold shadow-sm transition-all flex items-center justify-center gap-1.5 cursor-pointer ${\n                      isLoadingPath || !subject.trim()\n                        ? \"bg-slate-100 text-slate-400 cursor-not-allowed shadow-none\"\n                        : \"bg-indigo-600 hover:bg-indigo-750 text-white\"\n                    }`}\n                  >\n                    {isLoadingPath ? (\n                      <>\n                        <Loader2 size={13} className=\"animate-spin\" />\n                        <span>AI\346\210\220\351\225\277\351\241\276\351\227\256\346\255\243\345\234\250\351\207\217\350\272\253\345\210\273\346\235\277\344\270\255...</span>\n                      </>\n                    ) : (\n                      <>\n                        <Sparkles size={13} />\n                        <span>\347\224\237\346\210\220\351\225\277\345\221\250\346\234\237\351\273\204\351\207\221\351\207\214\347\250\213\346\211\223\345\215\241\350\267\257\345\276\204</span>\n                      </>\n                    )}\n                  </button>\n                </form>\n                {errorMessage && <p className=\"text-[10px] text-rose-500 mt-2\">{errorMessage}</p>}\n              </div>\n            )}\n          </div>\n\n          {/* Render past programs list if any */}\n          {learningPaths.length > 1 && (\n            <div className=\"bg-white border border-slate-100 rounded-xl p-5 shadow-sm space-y-2\">\n              <span className=\"text-xs font-bold text-slate-650\">\346\210\221\346\233\276\345\256\232\345\210\266\347\232\204\344\277\256\351\201\223\351\231\242\346\270\205\345\215\225</span>\n              <div className=\"space-y-1.5\">\n                {learningPaths.filter((p) => p.id !== activePath?.id).map((p) => (\n                  <div key={p.id} className=\"flex justify-between items-center text-xs p-2 bg-slate-50/50 rounded-lg border border-slate-100\">\n                    <span className=\"font-semibold text-slate-700\">\343\200\212{p.subject}\343\200\213\351\207\214\347\250\213\347\242\221\345\215\241\347\211\207</span>\n                    <button\n                      onClick={() => onDeleteLearningPath(p.id)}\n                      className=\"text-[10px] text-rose-500 hover:underline cursor-pointer\"\n                    >\n                      \345\210\240\351\231\244\n                    </button>\n                  </div>\n                ))}\n              </div>\n            </div>\n          )}\n        </div>\n\n        {/* Right Side: Reading notes logger and list */}\n        <div className=\"lg:col-span-5 space-y-6\">\n          {/* Form */}\n          <div className=\"bg-white border border-slate-100 rounded-xl p-5 shadow-sm space-y-4\">\n            <h3 className=\"text-sm font-semibold text-slate-800 flex items-center gap-2 border-b border-slate-50 pb-2\">\n              <Bookmark size={15} className=\"text-indigo-650\" />\n              <span>\350\256\260\344\270\213\344\270\200\345\274\240\346\231\272\346\205\247\351\230\205\350\257\273\345\215\241\347\211\207</span>\n            </h3>\n\n            <form onSubmit={handleAddNote} className=\"space-y-3\">\n              <div className=\"space-y-0.5\">\n                <label className=\"text-xs text-slate-500 font-medium\">\344\271\246\345\220\215/\345\255\246\347\247\221\344\270\223\350\221\227</label>\n                <input\n                  type=\"text\"\n                  required\n                  placeholder=\"\344\276\213\345\246\202\357\274\232\343\200\212\350\207\252\346\216\247\345\212\233\343\200\213\343\200\201\343\200\212\346\211\271\345\210\244\346\200\247\346\200\235\347\273\264\343\200\213\346\210\226\346\237\220\345\234\250\347\272\277\346\225\231\347\250\213\"\n                  value={bookTitle}\n                  onChange={(e) => setBookTitle(e.target.value)}\n                  className=\"w-full text-xs border border-slate-200 rounded-lg p-2.5 focus:ring-1 focus:ring-indigo-500 focus:outline-none\"\n                />\n              </div>\n\n              <div className=\"grid grid-cols-3 gap-2 text-xs\">\n                <div className=\"col-span-1 space-y-0.5\">\n                  <label className=\"text-slate-500 font-medium\">\344\275\234\350\200\205(\351\200\211\345\241\253)</label>\n                  <input\n                    type=\"text\"\n                    placeholder=\"\345\246\202\357\274\232\345\207\257\345\210\251\302\267\351\272\246\346\240\274\345\260\274\346\240\274\345\260\224\"\n                    value={author}\n                    onChange={(e) => setAuthor(e.target.value)}\n                    className=\"w-full border border-slate-200 rounded-lg p-1.5 focus:outline-none focus:ring-1 focus:ring-indigo-500\"\n                  />\n                </div>\n                <div className=\"space-y-0.5\">\n                  <label className=\"text-slate-500 font-medium\">\344\273\212\346\227\245\345\267\262\350\257\273</label>\n                  <input\n                    type=\"number\"\n                    min={1}\n                    placeholder=\"\351\241\265\347\240\201\"\n                    value={pagesRead}\n                    onChange={(e) => setPagesRead(e.target.value ? Number(e.target.value) : \"\")}\n                    className=\"w-full border border-slate-200 rounded-lg p-1.5 focus:outline-none focus:ring-1 focus:ring-indigo-500\"\n                  />\n                </div>\n                <div className=\"space-y-0.5\">\n                  <label className=\"text-slate-500 font-medium\">\345\205\250\344\271\246\346\200\273\351\241\265</label>\n                  <input\n                    type=\"number\"\n                    min={1}\n                    placeholder=\"\351\241\265\347\240\201\"\n                    value={totalPages}\n                    onChange={(e) => setTotalPages(e.target.value ? Number(e.target.value) : \"\")}\n                    className=\"w-full border border-slate-200 rounded-lg p-1.5 focus:outline-none focus:ring-1 focus:ring-indigo-500\"\n                  />\n                </div>\n              </div>\n\n              <div className=\"space-y-0.5\">\n                <label className=\"text-xs text-slate-500 font-medium\">\346\240\270\345\277\203\347\262\276\351\253\223\343\200\201\347\237\245\350\257\206\347\202\271\344\270\216\346\200\235\346\203\263\347\242\260\346\222\236</label>\n                <textarea\n                  rows={4}\n                  required\n                  placeholder=\"\350\277\231\345\274\240\345\215\241\347\211\207\350\256\260\344\270\213\344\272\206\346\210\221\347\232\204\344\273\200\344\271\210\346\240\270\345\277\203\351\242\206\346\202\237\357\274\237\350\256\260\345\275\225\346\226\271\346\263\225\343\200\201\347\224\237\350\257\215\343\200\201\351\207\221\345\217\245\357\274\214\346\210\226\345\274\225\345\217\221\344\272\206\346\210\221\346\200\216\346\240\267\347\232\204\350\241\214\344\270\272\345\217\215\346\200\235...\"\n                  value={notes}\n                  onChange={(e) => setNotes(e.target.value)}\n                  className=\"w-full text-xs border border-slate-200 rounded-lg p-2.5 focus:ring-1 focus:ring-indigo-500 focus:outline-none\"\n                />\n              </div>\n\n              <button\n                type=\"submit\"\n                className=\"w-full bg-gradient-to-r from-slate-800 to-slate-900 hover:from-slate-900 hover:to-slate-950 text-white rounded-lg p-2 text-xs font-semibold shadow hover:shadow-md transition-all active:scale-[0.99] cursor-pointer\"\n              >\n                \344\277\235\345\255\230\351\230\205\350\257\273\347\254\224\350\256\260\345\215\241\347\211\207\n              </button>\n            </form>\n          </div>\n\n          {/* List */}\n          <div className=\"bg-white border border-slate-100 rounded-xl p-5 shadow-sm space-y-4\">\n            <h3 className=\"text-sm font-semibold text-slate-800 flex items-center gap-1.5\">\n              <FileText size={15} className=\"text-slate-600\" />\n              <span>\347\237\245\350\257\206\345\255\230\347\233\230\345\215\241\347\211\207\345\272\223 ({readingNotes.length})</span>\n            </h3>\n\n            {readingNotes.length === 0 ? (\n              <p className=\"text-xs text-slate-400 text-center py-4\">\n                \347\254\224\350\256\260\345\244\204\350\277\230\346\230\257\347\251\272\347\231\275\347\232\204\347\272\270\345\274\240\343\200\202\350\257\273\344\271\246\345\215\263\346\230\257\344\270\216\344\274\237\345\244\247\346\231\272\350\200\205\347\232\204\346\227\240\345\243\260\345\257\271\350\257\235\357\274\214\345\274\200\345\247\213\344\275\240\347\232\204\350\256\260\345\275\225\345\220\247\357\274\201\n              </p>\n            ) : (\n              <div className=\"divide-y divide-slate-100 max-h-64 overflow-y-auto pr-1\">\n                {readingNotes.map((card) => (\n                  <div key={card.id} className=\"py-3 flex flex-col justify-between group\">\n                    <div className=\"flex justify-between items-start\">\n    