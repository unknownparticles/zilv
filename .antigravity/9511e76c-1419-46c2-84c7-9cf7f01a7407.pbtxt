    replacement_chunks {
      replacement_content: "import React, { useState } from \"react\";\nimport { WorkoutRecord, WorkoutPlan } from \"../types\";\nimport { Dumbbell, Plus, Trash2, Calendar, Sparkles, Loader2, Play, Flame, Zap, ShieldAlert, CheckCircle } from \"lucide-react\";\nimport { motion, AnimatePresence } from \"motion/react\";\n\ninterface WorkoutSectionProps {\n  records: WorkoutRecord[];\n  onAddRecord: (record: WorkoutRecord) => void;\n  onDeleteRecord: (id: string) => void;\n  workoutPlans: WorkoutPlan[];\n  onAddPlan: (plan: WorkoutPlan) => void;\n}\n\nconst WORKOUT_PRESETS = [\n  { label: \"\360\237\217\203 \346\210\267\345\244\226\346\205\242\350\267\221 30\345\210\206\", type: \"\346\234\211\346\260\247\350\267\221\346\255\245\", duration: 30, calories: 240, intensity: \"\344\270\255\" as const },\n  { label: \"\360\237\232\264 \346\210\267\345\244\226\351\252\221\350\241\214 30\345\210\206\", type: \"\345\277\253\350\265\260\346\210\226\345\215\225\350\275\246\", duration: 30, calories: 180, intensity: \"\344\270\255\" as const },\n  { label: \"\360\237\217\213\357\270\217 \345\231\250\346\242\260\346\222\270\351\223\201 40\345\210\206\", type: \"\345\212\233\351\207\217\345\231\250\346\242\260\351\230\273\345\212\233\350\256\255\347\273\203\", duration: 40, calories: 320, intensity: \"\351\253\230\" as const },\n  { label: \"\360\237\247\230 \347\221\234\344\274\275\346\213\211\344\274\270 20\345\210\206\", type: \"\345\261\205\345\256\266\350\207\252\351\207\215\345\201\245\350\272\253\", duration: 20, calories: 80, intensity: \"\344\275\216\" as const },\n  { label: \"\342\232\241 \347\207\203\350\204\202HIIT 20\345\210\206\", type: \"\351\253\230\345\274\272\345\272\246\351\227\264\346\255\207 (HIIT)\", duration: 20, calories: 200, intensity: \"\351\253\230\" as const }\n];\n\nexport default function WorkoutSection({\n  records,\n  onAddRecord,\n  onDeleteRecord,\n  workoutPlans,\n  onAddPlan,\n}: WorkoutSectionProps) {\n  // Log record state\n  const [type, setType] = useState(\"\346\234\211\346\260\247\350\267\221\346\255\245\");\n  const [duration, setDuration] = useState(30);\n  const [calories, setCalories] = useState(250);\n  const [intensity, setIntensity] = useState<\"\344\275\216\" | \"\344\270\255\" | \"\351\253\230\">(\"\344\270\255\");\n  const [date, setDate] = useState(() => new Date().toISOString().split(\"T\")[0]);\n  const [showSuccessBanner, setShowSuccessBanner] = useState(false);\n\n  // AI Plan generation state\n  const [target, setTarget] = useState(\"\345\207\217\350\204\202\346\216\247\351\207\215\");\n  const [level, setLevel] = useState(\"\345\210\235\345\255\246\350\200\205\");\n  const [durationMinutes, setDurationMinutes] = useState(30);\n  const [age, setAge] = useState(25);\n  const [gender, setGender] = useState(\"\346\234\252\346\214\207\345\256\232\");\n  const [isLoadingPlan, setIsLoadingPlan] = useState(false);\n  const [activePlan, setActivePlan] = useState<WorkoutPlan | null>(null);\n  const [errorMessage, setErrorMessage] = useState(\"\");\n\n  const triggerSuccess = () => {\n    setShowSuccessBanner(true);\n    setTimeout(() => setShowSuccessBanner(false), 3000);\n  };\n\n  const handleSubmitRecord = (e: React.FormEvent) => {\n    e.preventDefault();\n    const newRecord: WorkoutRecord = {\n      id: crypto.randomUUID(),\n      date,\n      type,\n      duration: Number(duration),\n      calories: Number(calories),\n      intensity,\n      planName: activePlan ? `${activePlan.target}\350\256\255\347\273\203\350\256\241\345\210\222` : undefined,\n    };\n    onAddRecord(newRecord);\n    triggerSuccess();\n    // Reset defaults but keep date\n    setType(\"\346\234\211\346\260\247\350\267\221\346\255\245\");\n    setDuration(30);\n    setCalories(250);\n  };\n\n  const handleApplyPreset = (preset: typeof WORKOUT_PRESETS[0]) => {\n    const newRecord: WorkoutRecord = {\n      id: crypto.randomUUID(),\n      date: new Date().toISOString().split(\"T\")[0],\n      type: preset.type,\n      duration: preset.duration,\n      calories: preset.calories,\n      intensity: preset.intensity,\n    };\n    onAddRecord(newRecord);\n    triggerSuccess();\n  };\n\n  const handleGeneratePlan = async () => {\n    setIsLoadingPlan(true);\n    setErrorMessage(\"\");\n    try {\n      const response = await fetch(\"/api/workout-plan\", {\n        method: \"POST\",\n        headers: { \"Content-Type\": \"application/json\" },\n        body: JSON.stringify({ target, level, durationMinutes, age, gender }),\n      });\n\n      if (!response.ok) {\n        throw new Error(\"\347\224\237\346\210\220\345\201\245\350\272\253\350\256\241\345\210\222\345\244\261\350\264\245\357\274\214\350\257\267\347\250\215\345\220\216\351\207\215\350\257\225\");\n      }\n\n      const planData: WorkoutPlan = await response.json();\n      onAddPlan(planData);\n      setActivePlan(planData);\n    } catch (err: any) {\n      console.error(err);\n      setErrorMessage(err.message || \"\350\277\236\346\216\245\346\234\215\345\212\241\345\231\250\350\266\205\346\227\266\357\274\214\350\257\267\351\207\215\350\257\225\343\200\202\");\n    } finally {\n      setIsLoadingPlan(false);\n    }\n  };\n\n  // Stats calculation\n  const totalCalories = records.reduce((sum, r) => sum + r.calories, 0);\n  const totalMinutes = records.reduce((sum, r) => sum + r.duration, 0);\n\n  return (\n    <div className=\"space-y-6\">\n      {/* Header Banner - High Contrast Charcoal and Orange */}\n      <div className=\"bg-slate-900 border border-slate-800 rounded-2xl p-6 text-white relative overflow-hidden\">\n        <div className=\"absolute right-0 top-0 translate-x-4 -translate-y-4 text-orange-500/10 pointer-events-none\">\n          <Dumbbell size={160} />\n        </div>\n        <div className=\"relative z-10 space-y-2\">\n          <div className=\"flex items-center gap-2 text-orange-400 font-medium text-sm\">\n            <Sparkles size={16} />\n            <span>\351\233\225\347\220\242\344\275\223\351\255\204 \302\267 \347\224\237\345\221\275\345\276\213\345\212\250</span>\n          </div>\n          <h2 className=\"text-2xl font-bold tracking-tight\">\350\277\220\345\212\250\345\201\245\350\272\253\345\201\245\350\203\275</h2>\n          <p className=\"text-slate-400 text-xs max-w-sm leading-relaxed\">\n            \342\200\234\350\207\252\345\276\213\347\232\204\344\275\223\351\255\204\357\274\214\350\225\264\345\220\253\345\274\272\351\237\247\347\232\204\346\204\217\345\277\227\343\200\202\342\200\235 \350\256\260\345\275\225\346\257\217\346\254\241\346\261\227\346\260\264\346\265\201\350\277\207\357\274\214\350\256\251\350\272\253\344\275\223\347\232\204\346\257\217\344\270\200\346\254\241\350\277\233\346\255\245\351\203\275\346\270\205\346\231\260\345\217\257\350\247\201\343\200\202\n          </p>\n        </div>\n      </div>\n\n      {/* Success Banner */}\n      <AnimatePresence>\n        {showSuccessBanner && (\n          <motion.div\n            initial={{ opacity: 0, y: -10 }}\n            animate={{ opacity: 1, y: 0 }}\n            exit={{ opacity: 0, y: -10 }}\n            className=\"bg-emerald-50 border border-emerald-200 text-emerald-800 p-3 rounded-lg text-xs flex items-center gap-2\"\n          >\n            <CheckCircle size={14} className=\"text-emerald-605\" />\n            <span>\347\231\273\350\256\260\346\210\220\345\212\237\357\274\201\350\277\220\345\212\250\346\261\227\346\260\264\351\223\270\345\260\261\345\274\272\351\237\247\344\271\213\350\272\257\343\200\202</span>\n          </motion.div>\n        )}\n      </AnimatePresence>\n\n      {/* Simplified Workout Presets */}\n      <div className=\"bg-white border border-slate-200/60 rounded-xl p-5 shadow-xs space-y-3\">\n        <div className=\"flex items-center justify-between\">\n          <h3 className=\"text-sm font-semibold text-slate-800 flex items-center gap-1.5\">\n            <span className=\"text-orange-500\">\360\237\224\245</span>\n            <span>\344\270\200\351\224\256\345\277\253\346\215\267\350\256\260\345\275\225 (\346\236\201\347\256\200\351\231\215\345\231\252\350\277\220\345\212\250\350\256\260\345\275\225)</span>\n          </h3>\n          <span className=\"text-[10px] text-slate-400\">\344\270\200\345\207\273\345\215\263\344\270\255</span>\n        </div>\n        <div className=\"grid grid-cols-2 gap-2 sm:grid-cols-5\">\n          {WORKOUT_PRESETS.map((p) => (\n            <button\n              key={p.label}\n              onClick={() => handleApplyPreset(p)}\n              className=\"py-2 px-1 relative bg-slate-50 hover:bg-slate-100 border border-slate-200/80 rounded-lg text-center transition-all cursor-pointer active:scale-98\"\n            >\n              <div className=\"text-[11px] font-semibold text-slate-700 truncate\">{p.label}</div>\n              <div className=\"text-[9px] text-orange-600 font-mono mt-0.5\">\n                {p.calories} kcal\n              </div>\n            </button>\n          ))}\n        </div>\n      </div>\n\n      {/* Big Numbers Overview */}\n      <div className=\"grid grid-cols-2 gap-4\">\n        <div className=\"bg-white border border-slate-200/60 rounded-xl p-4 shadow-xs relative overflow-hidden\">\n          <div className=\"absolute top-2 right-2 text-orange-500/10 bg-orange-50 p-2 rounded-lg\">\n            <Flame size={20} className=\"text-orange-600\" />\n          </div>\n          <p className=\"text-xs text-slate-500 font-medium\">\347\264\257\350\256\241\347\207\203\347\203\247\347\203\255\351\207\217</p>\n          <div className=\"mt-2 flex items-baseline gap-1\">\n            <span className=\"text-2xl font-extrabold text-slate-900\">{totalCalories}</span>\n            <span className=\"text-xs text-slate-500\">kcal</span>\n          </div>\n          <p className=\"text-[10px] text-slate-450 mt-1\">\350\266\212\350\277\220\345\212\250\357\274\214\350\266\212\345\274\272\345\201\245</p>\n        </div>\n\n        <div className=\"bg-white border border-slate-200/60 rounded-xl p-4 shadow-xs relative overflow-hidden\">\n          <div className=\"absolute top-2 right-2 text-slate-800/15 bg-slate-100 p-2 rounded-lg\">\n            <Zap size={20} className=\"text-slate-700\" />\n          </div>\n          <p className=\"text-xs text-slate-500 font-medium\">\347\264\257\350\256\241\351\224\273\347\202\274\346\227\266\351\225\277</p>\n          <div className=\"mt-2 flex items-baseline gap-1\">\n            <span className=\"text-2xl font-extrabold text-slate-900\">{totalMinutes}</span>\n            <span className=\"text-xs text-slate-500\">\345\210\206\351\222\237</span>\n          </div>\n          <p className=\"text-[10px] text-slate-450 mt-1\">\346\227\266\351\227\264\346\262\211\346\267\200\345\212\233\351\207\217</p>\n        </div>\n      </div>\n\n      <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-6\">\n        {/* Left Hand: AI personalized fitness companion */}\n        <div className=\"lg:col-span-12 xl:col-span-7 bg-white border border-slate-200/60 p-5 rounded-xl shadow-xs space-y-5\">\n          <div className=\"flex items-center gap-2 border-b border-slate-50 pb-2 mb-2\">\n            <Sparkles size={16} className=\"text-orange-500\" />\n            <h3 className=\"text-sm font-semibold text-slate-800\">\345\256\232\345\210\266\344\270\252\346\200\247\345\214\226\345\215\225\346\254\241\350\256\255\347\273\203\350\256\241\345\210\222</h3>\n          </div>\n\n          <div className=\"grid grid-cols-2 gap-4 text-xs\">\n            <div className=\"space-y-1\">\n              <label className=\"text-slate-500 font-medium\">\345\201\245\350\272\253\344\270\273\350\257\211\347\233\256\346\240\207</label>\n              <select\n                value={target}\n                onChange={(e) => setTarget(e.target.value)}\n                className=\"w-full border border-slate-200 rounded-lg p-2 bg-white text-slate-700 focus:outline-none focus:ring-1 focus:ring-orange-500\"\n              >\n                <option value=\"\345\207\217\350\204\202\346\216\247\351\207\215\">\345\207\217\350\204\202\346\216\247\351\207\215</option>\n                <option value=\"\345\242\236\350\202\214\345\241\221\345\275\242\">\345\242\236\350\202\214\345\241\221\345\275\242</option>\n                <option value=\"\345\277\203\350\202\272\344\275\223\350\203\275\345\274\272\345\214\226\">\345\277\203\350\202\272\344\275\223\350\203\275\345\274\272\345\214\226</option>\n                <option value=\"\344\271\205\345\235\220\350\202\251\351\242\210\344\277\256\345\244\215\">\344\271\205\345\235\220\350\202\251\351\242\210\344\277\256\345\244\215</option>\n                <option value=\"\346\227\245\345\270\270\346\213\211\344\274\270\346\224\276\346\235\276\">\346\227\245\345\270\270\346\213\211\344\274\270\346\224\276\346\235\276</option>\n              </select>\n            </div>\n\n            <div className=\"space-y-1\">\n              <label className=\"text-slate-500 font-medium\">\350\277\220\345\212\250\345\237\272\347\241\200</label>\n              <select\n                value={level}\n                onChange={(e) => setLevel(e.target.value)}\n                className=\"w-full border border-slate-200 rounded-lg p-2 bg-white text-slate-700 focus:outline-none focus:ring-1 focus:ring-orange-500\"\n              >\n                <option value=\"\345\210\235\345\255\246\350\200\205 (\345\210\232\350\265\267\346\255\245)\">\345\210\235\345\255\246\350\200\205</option>\n                <option value=\"\350\277\233\351\230\266 (\346\234\211\344\270\200\345\256\232\350\256\255\347\273\203\347\273\217\351\252\214)\">\350\277\233\351\230\266\350\200\205</option>\n                <option value=\"\351\253\230\351\230\266 (\350\203\275\345\244\237\346\216\214\346\216\247\345\244\247\351\207\215\351\207\217/\351\253\230\345\277\203\347\216\207)\">\346\236\201\351\231\220\345\205\210\351\224\213</option>\n              </select>\n            </div>\n\n            <div className=\"space-y-1\">\n              <label className=\"text-slate-500 font-medium\">\350\256\255\347\273\203\346\227\266\351\225\277\351\242\204\347\256\227 (\345\210\206\351\222\237)</label>\n              <input\n                type=\"number\"\n                min={10}\n                max={120}\n                value={durationMinutes}\n                onChange={(e) => setDurationMinutes(Number(e.target.value))}\n                className=\"w-full border border-slate-200 rounded-lg p-2 text-slate-700 focus:outline-none focus:ring-1 focus:ring-orange-500\"\n              />\n            </div>\n\n            <div className=\"space-y-1\">\n              <label className=\"text-slate-500 font-medium\">\346\202\250\347\232\204\345\271\264\351\276\204</label>\n              <input\n                type=\"number\"\n                min={12}\n                max={90}\n                value={age}\n                onChange={(e) => setAge(Number(e.target.value))}\n                className=\"w-full border border-slate-200 rounded-lg p-2 text-slate-700 focus:outline-none focus:ring-1 focus:ring-orange-500\"\n              />\n            </div>\n          </div>\n\n          <button\n            onClick={handleGeneratePlan}\n            disabled={isLoadingPlan}\n            className=\"w-full bg-slate-800 hover:bg-slate-900 p-2.5 text-xs text-white font-semibold rounded-lg shadow-sm flex items-center justify-center gap-1.5 transition-all cursor-pointer\"\n          >\n            {isLoadingPlan ? (\n              <>\n                <Loader2 size={13} className=\"animate-spin\" />\n                <span>AI \346\255\243\345\234\250\347\262\276\345\257\206\346\216\222\350\257\276\350\256\276\350\256\241\344\270\255...</span>\n              </>\n            ) : (\n              <>\n                <Zap size={13} />\n                <span>\345\205\250\346\226\260AI\344\270\252\346\200\247\345\214\226\350\256\255\347\273\203\350\256\241\345\210\222\347\224\237\346\210\220</span>\n              </>\n            )}\n          </button>\n          {errorMessage && <p className=\"text-[10px] text-rose-500\">{errorMessage}</p>}\n\n          {/* Render Active Workout Plan */}\n          <AnimatePresence mode=\"wait\">\n            {activePlan ? (\n              <motion.div\n                initial={{ opacity: 0, y: 10 }}\n                animate={{ opacity: 1, y: 0 }}\n                exit={{ opacity: 0, y: -10 }}\n                className=\"border border-slate-200 bg-slate-50/50 rounded-xl p-4 space-y-4\"\n              >\n                <div className=\"flex items-center justify-between border-b border-slate-100 pb-2\">\n                  <div className=\"flex items-center gap-1.5\">\n                    <Play size={14} className=\"text-slate-800\" />\n                    <span className=\"text-xs font-bold text-slate-800\">{activePlan.target}\350\256\255\347\273\203\350\257\276</span>\n                  </div>\n                  <span className=\"text-[10px] bg-slate-200 text-slate-750 px-2 py-0.5 rounded font-semibold font-mono\">\n                    {activePlan.totalDuration}\n                  </span>\n                </div>\n\n                <div className=\"text-xs space-y-3\">\n                  {/* Warmup */}\n                  <div className=\"space-y-0.5\">\n                    <h4 className=\"font-bold text-slate-800 flex items-center gap-1\">\342\217\260 1. \345\220\257\345\212\250\344\270\216\347\203\255\350\272\253\346\256\265</h4>\n                    <p className=\"text-slate-650 leading-relaxed pl-4 text-xs\">{activePlan.warmup}</p>\n                  </div>\n\n                  {/* Main exercise sequence */}\n                  <div className=\"space-y-2\">\n                    <h4 className=\"font-bold text-slate-800 flex items-center gap-1\">\360\237\222\252 2. \346\255\243\345\274\217\345\212\233\351\207\217\344\270\216\344\275\223\350\203\275\346\250\241\347\273\204</h4>\n                    <div className=\"space-y-1.5 pl-4\">\n                      {activePlan.mainExercises.map((ex, i) => (\n                        <div key={i} className=\"bg-white border border-slate-200/60 p-2.5 rounded-lg space-y-0.5\">\n                          <div className=\"flex justify-between items-center\">\n                            <span className=\"font-semibold text-slate-800 text-xs\">{ex.name}</span>\n                            <span className=\"text-[10px] text-orange-650 font-mono font-semibold bg-orange-50 px-1.5 py-0.5 rounded\">{ex.sets}</span>\n                          </div>\n                          {ex.description && <p className=\"text-[11px] text-slate-500 leading-snug\">{ex.description}</p>}\n                          <p className=\"text-[9px] text-slate-400 font-medium\">\360\237\222\241 \347\273\204\351\227\264\344\274\221\346\201\257: {ex.rest}</p>\n                        </div>\n                      ))}\n                    </div>\n                  </div>\n\n                  {/* Cooldown */}\n                  <div className=\"space-y-0.5\">\n                    <h4 className=\"font-bold text-slate-850 flex items-center gap-1\">\360\237\247\230 3. \345\206\267\350\272\253\346\213\211\344\274\270\344\270\216\345\233\236\345\244\215</h4>\n                    <p className=\"text-slate-650 leading-relaxed pl-4 text-xs\">{activePlan.cooldown}</p>\n                  </div>\n\n                  {/* Safety */}\n                  <div className=\"bg-slate-100 p-2.5 rounded-lg text-slate-800 flex gap-2 border border-slate-200\">\n                    <ShieldAlert size={14} className=\"shrink-0 text-slate-700 mt-0.5\" />\n                    <div className=\"space-y-0.5\">\n                      <span className=\"font-extrabold text-[11px] text-slate-900\">\345\256\211\345\205\250\351\230\262\346\212\244\346\263\250\346\204\217\350\246\201\351\242\206\357\274\232</span>\n                      <p className=\"text-[10px] leading-relaxed text-slate-650\">{activePlan.safetyNotes}</p>\n                    </div>\n                  </div>\n                </div>\n              </motion.div>\n            ) : (\n              workoutPlans.length > 0 && (\n                <div className=\"border border-dashed border-slate-200 rounded-lg p-4 text-center\">\n                  <p className=\"text-xs text-slate-500 mb-2\">\345\216\206\345\217\262\345\267\262\350\247\204\345\210\222 {workoutPlans.length} \345\240\202\350\256\255\347\273\203\350\256\241\345\210\222</p>\n                  <button\n                    onClick={() => setActivePlan(workoutPlans[workoutPlans.length - 1])}\n                    className=\"text-xs text-slate-700 font-bold hover:underline cursor-pointer\"\n                  >\n                    \350\275\275\345\205\245\346\234\200\350\277\221\347\224\237\346\210\220\347\232\204\350\256\276\350\256\241\n                  </button>\n                </div>\n              )\n            )}\n          </AnimatePresence>\n        </div>\n\n        {/* Right Hand: Workout Log & Records */}\n        <div className=\"lg:col-span-12 xl:col-span-5 space-y-6\">\n          {/* Add workout record manually */}\n          <div className=\"bg-white border border-slate-200/60 rounded-xl p-5 shadow-xs space-y-4\">\n            <h3 className=\"text-sm font-semibold text-slate-800 flex items-center gap-2 border-b border-slate-50 pb-2\">\n              <Plus size={16} className=\"text-orange-600\" />\n              <span>\347\262\276\347\241\256\346\211\213\345\212\250\350\256\260\344\270\213\344\270\200\347\254\224</span>\n            </h3>\n\n            <form onSubmit={handleSubmitRecord} className=\"space-y-3.5\">\n              <div className=\"space-y-1\">\n                <label className=\"text-xs text-slate-500 font-medium\">\350\277\220\345\212\250\347\261\273\345\236\213</label>\n                <select\n                  value={type}\n                  onChange={(e) => setType(e.target.value)}\n                  className=\"w-full text-xs border border-slate-200 rounded-lg p-2.5 bg-white text-slate-750 focus:outline-none focus:ring-1 focus:ring-orange-500\"\n                >\n                  <option value=\"\346\234\211\346\260\247\350\267\221\346\255\245\">\346\234\211\346\260\247\350\267\221\346\255\245 \360\237\217\203</option>\n                  <option value=\"\345\261\205\345\256\266\350\207\252\351\207\215\345\201\245\350\272\253\">\345\261\205\345\256\266\345\201\245\350\272\253 / \346\240\270\345\277\203 \360\237\247\230</option>\n                  <option value=\"\345\212\233\351\207\217\345\231\250\346\242\260\351\230\273\345\212\233\350\256\255\347\273\203\">\345\212\233\351\207\217\345\231\250\346\242\260\350\256\255\347\273\203 \360\237\217\213\357\270\217</option>\n                  <option value=\"\351\253\230\345\274\272\345\272\246\351\227\264\346\255\207 (HIIT)\">\351\253\230\345\274\272\345\272\246\351\227\264\346\255\207 HIIT \342\232\241</option>\n                  <option value=\"\346\270\270\346\263\263\350\256\255\347\273\203\">\346\270\270\346\263\263 \360\237\217\212</option>\n                  <option value=\"\345\277\253\350\265\260\346\210\226\345\215\225\350\275\246\">\351\252\221\350\241\214 / \346\210\267\345\244\226\345\201\245\346\255\245 \360\237\232\264</option>\n                  <option value=\"\347\276\275\346\257\233\347\220\203/\347\275\221\347\220\203/\347\257\256\347\220\203\347\255\211\">\347\220\203\347\261\273\350\277\220\345\212\250 \360\237\217\270</option>\n                </select>\n              </div>\n\n              <div className=\"grid grid-cols-2 gap-3\">\n                <div className=\"space-y-1\">\n                  <label className=\"text-xs text-slate-500 font-medium\">\346\227\266\351\225\277 (\345\210\206\351\222\237)</label>\n                  <input\n                    type=\"number\"\n                    min={1}\n                    required\n                    value={duration}\n                    onChange={(e) => {\n                      const d = Number(e.target.value);\n                      setDuration(d);\n                      setCalories(d * 8);\n                    }}\n                    className=\"w-full text-xs border border-slate-200 rounded-lg p-2 focus:ring-1 focus:ring-orange-500 focus:outline-none\"\n                  />\n                </div>\n                <div className=\"space-y-1\">\n                  <label className=\"text-xs text-slate-500 font-medium\">\347\207\203\347\203\247\347\203\255\351\207\217 (kcal)</label>\n                  <input\n                    type=\"number\"\n                    min={0}\n                    required\n                    value={calories}\n                    onChange={(e) => setCalories(Number(e.target.value))}\n                    className=\"w-full text-xs border border-slate-200 rounded-lg p-2 focus:ring-1 focus:ring-orange-500 focus:outline-none\"\n                  />\n                </div>\n              </div>\n\n              <div className=\"grid grid-cols-2 gap-3\">\n                <div className=\"space-y-1\">\n                  <label className=\"text-xs text-slate-500 font-medium\">\346\204\237\350\247\211\345\274\272\345\272\246</label>\n                  <div className=\"grid grid-cols-3 gap-1\">\n                    {([\"\344\275\216\", \"\344\270\255\", \"\351\253\230\"] as const).map((i) => (\n                      <button\n                        key={i}\n                        type=\"button\"\n                        onClick={() => setIntensity(i)}\n                        className={`py-1 rounded text-xs border text-center transition-all font-semibold cursor-pointer ${\n                          intensity === i\n                            ? \"bg-orange-50 border-orange-400 text-orange-700\"\n                            : \"border-slate-100 text-slate-500 hover:bg-slate-50\"\n                        }`}\n                      >\n                        {i}\n                      </button>\n                    ))}\n                  </div>\n                </div>\n                <div className=\"space-y-1\">\n                  <label className=\"text-xs text-slate-500 font-medium\">\350\277\220\345\212\250\346\227\245\346\234\237</label>\n                  <input\n                    type=\"date\"\n                    required\n                    value={date}\n                    max={new Date().toISOString().split(\"T\")[0]}\n                    onChange={(e) => setDate(e.target.value)}\n                    className=\"w-full text-[11px] border border-slate-200 rounded-lg p-1.5 focus:ring-1 focus:ring-orange-500 focus:outline-none\"\n                  />\n                </div>\n              </div>\n\n              <button\n                type=\"submit\"\n                className=\"w-full bg-slate-800 hover:bg-slate-900 text-white rounded-lg p-2 text-xs font-semibold shadow transition-all cursor-pointer\"\n              >\n                \346\217\220\346\212\245\350\277\220\345\212\250\346\227\245\345\277\227\n              </button>\n            </form>\n          </div>\n\n          {/* History list */}\n          <div className=\"bg-white border border-slate-200/60 rounded-xl p-5 shadow-xs space-y-4\">\n            <h3 className=\"text-sm font-semibold text-slate-800\">\345\216\206\345\217\262\351\224\273\347\202\274\346\227\245\345\277\227</h3>\n\n            {records.length === 0 ? (\n              <p className=\"text-xs text-slate-400 text-center py-4\">\350\277\230\346\262\241\346\234\211\344\273\273\344\275\225\350\256\255\347\273\203\347\227\225\350\277\271\343\200\202\345\245\275\350\272\253\344\275\223\346\235\245\350\207\252\347\202\271\346\273\264\347\247\257\347\264\257\357\274\201</p>\n            ) : (\n              <div className=\"divide-y divide-slate-100 max-h-64 overflow-y-auto pr-1\">\n                {records.map((rec) => (\n                  <div key={rec.id} className=\"py-2.5 flex items-start justify-between group\">\n                    <div className=\"space-y-0.5\">\n                      <div className=\"flex items-center gap-1.5\">\n                        <span className=\"text-xs font-bold text-slate-700\">{rec.type}</span>\n                        <span className=\"text-[9px] bg-slate-105 border border-slate-200 text-slate-600 px-1 py-0.2 rounded font-medium\">\n                          {rec.intensity}\345\274\272\345\272\246\n                        </span>\n                      </div>\n                      <p className=\"text-[11px] text-slate-500\">\n                        {rec.date} \302\267 \350\200\227\346\227\266 <span className=\"font-semibold text-slate-700\">{rec.duration}\345\210\206\351\222\237</span> \302\267 \346\266\210\350\200\227{\" \"}\n                        <span className=\"font-semibold text-orange-600\">{rec.calories} kcal</span>\n                      </p>\n                    </div>\n\n                    <button\n                      onClick={() => onDeleteRecord(rec.id)}\n                      className=\"text-slate-300 hover:text-rose-500 p-1 opacity-0 group-hover:opacity-100 focus:opacity-100 transition-opacity cursor-pointer\"\n                    >\n                      <Trash2 size={12} />\n                    </button>\n                  </div>\n                ))}\n              </div>\n            )}\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n}\n"
    }
