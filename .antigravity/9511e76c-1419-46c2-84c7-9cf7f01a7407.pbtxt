  file_change {
    absolute_path_uri: "file:///src/components/SleepSection.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \"react\";\nimport { SleepRecord } from \"../types\";\nimport { Moon, Sun, Plus, Trash2, Calendar, TrendingUp, Sparkles, Smile, CheckCircle } from \"lucide-react\";\nimport { motion, AnimatePresence } from \"motion/react\";\n\ninterface SleepSectionProps {\n  records: SleepRecord[];\n  onAddRecord: (record: SleepRecord) => void;\n  onDeleteRecord: (id: string) => void;\n}\n\nconst SLEEP_PRESETS = [\n  { label: \"\350\247\204\345\276\213\344\275\234\346\201\257 (8h)\", sleep: \"23:00\", wake: \"07:00\", quality: 5, note: \"\344\275\234\346\201\257\346\255\243\345\270\270\357\274\214\347\262\276\347\245\236\351\245\261\346\273\241\" },\n  { label: \"\346\227\251\350\265\267\346\231\250\350\241\214 (8h)\", sleep: \"22:00\", wake: \"06:00\", quality: 5, note: \"\346\227\251\347\235\241\346\227\251\350\265\267\357\274\214\346\225\210\347\216\207\351\253\230\" },\n  { label: \"\347\206\254\345\244\234\350\241\245\347\234\240 (7h)\", sleep: \"01:00\", wake: \"08:00\", quality: 3, note: \"\346\231\232\350\265\267\347\250\215\345\276\256\347\226\262\346\203\253\" },\n  { label: \"\345\215\210\351\227\264\345\205\205\347\224\265 (0.5h)\", sleep: \"13:00\", wake: \"13:30\", quality: 4, note: \"\345\215\210\351\227\264\345\260\217\346\206\251\357\274\214\344\270\213\345\215\210\345\205\203\346\260\224\346\273\241\346\273\241\" }\n];\n\nexport default function SleepSection({ records, onAddRecord, onDeleteRecord }: SleepSectionProps) {\n  const [sleepTime, setSleepTime] = useState(\"23:00\");\n  const [wakeTime, setWakeTime] = useState(\"07:00\");\n  const [quality, setQuality] = useState(4);\n  const [date, setDate] = useState(() => new Date().toISOString().split(\"T\")[0]);\n  const [note, setNote] = useState(\"\");\n  const [showSuccessBanner, setShowSuccessBanner] = useState(false);\n\n  const calculateDuration = (sleep: string, wake: string): number => {\n    const [sh, sm] = sleep.split(\":\").map(Number);\n    const [wh, wm] = wake.split(\":\").map(Number);\n    if (isNaN(sh) || isNaN(sm) || isNaN(wh) || isNaN(wm)) return 8;\n    const sleepMin = sh * 60 + sm;\n    const wakeMin = wh * 60 + wm;\n    let diff = wakeMin - sleepMin;\n    if (diff < 0) {\n      diff += 24 * 60; // spans across midnight\n    }\n    return parseFloat((diff / 60).toFixed(1));\n  };\n\n  const handleSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    const duration = calculateDuration(sleepTime, wakeTime);\n    const newRecord: SleepRecord = {\n      id: crypto.randomUUID(),\n      date,\n      sleepTime,\n      wakeTime,\n      duration,\n      quality,\n      note: note.trim() || undefined,\n    };\n    onAddRecord(newRecord);\n    setNote(\"\");\n    triggerSuccess();\n  };\n\n  const handleApplyPreset = (preset: typeof SLEEP_PRESETS[0]) => {\n    const duration = calculateDuration(preset.sleep, preset.wake);\n    const newRecord: SleepRecord = {\n      id: crypto.randomUUID(),\n      date: new Date().toISOString().split(\"T\")[0],\n      sleepTime: preset.sleep,\n      wakeTime: preset.wake,\n      duration,\n      quality: preset.quality,\n      note: preset.note,\n    };\n    onAddRecord(newRecord);\n    triggerSuccess();\n  };\n\n  const triggerSuccess = () => {\n    setShowSuccessBanner(true);\n    setTimeout(() => setShowSuccessBanner(false), 3000);\n  };\n\n  // Get statistics\n  const recentRecords = [...records]\n    .sort((a, b) => new Date(a.date).getTime() - new Date(b.date).getTime())\n    .slice(-7); // Last 7 days chronologically\n\n  const averageDuration = records.length > 0\n    ? parseFloat((records.reduce((sum, r) => sum + r.duration, 0) / records.length).toFixed(1))\n    : 0;\n\n  const averageQuality = records.length > 0\n    ? parseFloat((records.reduce((sum, r) => sum + r.quality, 0) / records.length).toFixed(1))\n    : 0;\n\n  // Sleep status advice\n  const getSleepAdvice = () => {\n    if (records.length === 0) {\n       return \"\350\256\260\345\275\225\344\270\213\344\273\212\346\227\251\350\265\267\345\272\212\345\220\216\347\232\204\344\275\234\346\201\257\345\220\247\357\274\201\345\277\253\346\215\267\346\211\223\345\215\241\350\203\275\345\244\247\345\271\205\351\231\215\344\275\216\347\273\237\350\256\241\351\227\250\346\247\233\343\200\202\";\n    }\n    const last = records[0]; \n    if (last.duration < 6) {\n      return \"\346\230\250\346\231\232\347\235\241\347\234\240\344\270\215\350\266\263 6 \345\260\217\346\227\266\343\200\202\346\267\261\345\272\246\347\235\241\347\234\240\345\257\271\346\201\242\345\244\215\344\275\223\345\212\233\346\236\201\344\270\272\351\207\215\350\246\201\357\274\214\345\273\272\350\256\256\344\273\212\346\231\232\346\227\251\347\202\271\347\235\241\344\273\245\350\241\245\345\205\205\345\202\250\350\203\275\343\200\202\";\n    }\n    if (last.duration > 9) {\n      return \"\346\230\250\346\231\232\347\235\241\347\234\240\347\225\245\351\225\277\357\274\210\350\266\205\350\277\207 9 \345\260\217\346\227\266\357\274\211\357\274\214\346\263\250\346\204\217\345\215\210\347\235\241\344\270\215\350\246\201\350\266\205\346\227\266\357\274\214\345\244\232\346\216\245\350\247\246\346\210\267\345\244\226\350\207\252\347\204\266\345\205\211\343\200\202\";\n    }\n    if (last.quality <= 3) {\n      return \"\346\230\250\346\231\232\347\235\241\345\276\227\344\270\200\350\210\254\343\200\202\347\235\241\345\211\215\345\217\257\344\273\245\345\274\200\345\220\257\351\230\262\350\223\235\345\205\211\343\200\201\345\201\232\345\201\232\346\267\261\345\221\274\345\220\270\350\260\203\346\225\264\346\235\276\345\274\233\346\204\237\357\274\214\350\203\275\346\230\276\350\221\227\346\224\271\345\226\204\346\267\261\345\261\202\350\264\250\351\207\217\343\200\202\";\n    }\n    return \"\344\275\234\346\201\257\350\211\257\345\245\275\357\274\201\345\207\206\346\227\266\345\205\245\347\235\241\346\230\257\347\224\237\347\211\251\351\222\237\347\232\204\346\234\200\345\244\247\350\211\257\350\215\257\357\274\214\347\273\247\347\273\255\344\277\235\346\214\201\357\274\214\350\207\252\345\276\213\350\207\252\347\224\261\343\200\202\";\n  };\n\n  return (\n    <div className=\"space-y-6\">\n      {/* Header - Charcoal Slate */}\n      <div className=\"bg-slate-900 border border-slate-800 rounded-2xl p-6 text-white relative overflow-hidden\">\n        <div className=\"absolute right-0 top-0 translate-x-4 -translate-y-4 text-emerald-500/10 pointer-events-none\">\n          <Moon size={160} />\n        </div>\n        <div className=\"relative z-10 space-y-2\">\n          <div className=\"flex items-center gap-2 text-emerald-400 font-medium text-sm\">\n            <Sparkles size={16} />\n            <span>\350\247\204\345\276\213\344\275\234\346\201\257 \302\267 \346\201\242\345\244\215\345\205\203\346\260\224</span>\n          </div>\n          <h2 className=\"text-2xl font-bold tracking-tight\">\347\235\241\347\234\240\344\275\234\346\201\257\350\256\260\345\275\225</h2>\n          <p className=\"text-slate-400 text-xs max-w-sm leading-relaxed\">\n            \342\200\234\345\205\205\350\266\263\345\245\275\347\234\240\346\230\257\346\234\200\351\253\230\347\272\247\347\232\204\350\207\252\345\276\213\343\200\202\342\200\235 \346\236\201\347\256\200\346\211\223\345\215\241\350\256\251\344\275\240\345\234\250 1 \347\247\222\351\222\237\345\206\205\350\275\273\346\235\276\345\220\214\346\255\245\346\230\274\345\244\234\347\262\276\345\212\233\350\212\202\345\276\213\343\200\202\n          </p>\n        </div>\n      </div>\n\n      {/* Success Banner */}\n      <AnimatePresence>\n        {showSuccessBanner && (\n          <motion.div\n            initial={{ opacity: 0, y: -10 }}\n            animate={{ opacity: 1, y: 0 }}\n            exit={{ opacity: 0, y: -10 }}\n            className=\"bg-emerald-50 border border-emerald-200 text-emerald-800 p-3 rounded-lg text-xs flex items-center gap-2\"\n          >\n            <CheckCircle size={14} className=\"text-emerald-600\" />\n            <span>\346\211\223\345\215\241\346\210\220\345\212\237\357\274\201\344\275\234\346\201\257\350\256\260\345\275\225\345\267\262\350\256\241\345\205\245\344\273\212\346\227\245\350\207\252\345\276\213\346\270\205\345\215\225\343\200\202</span>\n          </motion.div>\n        )}\n      </AnimatePresence>\n\n      {/* Simplified Instant Preservation Presets */}\n      <div className=\"bg-white border border-slate-200/60 rounded-xl p-5 shadow-xs space-y-3\">\n        <div className=\"flex items-center justify-between\">\n          <h3 className=\"text-sm font-semibold text-slate-800 flex items-center gap-1.5\">\n            <span className=\"text-emerald-600\">\342\232\241</span>\n            <span>\344\270\200\351\224\256\345\277\253\346\215\267\347\231\273\350\256\260 (\344\270\215\347\272\240\347\273\223\346\236\201\351\200\237\346\211\223\345\215\241)</span>\n          </h3>\n          <span className=\"text-[10px] text-slate-400\">\347\202\271\345\207\273\347\233\264\346\216\245\345\255\230\345\205\245</span>\n        </div>\n        <div className=\"grid grid-cols-2 gap-2 sm:grid-cols-4\">\n          {SLEEP_PRESETS.map((preset) => (\n            <button\n              key={preset.label}\n              onClick={() => handleApplyPreset(preset)}\n              className=\"py-2.5 px-2 bg-slate-50 hover:bg-slate-100 border border-slate-200/80 rounded-lg text-center transition-all cursor-pointer active:scale-98\"\n            >\n              <div className=\"text-xs font-semibold text-slate-700 truncate\">{preset.label}</div>\n              <div className=\"text-[9px] text-slate-400 mt-0.5 font-mono\">\n                {preset.sleep} - {preset.wake}\n              </div>\n            </button>\n          ))}\n        </div>\n      </div>\n\n      {/* Stats Summary Cards */}\n      <div className=\"grid grid-cols-2 gap-4\">\n        <div className=\"bg-white border border-slate-200/60 rounded-xl p-4 shadow-xs relative overflow-hidden\">\n          <div className=\"absolute top-2 right-2 text-slate-500/10 bg-slate-50 p-2 rounded-lg\">\n            <Moon size={18} className=\"text-slate-650\" />\n          </div>\n          <p className=\"text-xs text-slate-500 font-medium\">\345\271\263\345\235\207\347\235\241\347\234\240\346\227\266\351\225\277</p>\n          <div className=\"mt-2 flex items-baseline gap-1\">\n            <span className=\"text-2xl font-bold text-slate-900\">{averageDuration}</span>\n            <span className=\"text-xs text-slate-500\">\345\260\217\346\227\266</span>\n          </div>\n          <p className=\"text-[10px] text-slate-400 mt-1\">\346\216\250\350\215\220\350\214\203\345\233\264\357\274\2327.0 - 8.5 \345\260\217\346\227\266</p>\n        </div>\n\n        <div className=\"bg-white border border-slate-200/60 rounded-xl p-4 shadow-xs relative overflow-hidden\">\n          <div className=\"absolute top-2 right-2 text-emerald-500/10 bg-emerald-50 p-2 rounded-lg\">\n            <Smile size={18} className=\"text-emerald-600\" />\n          </div>\n          <p className=\"text-xs text-slate-500 font-medium\">\345\271\263\345\235\207\347\235\241\347\234\240\350\264\250\351\207\217</p>\n          <div className=\"mt-2 flex items-baseline gap-1\">\n            <span className=\"text-2xl font-bold text-slate-900\">{averageQuality}</span>\n            <span className=\"text-xs text-slate-500\">\345\210\206</span>\n          </div>\n          <p className=\"text-[10px] text-slate-400 mt-1\">5\346\230\237\350\257\204\344\274\260\346\240\207\345\207\206</p>\n        </div>\n      </div>\n\n      {/* Visual Chart - Last 7 entries */}\n      <div className=\"bg-white border border-slate-200/60 rounded-xl p-5 shadow-xs space-y-4\">\n        <div className=\"flex items-center justify-between\">\n          <h3 className=\"text-sm font-semibold text-slate-800 flex items-center gap-2\">\n            <TrendingUp size={16} className=\"text-slate-600\" />\n            <span>\350\277\221 7 \346\254\241\347\235\241\347\234\240\350\266\213\345\212\277</span>\n          </h3>\n          <span className=\"text-xs text-slate-500\">\345\215\225\344\275\215\357\274\232\345\260\217\346\227\266</span>\n        </div>\n\n        {recentRecords.length === 0 ? (\n          <div className=\"h-32 flex flex-col items-center justify-center text-slate-400 bg-slate-50/50 rounded-lg\">\n            <Calendar size={24} className=\"mb-2 text-slate-300 animate-pulse\" />\n            <p className=\"text-xs\">\346\232\202\346\227\240\350\266\213\345\212\277\357\274\214\350\257\267\346\267\273\345\212\240\350\256\260\345\275\225\345\210\206\346\236\220</p>\n          </div>\n        ) : (\n          <div className=\"pt-2 h-40 flex items-end justify-between px-2 border-b border-slate-100 relative\">\n            {/* Guide lines */}\n            <div className=\"absolute left-0 right-0 top-1/4 border-t border-dashed border-slate-100 pointer-events-none\"></div>\n            <div className=\"absolute left-0 right-0 top-2/4 border-t border-dashed border-slate-100 pointer-events-none\"></div>\n            <div className=\"absolute left-0 right-0 top-3/4 border-t border-dashed border-slate-100 pointer-events-none\"></div>\n\n            {recentRecords.map((r) => {\n              const heightPercent = Math.min(100, (r.duration / 12) * 100); // Max 12h representation\n              return (\n                <div key={r.id} className=\"flex flex-col items-center flex-1 group z-10\">\n                  <span className=\"text-[10px] font-bold text-slate-700 opacity-0 group-hover:opacity-100 transition-opacity mb-1\">\n                    {r.duration}h\n                  </span>\n                  <div\n                    style={{ height: `${heightPercent}%` }}\n                    className=\"w-4 sm:w-6 bg-slate-700 hover:bg-slate-800 rounded-t transition-all duration-300 relative\"\n                  >\n                    {/* Tooltip on hover */}\n                    <div className=\"absolute bottom-full left-1/2 -translate-x-1/2 bg-slate-900 text-white text-[10px] rounded py-1 px-2 pointer-events-none opacity-0 group-hover:opacity-100 transition-opacity whitespace-nowrap z-50 shadow mb-1\">\n                      <div>\345\205\245\347\235\241: {r.sleepTime}</div>\n                      <div>\351\206\222\346\235\245: {r.wakeTime}</div>\n                      <div>\350\264\250\351\207\217: {r.quality}\342\255\220</div>\n                    </div>\n                  </div>\n                  <span className=\"text-[9px] text-slate-400 mt-2 truncate max-w-[40px]\">\n                    {r.date.substring(5)}\n                  </span>\n                </div>\n              );\n            })}\n          </div>\n        )}\n      </div>\n\n      {/* AI Sleep Coach Section */}\n      <div className=\"bg-slate-100 border border-slate-200 rounded-xl p-4 flex gap-3 text-slate-900\">\n        <div className=\"p-2 bg-slate-200/50 rounded-lg shrink-0 h-9 w-9 flex items-center justify-center\">\n          <Sparkles size={18} className=\"text-slate-700\" />\n        </div>\n        <div className=\"space-y-1\">\n          <h4 className=\"text-xs font-semibold text-slate-800\">\345\215\223\350\266\212\345\245\275\347\234\240 AI \350\207\252\345\276\213\347\256\241\345\256\266\347\202\271\350\257\204</h4>\n          <p className=\"text-xs leading-relaxed text-slate-600\">{getSleepAdvice()}</p>\n        </div>\n      </div>\n\n      {/* Log Form */}\n      <div className=\"bg-white border border-slate-200/60 rounded-xl p-5 shadow-xs space-y-4\">\n        <h3 className=\"text-sm font-semibold text-slate-800 flex items-center gap-2\">\n          <Plus size={16} className=\"text-slate-700\" />\n          <span>\344\274\240\347\273\237\347\262\276\347\241\256\346\211\213\345\212\250\350\256\260\345\275\225</span>\n        </h3>\n\n        <form onSubmit={handleSubmit} className=\"space-y-4\">\n          <div className=\"grid grid-cols-2 gap-4\">\n            <div className=\"space-y-1\">\n              <label className=\"text-xs text-slate-500 flex items-center gap-1.5 font-medium\">\n                <Moon size={12} className=\"text-slate-400\" />\n                <span>\345\205\245\347\235\241\346\227\266\351\227\264</span>\n              </label>\n              <input\n                type=\"time\"\n                value={sleepTime}\n                onChange={(e) => setSleepTime(e.target.value)}\n                required\n                className=\"w-full text-sm border border-slate-200 rounded-lg p-2.5 text-center focus:ring-1 focus:ring-slate-500 focus:outline-none\"\n              />\n            </div>\n            <div className=\"space-y-1\">\n              <label className=\"text-xs text-slate-500 flex items-center gap-1.5 font-medium\">\n                <Sun size={12} className=\"text-slate-400\" />\n                <span>\350\265\267\345\272\212\346\227\266\351\227\264</span>\n              </label>\n              <input\n                type=\"time\"\n                value={wakeTime}\n                onChange={(e) => setWakeTime(e.target.value)}\n                required\n                className=\"w-full text-sm border border-slate-200 rounded-lg p-2.5 text-center focus:ring-1 focus:ring-slate-500 focus:outline-none\"\n              />\n            </div>\n          </div>\n\n          <div className=\"grid grid-cols-2 gap-4\">\n            <div className=\"space-y-1\">\n              <label className=\"text-xs text-slate-500 flex items-center gap-1 font-medium\">\n                <Calendar size={12} />\n                <span>\347\235\241\347\234\240\346\227\245\346\234\237</span>\n              </label>\n              <input\n                type=\"date\"\n                value={date}\n                max={new Date().toISOString().split(\"T\")[0]}\n                onChange={(e) => setDate(e.target.value)}\n                required\n                className=\"w-full text-xs border border-slate-200 rounded-lg p-2 focus:ring-1 focus:ring-slate-500 focus:outline-none\"\n              />\n            </div>\n            <div className=\"space-y-1\">\n              <label className=\"text-xs text-slate-500 font-medium\">\347\235\241\347\234\240\350\264\250\351\207\217 ({quality}\346\230\237)</label>\n              <div className=\"flex gap-1.5 pt-2\">\n                {[1, 2, 3, 4, 5].map((star) => (\n                  <button\n                    key={star}\n                    type=\"button\"\n                    onClick={() => setQuality(star)}\n                    className={`text-base focus:outline-none focus:scale-110 active:scale-90 transition-transform ${\n                      quality >= star ? \"text-amber-500\" : \"text-slate-200\"\n                    }`}\n                  >\n                    \342\230\205\n                  </button>\n                ))}\n              </div>\n            </div>\n          </div>\n\n          <div className=\"space-y-1\">\n            <label className=\"text-xs text-slate-500 font-medium\">\345\244\207\345\277\230\345\217\212\346\204\237\345\217\227 (\351\200\211\345\241\253)</label>\n            <input\n              type=\"text\"\n              placeholder=\"\344\276\213\345\246\202\357\274\232\347\250\215\345\276\256\346\234\211\347\202\271\351\206\222\343\200\201\346\242\246\351\207\214\345\276\210\347\262\276\345\275\251...\"\n              value={note}\n              onChange={(e) => setNote(e.target.value)}\n              className=\"w-full text-xs border border-slate-200 rounded-lg p-2.5 focus:ring-1 focus:ring-slate-500 focus:outline-none\"\n            />\n          </div>\n\n          <button\n            type=\"submit\"\n            className=\"w-full bg-slate-800 hover:bg-slate-900 text-white rounded-lg p-2.5 text-xs font-semibold shadow hover:shadow-md transition-all active:scale-[0.99] cursor-pointer\"\n          >\n            \346\267\273\345\212\240\350\256\260\345\275\225\n          </button>\n        </form>\n      </div>\n\n      {/* History log */}\n      <div className=\"bg-white border border-slate-200/60 rounded-xl p-5 shadow-xs space-y-4\">\n        <h3 className=\"text-sm font-semibold text-slate-800\">\345\216\206\345\217\262\347\235\241\347\234\240\350\256\260\345\275\225\346\270\205\345\215\225</h3>\n\n        {records.length === 0 ? (\n          <p className=\"text-xs text-slate-400 text-center py-2\">\346\232\202\346\227\240\344\275\234\346\201\257\350\256\260\345\275\225\357\274\214\345\234\250\344\270\212\346\226\271\345\242\236\345\212\240\346\202\250\347\232\204\344\270\200\346\227\245\344\275\234\346\201\257\350\256\260\345\275\225\345\220\247\343\200\202</p>\n        ) : (\n          <div className=\"divide-y divide-slate-100 max-h-72 overflow-y-auto pr-1\">\n            <AnimatePresence initial={false}>\n              {records.map((r) => (\n                <motion.div\n                  key={r.id}\n                  initial={{ opacity: 0, y: 10 }}\n                  animate={{ opacity: 1, y: 0 }}\n                  exit={{ opacity: 0, x: -20 }}\n                  className=\"py-3 flex items-start justify-between group text-xs\"\n                >\n                  <div className=\"space-y-1\">\n                    <div className=\"flex items-center gap-2\">\n                      <span className=\"text-xs font-semibold text-slate-700\">{r.date}</span>\n                      <span className=\"text-[10px] bg-slate-100 border border-slate-200/80 text-slate-600 py-0.5 px-2 rounded-full font-medium\">\n                        \346\227\266\351\225\277: {r.duration}h\n                      </span>\n                      <span className=\"text-xs text-amber-500\">{\"\342\230\205\".repeat(r.quality)}</span>\n                    </div>\n                    <p className=\"text-slate-500\">\n                      \344\275\234\346\201\257: <span className=\"font-medium text-slate-650\">{r.sleepTime}</span> \350\207\263{\" \"}\n                      <span className=\"font-medium text-slate-650\">{r.wakeTime}</span>\n                    </p>\n                    {r.note && <p className=\"text-[11px] text-slate-400 italic\">\342\200\234 {r.note} \342\200\235</p>}\n                  </div>\n\n                  <button\n                    onClick={() => onDeleteRecord(r.id)}\n                    className=\"p-1 px-1.5 opacity-0 group-hover:opacity-100 text-slate-400 hover:text-rose-500 rounded-lg transition-all focus:opacity-100 cursor-pointer\"\n                    title=\"\345\210\240\351\231\244\"\n                  >\n                    <Trash2 size={13} />\n                  </button>\n                </motion.div>\n              ))}\n            </AnimatePresence>\n          </div>\n        )}\n      </div>\n    </div>\n  );\n}\n"
    }
