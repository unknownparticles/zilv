  file_change {
    absolute_path_uri: "file:///server.ts"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import express from \"express\";\nimport path from \"path\";\nimport { createServer as createViteServer } from \"vite\";\nimport { GoogleGenAI, Type } from \"@google/genai\";\nimport dotenv from \"dotenv\";\n\ndotenv.config();\n\nconst app = express();\nconst PORT = 3000;\n\napp.use(express.json());\n\n// Initialize Gemini Client\nconst ai = new GoogleGenAI({\n  apiKey: process.env.GEMINI_API_KEY,\n  httpOptions: {\n    headers: {\n      \"User-Agent\": \"aistudio-build\",\n    },\n  },\n});\n\n// Helper for sending prompt and getting JSON response\nasync function getGeminiJSON(prompt: string, schema: any) {\n  try {\n    const response = await ai.models.generateContent({\n      model: \"gemini-3.5-flash\",\n      contents: prompt,\n      config: {\n        responseMimeType: \"application/json\",\n        responseSchema: schema,\n        systemInstruction: \"You are an expert self-discipline and lifestyle coach. Answer in Chinese (\347\256\200\344\275\223\344\270\255\346\226\207). Design inspiring, practical, and highly realistic habits and goals.\",\n      },\n    });\n\n    const text = response.text || \"{}\";\n    return JSON.parse(text);\n  } catch (error: any) {\n    console.error(\"Gemini API Error:\", error);\n    throw error;\n  }\n}\n\n// 1. Diet advice endpoint\napp.post(\"/api/diet-advice\", async (req, res) => {\n  const { meals } = req.body;\n  if (!meals || !Array.isArray(meals) || meals.length === 0) {\n    return res.status(400).json({ error: \"Missing or invalid meals list\" });\n  }\n\n  const mealSummary = meals\n    .map((m) => `[\346\227\266\346\256\265: ${m.period}, \351\243\237\347\211\251: ${m.text}, \345\244\207\346\263\250: ${m.note || \"\346\227\240\"}]`)\n    .join(\"\\n\");\n\n  const prompt = `\345\210\206\346\236\220\344\273\245\344\270\213\346\210\221\344\273\212\345\244\251\346\221\204\345\205\245\347\232\204\351\245\256\351\243\237\357\274\214\344\274\260\347\256\227\347\203\255\351\207\217\343\200\201\347\242\263\346\260\264\343\200\201\350\233\213\347\231\275\350\264\250\343\200\201\350\204\202\350\202\252\357\274\214\347\273\231\345\207\272\345\201\245\345\272\267\350\257\204\345\210\206(0-100)\357\274\214\345\271\266\347\273\231\345\207\272\344\270\252\346\200\247\345\214\226\347\232\204\351\245\256\351\243\237\345\273\272\350\256\256\343\200\202\n\345\267\262\346\221\204\345\205\245\347\232\204\351\244\220\351\245\256\357\274\232\n${mealSummary}`;\n\n  const schema = {\n    type: Type.OBJECT,\n    properties: {\n      calories: { type: Type.INTEGER, description: \"\344\273\212\346\227\245\344\274\260\347\256\227\346\200\273\347\203\255\351\207\217(kcal)\" },\n      carb: { type: Type.STRING, description: \"\347\242\263\346\260\264\345\214\226\345\220\210\347\211\251\344\274\260\347\256\227\357\274\214\344\276\213\345\246\202\357\274\232150g\" },\n      protein: { type: Type.STRING, description: \"\350\233\213\347\231\275\350\264\250\344\274\260\347\256\227\357\274\214\344\276\213\345\246\202\357\274\23275g\" },\n      fat: { type: Type.STRING, description: \"\350\204\202\350\202\252\344\274\260\347\256\227\357\274\214\344\276\213\345\246\202\357\274\23250g\" },\n      score: { type: Type.INTEGER, description: \"\345\201\245\345\272\267\345\272\246\350\257\204\345\210\206 (0\350\207\263100\347\247\257\345\210\206)\" },\n      analysis: { type: Type.STRING, description: \"\344\273\212\346\227\245\350\206\263\351\243\237\347\232\204\345\205\250\351\235\242\350\220\245\345\205\273\347\202\271\350\257\204\357\274\214\345\214\205\346\213\254\345\245\275\347\232\204\344\270\200\351\235\242\345\222\214\344\270\215\350\266\263\347\232\204\344\270\200\351\235\242\" },\n      advice: { type: Type.STRING, description: \"\346\234\252\346\235\245\347\232\204\345\205\267\344\275\223\346\224\271\345\226\204\345\273\272\350\256\256\357\274\210\345\246\202\344\275\225\350\260\203\346\225\264\344\270\273\351\243\237\343\200\201\350\224\254\350\217\234\343\200\201\350\202\211\347\261\273\347\255\211\357\274\211\" },\n    },\n    required: [\"calories\", \"carb\", \"protein\", \"fat\", \"score\", \"analysis\", \"advice\"],\n  };\n\n  try {\n    const result = await getGeminiJSON(prompt, schema);\n    res.json(result);\n  } catch (error: any) {\n    res.status(500).json({ error: \"\350\216\267\345\217\226\351\245\256\351\243\237\345\210\206\346\236\220\345\244\261\350\264\245\357\274\232\" + error.message });\n  }\n});\n\n// 2. Workout generation endpoint\napp.post(\"/api/workout-plan\", async (req, res) => {\n  const { target, level, durationMinutes, gender, age } = req.body;\n\n  const prompt = `\344\270\272\344\270\200\344\275\215\345\201\245\350\272\253\347\233\256\346\240\207\346\230\257 [${target || \"\345\207\217\350\204\202\346\216\247\351\207\215\"}]\357\274\214\350\277\220\345\212\250\345\237\272\347\241\200\346\230\257 [${level || \"\345\210\235\345\255\246\350\200\205\"}]\357\274\214\351\242\204\350\256\241\350\256\255\347\273\203\346\227\266\351\225\277\346\230\257 [${durationMinutes || 30}\345\210\206\351\222\237] \347\232\204\347\224\250\346\210\267\357\274\210\346\200\247\345\210\253\357\274\232${gender || \"\346\234\252\346\214\207\345\256\232\"}\357\274\214\345\271\264\351\276\204\357\274\232${age || \"25\"}\357\274\211\357\274\214\350\256\276\350\256\241\344\270\200\344\270\252\351\253\230\346\225\210\345\256\211\345\205\250\347\232\204\344\270\252\346\200\247\345\214\226\345\215\225\346\254\241\350\256\255\347\273\203\350\256\241\345\210\222\343\200\202\350\257\267\345\214\205\345\220\253\347\203\255\350\272\253\343\200\201\346\255\243\345\274\217\351\203\250\345\210\206\343\200\201\346\213\211\344\274\270\346\224\276\346\235\276\357\274\214\345\271\266\346\240\207\346\263\250\345\205\267\344\275\223\345\212\250\344\275\234\344\270\216\345\256\211\345\205\250\350\246\201\347\202\271\343\200\202`;\n\n  const schema = {\n    type: Type.OBJECT,\n    properties: {\n      target: { type: Type.STRING },\n      totalDuration: { type: Type.STRING, description: \"\346\200\273\351\242\204\347\256\227\346\227\266\351\227\264\357\274\214\344\276\213\345\246\202: 40\345\210\206\351\222\237\" },\n      warmup: { type: Type.STRING, description: \"\347\203\255\350\272\253\345\212\250\344\275\234\344\270\216\345\273\272\350\256\256\" },\n      mainExercises: {\n        type: Type.ARRAY,\n        items: {\n          type: Type.OBJECT,\n          properties: {\n            name: { type: Type.STRING, description: \"\350\277\220\345\212\250\345\212\250\344\275\234\345\220\215\347\247\260\" },\n            sets: { type: Type.STRING, description: \"\347\273\204\346\225\260\357\274\214\346\254\241\346\225\260/\346\257\217\347\273\204\357\274\214\346\210\226\346\214\201\347\273\255\346\227\266\351\227\264\357\274\214\344\276\213\345\246\202: 3\347\273\204 x 15\346\254\241\" },\n            rest: { type: Type.STRING, description: \"\347\273\204\351\227\264\344\274\221\346\201\257\346\227\266\351\227\264\357\274\214\344\276\213\345\246\202: 60\347\247\222\" },\n            description: { type: Type.STRING, description: \"\345\212\250\344\275\234\347\256\200\350\277\260\345\222\214\347\273\206\350\212\202\350\246\201\347\202\271\" },\n          },\n          required: [\"name\", \"sets\", \"rest\", \"description\"],\n        },\n        description: \"\346\255\243\345\274\217\350\277\220\345\212\250\345\210\227\350\241\250\",\n      },\n      cooldown: { type: Type.STRING, description: \"\346\213\211\344\274\270\344\270\216\346\225\264\347\220\206\350\277\220\345\212\250\346\214\207\345\257\274\" },\n      safetyNotes: { type: Type.STRING, description: \"\344\270\252\346\200\247\345\214\226\350\277\220\345\212\250\351\230\262\344\274\244\344\270\216\345\221\274\345\220\270\343\200\201\345\247\277\346\200\201\345\256\211\345\205\250\345\273\272\350\256\256\" },\n    },\n    required: [\"target\", \"totalDuration\", \"warmup\", \"mainExercises\", \"cooldown\", \"safetyNotes\"],\n  };\n\n  try {\n    const result = await getGeminiJSON(prompt, schema);\n    res.json(result);\n  } catch (error: any) {\n    res.status(500).json({ error: \"\347\224\237\346\210\220\350\277\220\345\212\250\350\256\241\345\210\222\345\244\261\350\264\245\357\274\232\" + error.message });\n  }\n});\n\n// 3. Random interest-based skill challenge endpoint\napp.post(\"/api/skill-challenge\", async (req, res) => {\n  const { interests, completedChallenges } = req.body;\n\n  const interestStr = interests && interests.length > 0 ? interests.join(\"\343\200\201\") : \"\344\273\273\346\204\217\347\224\237\346\264\273\343\200\201\350\266\243\345\221\263\346\210\226\350\256\244\347\237\245\346\212\200\350\203\275\";\n  const completedStr = completedChallenges && completedChallenges.length > 0 ? `\351\201\277\345\205\215\346\216\250\350\215\220\344\273\245\344\270\213\345\267\262\345\256\214\346\210\220\347\232\204\346\214\221\346\210\230\357\274\232${completedChallenges.map((c: any) => c.title).join(\"\343\200\201\")}` : \"\";\n\n  const prompt = `\346\240\271\346\215\256\346\210\221\347\232\204\345\205\264\350\266\243\346\240\207\347\255\276 [${interestStr}]\357\274\214\351\232\217\346\234\272\346\216\250\350\215\220\344\270\200\344\270\252\351\200\202\345\220\210\345\234\250\344\273\212\345\244\251/\346\234\254\345\221\250\345\206\205\345\256\214\346\210\220\347\232\204\346\226\260\346\212\200\350\203\275\346\210\226\345\245\275\347\216\251\347\232\204\347\224\237\346\264\273\345\206\222\351\231\251\346\214\221\346\210\230\357\274\201\346\214\221\346\210\230\344\270\215\344\273\205\350\246\201\350\203\275\344\277\235\346\214\201\346\226\260\351\262\234\346\204\237\357\274\214\350\277\230\350\246\201\345\205\267\346\234\211\344\270\200\345\256\232\347\232\204\345\256\236\346\223\215\346\200\247\345\222\214\350\207\252\345\276\213\346\217\220\345\215\207\346\204\217\344\271\211\343\200\202\n${completedStr}`;\n\n  const schema = {\n    type: Type.OBJECT,\n    properties: {\n      title: { type: Type.STRING, description: \"\346\214\221\346\210\230\347\232\204\345\210\233\346\204\217\345\220\270\345\274\225\344\272\272\345\220\215\347\247\260\" },\n      category: { type: Type.STRING, description: \"\344\272\214\347\272\247\345\210\206\347\261\273\346\240\207\347\255\276\357\274\214\344\276\213\345\246\202\357\274\232\347\224\237\346\264\273\345\210\233\351\200\240\343\200\201\345\212\250\346\211\213\347\240\224\347\251\266\343\200\201\350\272\253\345\277\203\345\201\245\345\272\267\" },\n      estimatedTime: { type: Type.STRING, description: \"\351\242\204\350\256\241\345\256\214\346\210\220\350\200\227\346\227\266\" },\n      difficulty: { type: Type.STRING, description: \"\351\232\276\345\272\246\350\257\204\347\272\247 (\346\226\260\346\211\213/\350\277\233\351\230\266/\344\270\223\345\256\266)\" },\n      description: { type: Type.STRING, description: \"\347\256\200\347\237\255\345\213\276\345\213\222\350\277\231\346\230\257\344\270\200\344\270\252\346\200\216\346\240\267\347\232\204\346\214\221\346\210\230\357\274\214\345\270\246\346\235\245\344\272\206\344\273\200\344\271\210\346\204\217\344\271\211\" },\n      steps: {\n        type: Type.ARRAY,\n        items: { type: Type.STRING },\n        description: \"\346\230\216\347\241\256\345\205\267\344\275\223\347\232\204\350\276\276\346\210\220\346\214\207\345\215\227\346\255\245\351\252\244\",\n      },\n      rewardMindset: { type: Type.STRING, description: \"\345\256\214\346\210\220\345\220\216\347\232\204\346\224\266\350\216\267\357\274\210\344\270\272\344\273\200\344\271\210\345\200\274\345\276\227\344\270\200\350\257\225\357\274\214\345\237\271\345\205\273\344\272\206\344\275\225\347\247\215\350\207\252\345\276\213\346\210\226\350\256\244\347\237\245\357\274\211\" },\n    },\n    required: [\"title\", \"category\", \"estimatedTime\", \"difficulty\", \"description\", \"steps\", \"rewardMindset\"],\n  };\n\n  try {\n    const result = await getGeminiJSON(prompt, schema);\n    res.json(result);\n  } catch (error: an