-500 p-1 opacity-100 md:opacity-0 group-hover:opacity-100 focus:opacity-100 transition-opacity cursor-pointer\"\n                      >\n                        <Trash2 size={12} />\n                      </button>\n                    </div>\n\n                    <p className=\"text-xs text-slate-600 leading-relaxed bg-slate-50/50 p-2.5 rounded-lg border border-slate-200/60 my-1.5 whitespace-pre-line text-justify text-slate-650\">\n                      {card.notes}\n                    </p>\n\n                    <div className=\"flex items-center justify-between text-[10px] text-slate-400 font-mono mt-0.5\">\n                      <span>{card.date}</span>\n                      {card.pagesRead && card.totalPages && (\n                        <span>\n                          \350\277\233\345\272\246: {card.pagesRead} / {card.totalPages} \351\241\265 (\n                          {Math.round((card.pagesRead / card.totalPages) * 100)}%)\n                        </span>\n                      )}\n                    </div>\n                  </div>\n                ))}\n              </div>\n            )}\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n}\n"
