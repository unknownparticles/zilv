204\277\347\256\241\347\220\206\344\270\216\345\213\276\351\200\211\346\266\210\351\241\271\343\200\202\n   - **\351\206\222\347\233\256\346\217\220\351\206\222\346\234\272\345\210\266**\357\274\232\345\272\224\347\224\250\351\246\226\345\261\217\351\241\266\351\203\250\351\205\215\346\234\211\346\251\230\351\273\204\345\272\225\350\211\262\347\232\204**\350\207\252\345\276\213\350\252\223\350\250\200\350\255\246\347\244\272\346\240\217**\357\274\214\345\256\236\346\227\266\351\253\230\344\272\256\346\217\220\347\244\272\344\273\215\346\234\252\345\261\245\350\241\214\347\232\204\345\277\205\345\201\232\350\257\272\350\250\200\346\225\260\351\207\217\357\274\214\347\233\264\345\210\260\346\202\250\345\213\276\351\200\211\345\261\245\347\272\246\343\200\202\n\n4. **\360\237\222\276 \345\256\214\346\225\264\346\225\260\346\215\256\345\244\207\344\273\275\344\270\216\346\201\242\345\244\215 (\345\257\274\345\205\245/\345\257\274\345\207\272)**\357\274\232\n   - \345\257\274\350\210\252\346\240\217\345\217\263\344\270\212\350\247\222\346\226\260\345\242\236**\343\200\220\346\225\260\346\215\256\345\244\207\344\273\275\343\200\221\345\210\206\346\240\217**\343\200\202\n   - \346\224\257\346\214\201\344\270\200\351\224\256\345\257\274\345\207\272\345\271\266\350\277\201\345\207\272\345\214\205\345\220\253\346\211\200\346\234\211\346\227\266\351\227\264\350\275\250\350\256\260\345\275\225\343\200\201\351\245\256\351\243\237\345\233\276\350\260\261\343\200\201\344\271\240\346\203\257\350\252\223\350\250\200\345\234\250\345\206\205\347\232\204 **JSON \345\255\230\346\241\243\346\226\207\344\273\266**\343\200\202\n   - \346\217\220\344\276\233\345\256\211\345\205\250\347\232\204\347\224\250\346\210\267\347\272\247\346\226\207\344\273\266\350\257\273\345\217\226\345\231\250\357\274\214\351\232\217\346\227\266\345\234\250\346\226\260\350\256\276\345\244\207\343\200\201\346\226\260\346\265\217\350\247\210\345\231\250\344\270\212\351\241\272\347\225\205**\345\257\274\345\205\245\