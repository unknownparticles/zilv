      replacement_content: "import React, { useState, useEffect } from \"react\";\nimport {\n  SleepRecord,\n  MealItem,\n  WorkoutRecord,\n  StudyRecord,\n  MustDoTask,\n  UserSession,\n} from \"./types\";\nimport CheckInModal from \"./components/CheckInModal\";\nimport {\n  Moon,\n  Utensils,\n  Dumbbell,\n  BookOpen,\n  Award,\n  Smartphone,\n  User,\n  Settings,\n  Plus,\n  Trash2,\n  CheckCircle2,\n  CheckCircle,\n  Database,\n  ArrowDownToLine,\n  ArrowUpToLine,\n  LogOut,\n  RefreshCw,\n  Clock,\n  Heart,\n  Star,\n  Camera,\n  Shield,\n  Key,\n  Lock,\n  ListTodo,\n  Check,\n  Smartphone as Phone\n} from \"lucide-react\";\nimport { motion, AnimatePresence } from \"motion/react\";\n\nconst MOTTO_LIST = [\n  \"\350\207\252\345\276\213\344\270\215\346\230\257\346\235\237\347\274\232\357\274\214\350\200\214\346\230\257\351\200\232\345\276\200\350\207\252\347\224\261\345\224\257\344\270\200\347\232\204\350\267\257\345\276\204\343\200\202\",\n  \"\344\275\240\344\273\212\345\244\251\347\232\204\351\200\211\346\213\251\357\274\214\345\206\263\345\256\232\344\272\206\344\275\240\344\270\211\345\271\264\345\220\216\347\232\204\346\250\241\346\240\267\343\200\202\",\n  \"\344\270\215\347\247\257\350\267\254\346\255\245\357\274\214\346\227\240\344\273\245\350\207\263\345\215\203\351\207\214\357\274\233\344\270\215\347\247\257\345\260\217\346\265\201\357\274\214\346\227\240\344\273\245\346\210\220\346\261\237\346\265\267\343\200\202\",\n  \"\346\257\217\344\270\200\344\270\252\344\270\215\346\233\276\350\265\267\350\210\236\347\232\204\346\227\245\345\255\220\357\274\214\351\203\275\346\230\257\345\257\271\347\224\237\345\221\275\347\232\204\350\276\234\350\264\237\343\200\202\",\n  \"\346\216\247\345\210\266\350\207\252\346\210\221\357\274\214\346\226\271\350\203\275\346\211\247\345\255\246\346\216\214\346\217\241\347\224\237\345\221\275\347\232\204\345\271\277\350\247\222\345\260\272\345\272\246\343\200\202\",\n];\n\nconst DEFAULT_AVATARS = [\n  \"https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?auto=format&fit=crop&w=150&q=80\",\n  \"https://images.unsplash.com/photo-1494790108377-be9c29b29330?auto=format&fit=crop&w=150&q=80\",\n  \"https://images.unsplash.com/photo-1570295999919-56ceb5ecca61?auto=format&fit=crop&w=150&q=80\",\n  \"https://images.unsplash.com/photo-1438761681033-6461ffad8d80?auto=format&fit=crop&w=150&q=80\",\n  \"https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?auto=format&fit=crop&w=150&q=80\"\n];\n\nexport default function App() {\n  const [activeTab, setActiveTab] = useState<\"home\" | \"auth\" | \"settings\">(\"home\");\n  const [motto, setMotto] = useState(\"\");\n  const [isCheckInOpen, setIsCheckInOpen] = useState(false);\n  const [isAnalyzingImage, setIsAnalyzingImage] = useState(false);\n\n  // Synced states from local storage with unique namespace\n  const [sleepRecords, setSleepRecords] = useState<SleepRecord[]>(() => {\n    const raw = localStorage.getItem(\"min_sleep_records\");\n    return raw ? JSON.parse(raw) : [];\n  });\n\n  const [mealItems, setMealItems] = useState<MealItem[]>(() => {\n    const raw = localStorage.getItem(\"min_meal_items\");\n    return raw ? JSON.parse(raw) : [];\n  });\n\n  const [workoutRecords, setWorkoutRecords] = useState<WorkoutRecord[]>(() => {\n    const raw = localStorage.getItem(\"min_workout_records\");\n    return raw ? JSON.parse(raw) : [];\n  });\n\n  const [studyRecords, setStudyRecords] = useState<StudyRecord[]>(() => {\n    const raw = localStorage.getItem(\"min_study_records\");\n    return raw ? JSON.parse(raw) : [];\n  });\n\n  const [mustDoTasks, setMustDoTasks] = useState<MustDoTask[]>(() => {\n    const raw = localStorage.getItem(\"min_must_do_tasks\");\n    return raw ? JSON.parse(raw) : [\n      { id: \"1\", period: \"today\", text: \"\344\273\212\346\227\245\351\230\205\350\257\27320\345\210\206\351\222\237\346\210\226\344\270\223\346\263\250\345\201\232\346\200\273\347\273\223\", completed: false, createdAt: new Date().toISOString().split(\"T\")[0] },\n      { id: \"2\", period: \"week\", text: \"\346\234\254\345\221\250\350\207\263\345\260\221\350\277\233\350\241\214150\345\210\206\351\222\237\347\232\204\344\270\255\351\253\230\345\274\272\345\272\246\350\277\220\345\212\250\351\241\271\347\233\256\", completed: false, createdAt: new Date().toISOString().split(\"T\")[0] },\n      { id: \"3\", period: \"month\", text: \"\346\234\254\346\234\210\346\224\273\345\205\213\344\270\200\351\241\271\344\270\223\344\270\232\346\236\201\345\256\242\346\212\200\350\203\275\346\210\226\347\240\224\350\257\273\344\270\244\346\234\254\344\270\223\350\221\227\", completed: false, createdAt: new Date().toISOString().split(\"T\")[0] },\n    ];\n  });\n\n  // Current session config\n  const [session, setSession] = useState<UserSession>(() => {\n    const raw = localStorage.getItem(\"min_user_session\");\n    if (raw) return JSON.parse(raw);\n    return {\n      username: \"Guest\",\n      name: \"\350\207\252\345\276\213\344\277\256\350\241\214\346\227\205\345\256\242\",\n      id: \"SLF-2026-X88\",\n      avatarUrl: DEFAULT_AVATARS[0],\n      isLoggedIn: false,\n      apiProvider: \"Google AI Studio\",\n      apiKey: \"\",\n    };\n  });\n\n  // Task Inputs state\n  const [newTaskPeriod, setNewTaskPeriod] = useState<\"today\" | \"week\" | \"month\">(\"today\");\n  const [newTaskText, setNewTaskText] = useState(\"\");\n\n  // Auth Inputs\n  const [isLoginView, setIsLoginView] = useState(true);\n  const [authUsername, setAuthUsername] = useState(\"\");\n  const [authPassword, setAuthPassword] = useState(\"\");\n  const [authNickname, setAuthNickname] = useState(\"\");\n  const [authError, setAuthError] = useState(\"\");\n  const [authSuccess, setAuthSuccess] = useState(\"\");\n\n  // Syncing simulation animation state\n  const [isSyncing, setIsSyncing] = useState(false);\n  const [syncStatus, setSyncStatus] = useState<string | null>(null);\n\n  // Settings states\n  const [settingsName, setSettingsName] = useState(session.name);\n  const [settingsAvatar, setSettingsAvatar] = useState(session.avatarUrl);\n  const [settingsProvider, setSettingsProvider] = useState(session.apiProvider);\n  const [settingsKey, setSettingsKey] = useState(session.apiKey);\n  const [showKey, setShowKey] = useState(false);\n\n  // Update localStorage automatically\n  useEffect(() => {\n    localStorage.setItem(\"min_sleep_records\", JSON.stringify(sleepRecords));\n  }, [sleepRecords]);\n\n  useEffect(() => {\n    localStorage.setItem(\"min_meal_items\", JSON.stringify(mealItems));\n  }, [mealItems]);\n\n  useEffect(() => {\n    localStorage.setItem(\"min_workout_records\", JSON.stringify(workoutRecords));\n  }, [workoutRecords]);\n\n  useEffect(() => {\n    localStorage.setItem(\"min_study_records\", JSON.stringify(studyRecords));\n  }, [studyRecords]);\n\n  useEffect(() => {\n    localStorage.setItem(\"min_must_do_tasks\", JSON.stringify(mustDoTasks));\n  }, [mustDoTasks]);\n\n  useEffect(() => {\n    localStorage.setItem(\"min_user_session\", JSON.stringify(session));\n  }, [session]);\n\n  // Sync state settings fields when session updates\n  useEffect(() => {\n    setSettingsName(session.name);\n    setSettingsAvatar(session.avatarUrl);\n    setSettingsProvider(session.apiProvider);\n    setSettingsKey(session.apiKey);\n  }, [session]);\n\n  // Wisdom select\n  useEffect(() => {\n    const rand = MOTTO_LIST[Math.floor(Math.random() * MOTTO_LIST.length)];\n    setMotto(rand);\n  }, [activeTab]);\n\n  // Add items\n  const handleAddSleep = (rec: { sleepTime: string; wakeTime: string; quality: number; note: string }) => {\n    const todayStr = new Date().toISOString().split(\"T\")[0];\n    const duration = calculateDuration(rec.sleepTime, rec.wakeTime);\n    const newRecord: SleepRecord = {\n      id: crypto.randomUUID(),\n      date: todayStr,\n      sleepTime: rec.sleepTime,\n      wakeTime: rec.wakeTime,\n      duration,\n      quality: rec.quality,\n      note: rec.note,\n    };\n    setSleepRecords([newRecord, ...sleepRecords]);\n  };\n\n  const handleAddDiet = (rec: { period: string; text: string; note: string }) => {\n    const todayStr = new Date().toISOString().split(\"T\")[0];\n    const newMeal: MealItem = {\n      id: crypto.randomUUID(),\n      date: todayStr,\n      period: rec.period as any,\n      text: rec.text,\n      note: rec.note || undefined,\n    };\n    setMealItems([newMeal, ...mealItems]);\n  };\n\n  const handleAddWorkout = (rec: { type: string; duration: number }) => {\n    const todayStr = new Date().toISOString().split(\"T\")[0];\n    const newRecord: WorkoutRecord = {\n      id: crypto.randomUUID(),\n      date: todayStr,\n      type: rec.type,\n      duration: rec.duration,\n      calories: Math.round(rec.duration * 6.5), // ballpark\n      intensity: \"\344\270\255\",\n    };\n    setWorkoutRecords([newRecord, ...workoutRecords]);\n  };\n\n  const handleAddStudy = (rec: { content: string; duration: number }) => {\n    const todayStr = new Date().toISOString().split(\"T\")[0];\n    const newRecord: StudyRecord = {\n      id: crypto.randomUUID(),\n      date: todayStr,\n      content: rec.content,\n      duration: rec.duration,\n    };\n    setStudyRecords([newRecord, ...studyRecords]);\n  };\n\n  const calculateDuration = (sleep: string, wake: string): number => {\n    try {\n      const [sh, sm] = sleep.split(\":\").map(Number);\n      const [wh, wm] = wake.split(\":\").map(Number);\n      let diff = (wh * 60 + wm) - (sh * 60 + sm);\n      if (diff < 0) {\n        diff += 24 * 60; // next day\n      }\n      return Math.round((diff / 60) * 10) / 10;\n    } catch {\n      return 8;\n    }\n  };\n\n  // Must-do list toggle & delete\n  const handleAddTask = (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!newTaskText.trim()) return;\n\n    const newTask: MustDoTask = {\n      id: crypto.randomUUID(),\n      period: newTaskPeriod,\n      text: newTaskText.trim(),\n      completed: false,\n      createdAt: new Date().toISOString().split(\"T\")[0],\n    };\n\n    setMustDoTasks([...mustDoTasks, newTask]);\n    setNewTaskText(\"\");\n  };\n\n  const handleToggleTask = (id: string) => {\n    setMustDoTasks(\n      mustDoTasks.map((t) => (t.id === id ? { ...t, completed: !t.completed } : t))\n    );\n  };\n\n  const handleDeleteTask = (id: string) => {\n    setMustDoTasks(mustDoTasks.filter((t) => t.id !== id));\n  };\n\n  // Today progress indicator values\n  const getTodayCheckIns = () => {\n    const todayStr = new Date().toISOString().split(\"T\")[0];\n    const sleeps = sleepRecords.filter((s) => s.date === todayStr);\n    const meals = mealItems.filter((m) => m.date === todayStr);\n    const workouts = workoutRecords.filter((w) => w.date === todayStr);\n    const studies = studyRecords.filter((st) => st.date === todayStr);\n\n    return {\n      sleeps,\n      meals,\n      workouts,\n      studies,\n      totalCount: sleeps.length + meals.length + workouts.length + studies.length,\n    };\n  };\n\n  const todayStr = new Date().toISOString().split(\"T\")[0];\n  const activeCheckIns = getTodayCheckIns();\n\n  const totalIncomplete = mustDoTasks.filter((t) => !t.completed).length;\n  const incompleteToday = mustDoTasks.filter((t) => t.period === \"today\" && !t.completed).length;\n  const incompleteWeek = mustDoTasks.filter((t) => t.period === \"week\" && !t.completed).length;\n  const incompleteMonth = mustDoTasks.filter((t) => t.period === \"month\" && !t.completed).length;\n\n  // Authentication registration system simulator\n  const handleAuthSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    setAuthError(\"\");\n    setAuthSuccess(\"\");\n\n    if (!authUsername.trim() || !authPassword.trim()) {\n      setAuthError(\"\350\257\267\345\241\253\345\206\231\345\205\250\351\203\250\345\277\205\350\246\201\344\277\241\346\201\257\343\200\202\");\n      return;\n    }\n\n    const regUsersRaw = localStorage.getItem(\"min_registered_users\") || \"[]\";\n    const regUsers = JSON.parse(regUsersRaw);\n\n    if (isLoginView) {\n      // Find user\n      const found = regUsers.find((u: any) => u.username === authUsername && u.password === authPassword);\n      if (found) {\n        const fullSession: UserSession = {\n          username: found.username,\n          name: found.nickname || found.username,\n          id: found.id || `SLF-2026-${Math.floor(100+Math.random()*900)}`,\n          avatarUrl: found.avatar || DEFAULT_AVATARS[0],\n          isLoggedIn: true,\n          apiProvider: found.apiProvider || \"Google AI Studio\",\n          apiKey: found.apiKey || \"\",\n        };\n        setSession(fullSession);\n        \n        // Also retrieve their specific tasks & records if saved separately\n        if (found.sleepRecords) setSleepRecords(found.sleepRecords);\n        if (found.mealItems) setMealItems(found.mealItems);\n        if (found.workoutRecords) setWorkoutRecords(found.workoutRecords);\n        if (found.studyRecords) setStudyRecords(found.studyRecords);\n        if (found.mustDoTasks) setMustDoTasks(found.mustDoTasks);\n\n        setAuthSuccess(\"\360\237\216\211 \347\231\273\345\275\225\346\210\220\345\212\237\357\274\201\346\254\242\350\277\216\345\233\236\345\210\260\350\207\252\345\276\213\344\277\256\347\202\274\344\271\213\350\267\257\343\200\202\");\n        setTimeout(() => {\n          setAuthSuccess(\"\");\n          setActiveTab(\"home\");\n        }, 1200);\n      } else {\n        setAuthError(\"\350\264\246\345\217\267\345\220\215\347\247\260\346\210\226\345\257\206\347\240\201\350\276\223\345\205\245\344\270\215\346\255\243\347\241\256\357\274\201\");\n      }\n    } else {\n      // Register logic\n      const exists = regUsers.some((u: any) => u.username === authUsername);\n      if (exists) {\n        setAuthError(\"\345\275\223\345\211\215\347\224\250\346\210\267\345\220\215\345\267\262\350\242\253\346\263\250\345\206\214\343\200\202\350\257\267\345\260\235\350\257\225\346\215\242\344\270\200\344\270\252\343\200\202\");\n        return;\n      }\n\n      const generatedId = `SLF-2026-${Math.floor(100 + Math.random() * 900)}`;\n      const newUser = {\n        username: authUsername,\n        password: authPassword,\n        nickname: authNickname || authUsername,\n        id: generatedId,\n        avatar: DEFAULT_AVATARS[Math.floor(Math.random() * DEFAULT_AVATARS.length)],\n        apiProvider: \"Google AI Studio\",\n        apiKey: \"\",\n        sleepRecords: [],\n        mealItems: [],\n        workoutRecords: [],\n        studyRecords: [],\n        mustDoTasks: [\n          { id: crypto.randomUUID(), period: \"today\", text: \"\344\273\212\346\227\245\350\265\267\346\255\245\344\270\223\346\263\250\346\211\223\345\215\241\347\254\254\344\270\200\345\244\251\357\274\201\", completed: false, createdAt: new Date().toISOString().split(\"T\")[0] }\n        ],\n      };\n\n      regUsers.push(newUser);\n      localStorage.setItem(\"min_registered_users\", JSON.stringify(regUsers));\n      setAuthSuccess(\"\360\237\216\211 \346\201\255\345\226\234\357\274\214\350\264\246\345\217\267\346\263\250\345\206\214\346\210\220\345\212\237\357\274\201\347\216\260\345\267\262\345\217\257\347\253\213\345\215\263\350\277\233\350\241\214\347\231\273\345\275\225\343\200\202\");\n      setIsLoginView(true);\n      setAuthPassword(\"\");\n    }\n  };\n\n  // Switch / Settings updates\n  const handleSettingsSave = (e: React.FormEvent) => {\n    e.preventDefault();\n    const updated = {\n      ...session,\n      name: settingsName,\n      avatarUrl: settingsAvatar,\n      apiProvider: settingsProvider,\n      apiKey: settingsKey,\n    };\n    setSession(updated);\n\n    // If registered, persist their settings too\n    const regUsersRaw = localStorage.getItem(\"min_registered_users\") || \"[]\";\n    const regUsers = JSON.parse(regUsersRaw);\n    const updatedUsers = regUsers.map((u: any) => {\n      if (u.username === session.username) {\n        return {\n          ...u,\n          nickname: settingsName,\n          avatar: settingsAvatar,\n          apiProvider: settingsProvider,\n          apiKey: settingsKey,\n          sleepRecords,\n          mealItems,\n          workoutRecords,\n          studyRecords,\n          mustDoTasks,\n        };\n      }\n      return u;\n    });\n    localStorage.setItem(\"min_registered_users\", JSON.stringify(updatedUsers));\n    \n    setSyncStatus(\"\342\234\205 \344\270\252\344\272\272\351\205\215\347\275\256\345\217\212 API Key \345\257\206\351\222\245\345\235\207\345\267\262\346\234\254\345\234\260\347\274\223\345\255\230\345\255\230\347\233\230\343\200\202\");\n    setTimeout(() => setSyncStatus(null), 2505);\n  };\n\n  const handleLogout = () => {\n    // Save to registry before logging out if logged in\n    if (session.isLoggedIn) {\n      const regUsersRaw = localStorage.getItem(\"min_registered_users\") || \"[]\";\n      const regUsers = JSON.parse(regUsersRaw);\n      const updatedUsers = regUsers.map((u: any) => {\n        if (u.username === session.username) {\n          return {\n            ...u,\n            sleepRecords,\n            mealItems,\n            workoutRecords,\n            studyRecords,\n            mustDoTasks,\n          };\n        }\n        return u;\n      });\n      localStorage.setItem(\"min_registered_users\", JSON.stringify(updatedUsers));\n    }\n\n    setSession({\n      username: \"Guest\",\n      name: \"\350\207\252\345\276\213\344\277\256\350\241\214\346\227\205\345\256\242\",\n      id: \"SLF-2026-X88\",\n      avatarUrl: DEFAULT_AVATARS[0],\n      isLoggedIn: false,\n      apiProvider: \"Google AI Studio\",\n      apiKey: \"\",\n    });\n    \n    // Clear out user specific states\n    setSleepRecords([]);\n    setMealItems([]);\n    setWorkoutRecords([]);\n    setStudyRecords([]);\n    setMustDoTasks([\n      { id: \"1\", period: \"today\", text: \"\344\273\212\346\227\245\351\230\205\350\257\27320\345\210\206\351\222\237\346\210\226\344\270\223\346\263\250\345\201\232\346\200\273\347\273\223\", completed: false, createdAt: new Date().toISOString().split(\"T\")[0] }\n    ]);\n\n    setActiveTab(\"auth\");\n  };\n\n  // Sync animation handler\n  const handleCloudSync = () => {\n    setIsSyncing(true);\n    setSyncStatus(null);\n    \n    // Simulate real cloud transmission\n    setTimeout(() => {\n      setIsSyncing(false);\n      setSyncStatus(`\360\237\214\237 \345\220\214\346\255\245\346\210\220\345\212\237\357\274\201\345\267\262\344\270\272\350\264\246\346\210\267 [${session.name}] \346\225\264\345\220\210\345\257\271\351\275\220 ${studyRecords.length + sleepRecords.length + workoutRecords.length + mealItems.length} \346\256\265\344\277\256\350\241\214\345\216\206\347\250\213\343\200\202`);\n      setTimeout(() => setSyncStatus(null), 3500);\n    }, 1800);\n  };\n\n  const handleExportJSON = () => {\n    const minBackup = {\n      version: \"1.2.0\",\n      exportTime: new Date().toISOString(),\n      user: session,\n      data: {\n        sleepRecords,\n        mealItems,\n        workoutRecords,\n        studyRecords,\n        mustDoTasks,\n      }\n    };\n    const blob = new Blob([JSON.stringify(minBackup, null, 2)], { type: \"application/json\" });\n    const url = URL.createObjectURL(blob);\n    const a = document.createElement(\"a\");\n    a.href = url;\n    a.download = `slf_minimal_backup_${session.name}_${new Date().toISOString().split(\"T\")[0]}.json`;\n    a.click();\n    URL.revokeObjectURL(url);\n  };\n\n  const handleImportJSON = (e: React.ChangeEvent<HTMLInputElement>) => {\n    const file = e.target.files?.[0];\n    if (!file) return;\n\n    const r = new FileReader();\n    r.onload = (event) => {\n      try {\n        const parsed = JSON.parse(event.target?.result as string);\n        if (parsed.data) {\n          if (parsed.data.sleepRecords) setSleepRecords(parsed.data.sleepRecords);\n          if (parsed.data.mealItems) setMealItems(parsed.data.mealItems);\n          if (parsed.data.workoutRecords) setWorkoutRecords(parsed.data.workoutRecords);\n          if (parsed.data.studyRecords) setStudyRecords(parsed.data.studyRecords);\n          if (parsed.data.mustDoTasks) setMustDoTasks(parsed.data.mustDoTasks);\n          if (parsed.user) {\n            setSession({\n              ...parsed.user,\n              isLoggedIn: session.isLoggedIn, // keep current login context\n            });\n          }\n          alert(\"\360\237\216\211 \350\207\252\345\276\213\345\244\207\344\273\275 JSON \346\225\260\346\215\256\345\257\274\345\205\245\345\271\266\345\220\210\345\271\266\345\257\271\351\275\220\346\210\220\345\212\237\357\274\201\");\n        } else {\n          throw new Error(\"\346\240\274\345\274\217\344\270\215\345\205\274\345\256\271\");\n        }\n      } catch {\n        alert(\"\345\257\274\345\205\245\350\247\243\346\236\220\351\224\231\350\257\257\357\274\214\350\257\267\347\241\256\344\277\235\344\275\277\347\224\250\347\224\261\346\234\254\347\263\273\347\273\237\345\257\274\345\207\272\347\232\204\345\256\214\346\225\264\345\244\207\344\273\275 JSON \346\226\207\344\273\266\343\200\202\");\n      }\n    };\n    r.readAsText(file);\n  };\n\n  return (\n    <div className=\"min-h-screen bg-slate-50 text-slate-900 flex flex-col font-sans select-none antialiased\">\n      \n      {/* Dynamic Header */}\n      <header className=\"sticky top-0 z-40 bg-white/95 backdrop-blur-md border-b border-slate-200/80 px-4 py-3 shadow-xs shrink-0 select-none\">\n        <div className=\"max-w-4xl mx-auto flex items-center justify-between\">\n          <div className=\"flex items-center gap-2\">\n            <div className=\"bg-slate-900 text-white rounded-xl p-2 flex items-center justify-center\">\n              <Award size={18} className=\"text-emerald-400\" />\n            </div>\n            <div>\n              <h1 className=\"text-xs font-black tracking-tight text-slate-900 flex items-center gap-1.5 leading-none\">\n                <span>\350\207\252\345\276\213\344\277\256\350\241\214\347\256\241\345\256\266</span>\n                <span className=\"text-[8px] bg-slate-100 text-slate-500 font-extrabold px-1.5 py-0.5 rounded-full uppercase scale-95 border border-slate-200\">\n                  Lite \346\236\201\347\256\200\n                </span>\n              </h1>\n              <span className=\"text-[9px] text-slate-400 font-bold font-mono\">\n                {session?.isLoggedIn ? `\360\237\221\244 \345\267\262\347\231\273: ${session.name}` : \"\360\237\221\244 \346\227\205\345\256\242\344\275\223\351\252\214\344\270\255\"}\n              </span>\n            </div>\n          </div>\n\n          <div className=\"flex items-center gap-2\">\n            <button\n              onClick={() => setIsCheckInOpen(true)}\n              className=\"bg-emerald-600 hover:bg-emerald-700 text-white font-extrabold px-3.5 py-1.5 rounded-xl text-[11px] transition-all flex items-center gap-1 shadow-sm active:scale-98 cursor-pointer\"\n            >\n              <span>\342\232\241 \344\270\200\351\224\256\346\211\223\345\215\241</span>\n            </button>\n          </div>\n        </div>\n      </header>\n\n      {/* Motto strip */}\n      <section className=\"bg-white border-b border-slate-150 px-4 py-2.5\">\n        <div className=\"max-w-4xl mx-auto text-center\">\n          <p className=\"text-[10px] text-slate-500 italic font-medium leading-relaxed\">\n            \342\200\234 {motto} \342\200\235\n          </p>\n        </div>\n      </section>\n\n      {/* Main Container */}\n      <main className=\"flex-1 overflow-y-auto px-4 py-6 pb-20 select-text\">\n        <div className=\"max-w-4xl mx-auto\">\n          \n          <AnimatePresence mode=\"wait\">\n            \n            {/* TAB 1: HOME PAGE */}\n            {activeTab === \"home\" && (\n              <motion.div\n                key=\"home\"\n                initial={{ opacity: 0, y: 5 }}\n                animate={{ opacity: 1, y: 0 }}\n                exit={{ opacity: 0, y: -5 }}\n                transition={{ duration: 0.1 }}\n                className=\"space-y-6\"\n              >\n                \n                {/* Task Commitment Card (\"\345\275\223\345\211\215\350\246\201\345\201\232\347\232\204\344\272\213\346\203\205\") */}\n                <section className=\"bg-white border border-slate-200/60 rounded-xl p-5 shadow-xs space-y-4\">\n                  <div className=\"flex items-center justify-between border-b border-slate-100 pb-2\">\n                    <div className=\"flex items-center gap-2\">\n                      <ListTodo size={16} className=\"text-slate-800\" />\n                      <h3 className=\"text-xs font-bold text-slate-800\">\345\275\223\345\211\215\350\246\201\345\201\232\347\232\204\344\272\213\346\203\205 (\346\211\277\350\257\272\346\211\223\345\215\241\346\235\277)</h3>\n                    </div>\n                    <span className=\"text-[9.5px] bg-slate-100 text-slate-500 px-1.5 py-0.5 rounded font-extrabold font-mono\">\n                      \345\276\205\345\261\245\350\241\214: {totalIncomplete} \351\241\271\n                    </span>\n                  </div>\n\n                  {/* Add task bar */}\n                  <form onSubmit={handleAddTask} className=\"flex flex-col sm:flex-row gap-2\">\n                    <select\n                      value={newTaskPeriod}\n                      onChange={(e) => setNewTaskPeriod(e.target.value as any)}\n                      className=\"text-xs border border-slate-205 rounded-lg p-2.5 bg-slate-50 font-bold focus:outline-none\"\n                    >\n                      <option value=\"today\">\360\237\223\205 \344\273\212\346\227\245\345\277\205\351\241\273\350\246\201\345\201\232\347\232\204</option>\n                      <option value=\"week\">\360\237\227\223\357\270\217 \346\234\254\345\221\250\345\277\205\351\241\273\350\246\201\345\201\232\347\232\204</option>\n                      <option value=\"month\">\360\237\223\212 \346\234\254\346\234\210\345\277\205\351\241\273\350\246\201\345\201\232\347\232\204</option>\n                    </select>\n\n                    <input\n                      type=\"text\"\n                      required\n                      placeholder=\"\345\206\231\344\270\213\346\234\200\347\272\257\347\262\271\346\234\200\344\270\215\347\225\231\351\200\200\350\267\257\347\232\204\350\252\223\346\204\277...\"\n                      value={newTaskText}\n                      onChange={(e) => setNewTaskText(e.target.value)}\n                      className=\"flex-1 text-xs border border-slate-205 rounded-lg p-2.5 focus:outline-none placeholder-slate-400 bg-white\"\n                    />\n\n                    <button\n                      type=\"submit\"\n                      className=\"bg-slate-900 hover:bg-slate-950 text-white font-bold px-4 py-2.5 rounded-lg text-xs tracking-wide transition-colors shrink-0 cursor-pointer\"\n                    >\n                      <span>\350\277\275\345\212\240\350\252\223\350\250\200</span>\n                    </button>\n                  </form>\n\n                  {/* Period Cards Grid */}\n                  <div className=\"grid grid-cols-1 md:grid-cols-3 gap-3 pt-1\">\n                    \n                    {/* TODAY COLUMN */}\n                    <div className=\"bg-slate-50/50 border border-slate-200/50 rounded-xl p-3 space-y-2.5\">\n                      <div className=\"flex items-center justify-between border-b border-slate-100 pb-1 flex-row\">\n                        <span className=\"text-[11px] font-extrabold text-slate-800 flex items-center gap-1\">\n                          <span>\360\237\223\205</span>\n                          <span>\344\273\212\346\227\245\345\277\205\345\201\232</span>\n                        </span>\n                        <span className=\"text-[9px] bg-white border px-1 rounded-full text-slate-500 font-bold\">\n                          {incompleteToday} \345\276\205\345\212\236\n                        </span>\n                      </div>\n\n                      <div className=\"space-y-1.5 max-h-40 overflow-y-auto\">\n                        {mustDoTasks.filter((t) => t.period === \"today\").length === 0 ? (\n                          <p className=\"text-[9.5px] text-slate-400 text-center py-5\">\344\273\212\346\227\245\346\227\240\350\252\223\350\250\200\343\200\202\347\273\231\350\207\252\345\267\261\347\253\213\344\270\252\345\277\205\345\201\232\345\260\217\347\233\256\346\240\207\345\220\247\357\274\201</p>\n                        ) : (\n                          mustDoTasks.filter((t) => t.period === \"today\").map((t) => (\n                            <div key={t.id} className=\"flex items-start justify-between p-2 bg-white rounded-lg border border-slate-150 group gap-1.5\">\n                              <label className=\"flex items-start gap-2 cursor-pointer flex-1 text-[11px]\">\n                                <input\n                                  type=\"checkbox\"\n                                  checked={t.completed}\n                                  onChange={() => handleToggleTask(t.id)}\n                                  className=\"mt-0.5 accent-slate-900\"\n                                />\n                                <span className={t.completed ? \"line-through text-slate-400\" : \"font-semibold text-slate-700\"}>\n                                  {t.text}\n                                </span>\n                              </label>\n                              <button\n                                onClick={() => handleDeleteTask(t.id)}\n                                className=\"text-slate-300 hover:text-rose-500 p-0.5 opacity-100 md:opacity-0 group-hover:opacity-100 transition-all shrink-0 cursor-pointer\"\n                              >\n                                <Trash2 size={11} />\n                              </button>\n                            </div>\n                          ))\n                        )}\n                      </div>\n                    </div>\n\n                    {/* WEEK COLUMN */}\n                    <div className=\"bg-slate-50/50 border border-slate-200/50 rounded-xl p-3 space-y-2.5\">\n                      <div className=\"flex items-center justify-between border-b border-slate-100 pb-1 flex-row\">\n                        <span className=\"text-[11px] font-extrabold text-slate-800 flex items-center gap-1\">\n                          <span>\360\237\227\223\357\270\217</span>\n                          <span>\346\234\254\345\221\250\345\277\205\345\201\232</span>\n                        </span>\n                        <span className=\"text-[9px] bg-white border px-1 rounded-full text-slate-500 font-bold\">\n                          {incompleteWeek} \345\276\205\345\212\236\n                        </span>\n                      </div>\n\n                      <div className=\"space-y-1.5 max-h-40 overflow-y-auto\">\n                        {mustDoTasks.filter((t) => t.period === \"week\").length === 0 ? (\n                          <p className=\"text-[9.5px] text-slate-400 text-center py-5\">\346\234\254\345\221\250\347\251\272\347\231\275\343\200\202\346\257\217\345\221\250\347\252\201\347\240\264\344\270\200\344\270\252\347\223\266\351\242\210\347\202\271\357\274\201</p>\n                        ) : (\n                          mustDoTasks.filter((t) => t.period === \"week\").map((t) => (\n                            <div key={t.id} className=\"flex items-start justify-between p-2 bg-white rounded-lg border border-slate-150 group gap-1.5\">\n                              <label className=\"flex items-start gap-2 cursor-pointer flex-1 text-[11px]\">\n                                <input\n                                  type=\"checkbox\"\n                                  checked={t.completed}\n                                  onChange={() => handleToggleTask(t.id)}\n                                  className=\"mt-0.5 accent-slate-900\"\n                                />\n                                <span className={t.completed ? \"line-through text-slate-400\" : \"font-semibold text-slate-700\"}>\n                                  {t.text}\n                                </span>\n                              </label>\n                              <button\n                                onClick={() => handleDeleteTask(t.id)}\n                                className=\"text-slate-300 hover:text-rose-500 p-0.5 opacity-100 md:opacity-0 group-hover:opacity-100 transition-all shrink-0 cursor-pointer\"\n                              >\n                                <Trash2 size={11} />\n                              </button>\n                            </div>\n                          ))\n                        )}\n                      </div>\n                    </div>\n\n                    {/* MONTH COLUMN */}\n                    <div className=\"bg-slate-50/50 border border-slate-200/50 rounded-xl p-3 space-y-2.5\">\n                      <div className=\"flex items-center justify-between border-b border-slate-100 pb-1 flex-row\">\n                        <span className=\"text-[11px] font-extrabold text-slate-800 flex items-center gap-1\">\n                          <span>\360\237\223\212</span>\n                          <span>\346\234\254\346\234\210\345\277\205\345\201\232</span>\n                        </span>\n                        <span className=\"text-[9px] bg-white border px-1 rounded-full text-slate-500 font-bold\">\n                          {incompleteMonth} \345\276\205\345\212\236\n                        </span>\n                      </div>\n\n                      <div className=\"space-y-1.5 max-h-40 overflow-y-auto\">\n                        {mustDoTasks.filter((t) => t.period === \"month\").length === 0 ? (\n                          <p className=\"text-[9.5px] text-slate-400 text-center py-5\">\346\234\254\346\234\210\346\227\240\345\244\247\344\272\213\343\200\202\351\224\201\345\256\232\344\270\200\344\270\244\345\272\247\351\253\230\345\264\226\350\277\233\350\241\214\347\277\273\350\266\212\357\274\201</p>\n                        ) : (\n                          mustDoTasks.filter((t) => t.period === \"month\").map((t) => (\n                            <div key={t.id} className=\"flex items-start justify-between p-2 bg-white rounded-lg border border-slate-150 group gap-1.5\">\n                              <label className=\"flex items-start gap-2 cursor-pointer flex-1 text-[11px]\">\n                                <input\n                                  type=\"checkbox\"\n                                  checked={t.completed}\n                                  onChange={() => handleToggleTask(t.id)}\n                                  className=\"mt-0.5 accent-slate-900\"\n                                />\n                                <span className={t.completed ? \"line-through text-slate-400\" : \"font-semibold text-slate-700\"}>\n                                  {t.text}\n                                </span>\n                              </label>\n                              <button\n                                onClick={() => handleDeleteTask(t.id)}\n                                className=\"text-slate-300 hover:text-rose-500 p-0.5 opacity-100 md:opacity-0 group-hover:opacity-100 transition-all shrink-0 cursor-pointer\"\n                              >\n                                <Trash2 size={11} />\n                              </button>\n                            </div>\n                          ))\n                        )}\n                      </div>\n                    </div>\n\n                  </div>\n                </section>\n\n                {/* Big Button Check In call-out banner */}\n                <div className=\"bg-slate-900 text-white rounded-2xl p-6 relative overflow-hidden flex flex-col md:flex-row items-center justify-between gap-4 border border-slate-800 min-h-[140px] select-none shadow-md\">\n                  <div className=\"space-y-1.5 text-center md:text-left z-10\">\n                    <span className=\"text-[10px] bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 font-extrabold tracking-wider px-2 py-0.5 rounded-full\">\n                      \344\273\212\346\227\245\345\267\262\345\201\232 {activeCheckIns.totalCount} \346\254\241\346\211\223\345\215\241\350\256\260\345\275\225\n                    </span>\n                    <h3 className=\"text-base font-extrabold tracking-tight\">\346\257\217\346\227\245\350\207\252\345\276\213\344\277\256\350\241\214 \302\267 \350\241\214\350\203\234\344\272\216\350\250\200</h3>\n                    <p className=\"text-[10.5px] text-slate-400 max-w-sm leading-relaxed\">\n                      \345\260\206\344\273\212\346\227\245\345\234\250\344\275\234\346\201\257\343\200\201\351\243\237\347\211\251\343\200\201\346\261\227\346\260\264\345\222\214\347\240\224\350\257\273\344\270\212\347\232\204\347\202\271\346\273\264\344\270\200\351\224\256\347\231\273\350\256\260\345\210\260\344\277\256\350\241\214\346\227\245\345\277\227\357\274\214\351\223\270\351\200\240\346\233\264\346\270\205\346\231\260\343\200\201\346\233\264\346\267\261\346\262\211\347\232\204\350\207\252\345\267\261\343\200\202\n                    </p>\n                  </div>\n                  \n                  <button\n                    onClick={() => setIsCheckInOpen(true)}\n                    className=\"bg-white hover:bg-slate-100 text-slate-900 font-black px-6 py-3.5 rounded-xl text-xs tracking-wider transition-all shadow hover:shadow-lg scale-102 active:scale-98 cursor-pointer shrink-0 py-3 block h-auto z-10\"\n                  >\n                    \360\237\232\200 \347\202\271\345\207\273\347\253\213\345\210\273\345\216\273\346\211\223\345\215\241\n                  </button>\n\n                  <div className=\"absolute right-0 top-0 translate-x-10 -translate-y-6 text-slate-800/20 text-[180px] pointer-events-none select-none font-black font-sans shrink-0\">\n                    SLF\n                  </div>\n                </div>\n\n                {/* Today Log Flow (\"\344\273\212\346\227\245\346\211\223\345\215\241\346\265\201\346\260\264\") */}\n                <section className=\"bg-white border border-slate-200/60 rounded-xl p-5 shadow-xs space-y-4\">\n                  <div className=\"flex items-center justify-between border-b border-slate-100 pb-2\">\n                    <h3 className=\"text-xs font-bold text-slate-800 flex items-center gap-1.5\">\n                      <span>\360\237\223\206 \344\273\212\346\227\245\350\207\252\345\276\213\346\265\201\346\260\264\344\270\216\347\264\257\347\247\257\346\224\266\350\216\267</span>\n                      <span className=\"text-[10.5px] font-normal text-slate-400\">({todayStr})</span>\n                    </h3>\n                  </div>\n\n                  {activeCheckIns.totalCount === 0 ? (\n                    <div className=\"py-10 text-center text-slate-400 bg-slate-50/50 border border-dashed rounded-xl space-y-1\">\n                      <Clock size={20} className=\"mx-auto text-slate-300\" />\n                      <p className=\"text-xs font-semibold\">\344\273\212\346\227\245\345\260\232\346\234\252\344\272\247\347\224\237\344\273\273\344\275\225\350\207\252\345\276\213\346\211\223\345\215\241\345\215\260\350\256\260\343\200\202</p>\n                      <p className=\"text-[9.5px]\">\347\202\271\345\207\273\344\270\212\346\226\271\342\200\234\344\270\200\351\224\256\346\211\223\345\215\241\342\200\235\346\214\211\351\222\256\357\274\214\347\253\213\345\215\263\345\274\200\345\247\213\350\256\260\345\275\225\346\202\250\347\232\204\351\246\226\344\270\252\350\266\263\350\277\271\357\274\201</p>\n                    </div>\n                  ) : (\n                    <div className=\"space-y-3\">\n                      \n                      {/* Sleep Logs */}\n                      {activeCheckIns.sleeps.map((record) => (\n                        <div key={record.id} className=\"flex gap-3 bg-slate-50/60 border border-slate-200/50 p-3 rounded-lg text-xs justify-between group\">\n                          <div className=\"flex items-start gap-2.5\">\n                            <div className=\"bg-slate-950 p-2 text-white rounded-lg shrink-0 mt-0.5\">\n                              <Moon size={13} />\n                            </div>\n                            <div className=\"space-y-1\">\n                              <div className=\"flex items-center gap-2\">\n                                <span className=\"font-bold text-slate-800 text-[11.5px]\">\360\237\214\231 \344\275\234\346\201\257\346\211\223\345\215\241\345\256\214\346\210\220</span>\n                                <span className=\"text-[9.5px] bg-slate-200 text-slate-700 px-1 rounded font-bold font-mono\">\n                                  \346\227\266\351\225\277 {record.duration}h\n                                </span>\n                              </div>\n                              <p className=\"text-slate-600 font-semibold leading-relaxed\">\n                                \344\270\212\345\272\212\357\274\232{record.sleepTime} &rarr; \346\231\250\351\206\222\357\274\232{record.wakeTime}\n                              </p>\n                              {record.note && <p className=\"text-[10.5px] text-slate-400 font-medium italic\">\342\200\234 {record.note} \342\200\235</p>}\n                            </div>\n                          </div>\n\n                          <div className=\"flex flex-col items-end justify-between shrink-0\">\n                            <button\n                              onClick={() => setSleepRecords(sleepRecords.filter(r => r.id !== record.id))}\n                              className=\"text-slate-300 hover:text-rose-500 opacity-100 md:opacity-0 group-hover:opacity-100 transition-opacity cursor-pointer text-[10px]\"\n                            >\n                              \345\210\240\351\231\244\n                            </button>\n                            <div className=\"flex gap-0.5 text-amber-500 font-bold\">\n                              {Array.from({ length: record.quality }).map((_, i) => (\n                                <Star key={i} size={10} className=\"fill-current\" />\n                              ))}\n                            </div>\n                          </div>\n                        </div>\n                      ))}\n\n                      {/* Meal Logs */}\n                      {activeCheckIns.meals.map((record) => (\n                        <div key={record.id} className=\"flex gap-3 bg-slate-50/60 border border-slate-200/50 p-3 rounded-lg text-xs justify-between group\">\n                          <div className=\"flex items-start gap-2.5\">\n                            <div className=\"bg-emerald-600 p-2 text-white rounded-lg shrink-0 mt-0.5\">\n                              <Utensils size={13} />\n                            </div>\n                            <div className=\"space-y-0.5\">\n                              <div className=\"flex items-center gap-2\">\n                                <span className=\"font-bold text-slate-850 text-[11.5px]\">\360\237\245\227 \351\245\256\351\243\237\346\211\223\345\215\241\345\256\214\346\210\220</span>\n                                <span className=\"text-[9.5px] bg-emerald-100 text-emerald-800 px-1.5 py-0.2 rounded font-bold uppercase select-none\">\n                                  {record.period}\n                                </span>\n                              </div>\n                              <p className=\"text-slate-800 font-bold text-xs pt-1 leading-snug\">{record.text}</p>\n                              {record.note && (\n                                <p className=\"text-[10px] text-slate-450 italic mt-0.5 bg-white border border-slate-100 p-1 px-2 rounded\">\n                                  \360\237\222\241 \350\257\204\344\273\267: {record.note}\n                                </p>\n                              )}\n                            </div>\n                          </div>\n\n                          <span className=\"shrink-0\">\n                            <button\n                              onClick={() => setMealItems(mealItems.filter(m => m.id !== record.id))}\n                              className=\"text-slate-300 hover:text-rose-500 opacity-100 md:opacity-0 group-hover:opacity-100 transition-opacity cursor-pointer text-[10px]\"\n                            >\n                              \345\210\240\351\231\244\n                            </button>\n                          </span>\n                        </div>\n                      ))}\n\n                      {/* Workout Logs */}\n                      {activeCheckIns.workouts.map((record) => (\n                        <div key={record.id} className=\"flex gap-3 bg-slate-50/60 border border-slate-200/50 p-3 rounded-lg text-xs justify-between group\">\n                          <div className=\"flex items-start gap-2.5\">\n                            <div className=\"bg-orange-500 p-2 text-white rounded-lg shrink-0 mt-0.5\">\n                              <Dumbbell size={13} />\n                            </div>\n                            <div className=\"space-y-1\">\n                              <div className=\"flex items-center gap-2\">\n                                <span className=\"font-bold text-slate-800 text-[11.5px]\">\360\237\217\203 \350\277\220\345\212\250\346\211\223\345\215\241\345\256\214\346\210\220</span>\n                                <span className=\"text-[9.5px] bg-orange-100 text-orange-800 px-1.5 rounded font-bold font-mono\">\n                                  \350\200\227\346\227\266 {record.duration} \345\210\206\351\222\237\n                                </span>\n                              </div>\n                              <p className=\"text-slate-650 font-bold text-xs\">{record.type}</p>\n                              <span className=\"text-[10px] text-slate-400 font-semibold font-mono\">\n                                \344\274\260\347\256\227\346\266\210\350\200\227 ~ {record.calories} kcal\n                              </span>\n                            </div>\n                          </div>\n\n                          <span className=\"shrink-0\">\n                            <button\n                              onClick={() => setWorkoutRecords(workoutRecords.filter(w => w.id !== record.id))}\n                              className=\"text-slate-300 hover:text-rose-500 opacity-100 md:opacity-0 group-hover:opacity-100 transition-opacity cursor-pointer text-[10px]\"\n                            >\n                              \345\210\240\351\231\244\n                            </button>\n                          </span>\n                        </div>\n                      ))}\n\n                      {/* Study Notes */}\n                      {activeCheckIns.studies.map((record) => (\n                        <div key={record.id} className=\"flex gap-3 bg-slate-50/60 border border-slate-200/50 p-3 rounded-lg text-xs justify-between group\">\n                          <div className=\"flex items-start gap-2.5\">\n                            <div className=\"bg-slate-850 p-2 text-white rounded-lg shrink-0 mt-0.5\">\n                              <BookOpen size={13} />\n                            </div>\n                            <div className=\"space-y-1\">\n                              <div className=\"flex items-center gap-2\">\n                                <span className=\"font-bold text-slate-808 text-[11.5px]\">\360\237\223\232 \345\255\246\344\271\240\344\270\223\346\263\250\345\215\241\347\211\207\344\277\235\345\255\230</span>\n                                <span className=\"text-[9.5px] bg-slate-200 text-slate-700 px-1.5 rounded font-bold font-mono\">\n                                  \350\200\227\346\227\266 {record.duration} \345\210\206\351\222\237\n                                </span>\n                              </div>\n                              <p className=\"text-slate-700 font-bold font-sans text-xs leading-snug\">{record.content}</p>\n                            </div>\n                          </div>\n\n                          <span className=\"shrink-0\">\n                            <button\n                              onClick={() => setStudyRecords(studyRecords.filter(s => s.id !== record.id))}\n                              className=\"text-slate-300 hover:text-rose-500 opacity-100 md:opacity-0 group-hover:opacity-100 transition-opacity cursor-pointer text-[10px]\"\n                            >\n                              \345\210\240\351\231\244\n                            </button>\n                          </span>\n                        </div>\n                      ))}\n\n                    </div>\n                  )}\n                </section>\n\n              </motion.div>\n            )}\n\n            {/* TAB 2: AUTH PAGE */}\n            {activeTab === \"auth\" && (\n              <motion.div\n                key=\"auth\"\n                initial={{ opacity: 0, y: 5 }}\n                animate={{ opacity: 1, y: 0 }}\n                exit={{ opacity: 0, y: -5 }}\n                transition={{ duration: 0.1 }}\n                className=\"max-w-md mx-auto space-y-6\"\n              >\n                {session.isLoggedIn ? (\n                  /* Logged-in screen representation */\n                  <div className=\"bg-white border border-slate-200 rounded-2xl p-6 shadow-md space-y-6 text-center select-none\">\n                    <div className=\"relative inline-block\">\n                      <img\n                        src={session.avatarUrl}\n                        alt=\"User avatar\"\n                        className=\"h-20 w-20 rounded-full object-cover border-4 border-slate-900 mx-auto\"\n                      />\n                      <div className=\"absolute -bottom-1 -right-1 bg-emerald-500 text-white rounded-full p-1.5 border-4 border-white\">\n                        <Check size={14} className=\"stroke-[3]\" />\n                      </div>\n                    </div>\n\n                    <div className=\"space-y-1\">\n                      <h3 className=\"font-extrabold text-slate-900 text-lg tracking-tight\">\344\272\262\347\210\261\347\232\204 {session.name}</h3>\n                      <p className=\"text-xs text-slate-600 font-bold font-mono uppercase bg-slate-100 inline-block px-2.5 py-0.5 rounded-full border border-slate-200\">\n                        \342\255\220 \345\215\223\350\266\212\351\273\204\351\207\221\350\207\252\345\276\213\344\277\256\350\241\214\350\200\205\n                      </p>\n                    </div>\n\n                    {/* Simualted user status statistics block */}\n                    <div className=\"grid grid-cols-2 gap-3 p-3.5 bg-slate-50 border border-slate-100 rounded-xl text-left text-xs text-slate-700\">\n                      <div>\n                        <p className=\"text-[10px] text-slate-400 font-bold uppercase\">\350\207\252\345\276\213\344\277\256\350\241\214 ID</p>\n                        <p className=\"font-bold font-mono text-slate-800\">{session.id}</p>\n                      </div>\n                      <div>\n                        <p className=\"text-[10px] text-slate-400 font-bold uppercase\">\345\205\263\350\201\224\350\264\246\345\217\267\345\220\215</p>\n                        <p className=\"font-bold font-mono text-slate-800\">@{session.username}</p>\n                      </div>\n                    </div>\n\n                    <div className=\"space-y-2\">\n                      <button\n                        onClick={handleCloudSync}\n                        disabled={isSyncing}\n                        className=\"w-full bg-slate-900 hover:bg-slate-950 text-white font-bold py-2.5 rounded-xl text-xs flex items-center justify-center gap-1.5 shadow transition-all cursor-pointer select-none\"\n                      >\n                        {isSyncing ? (\n                          <>\n                            <RefreshCw size={13} className=\"animate-spin text-emerald-400\" />\n                            <span>\350\207\252\345\276\213\345\216\206\347\250\213\350\267\250\345\261\202\345\257\271\351\275\220\345\220\214\346\255\245\344\270\255...</span>\n                          </>\n                        ) : (\n                          <>\n                            <RefreshCw size={13} className=\"text-emerald-400 animate-pulse\" />\n                            <span>\345\220\214\346\255\245\346\211\223\345\215\241\345\214\205\345\271\266\345\244\207\344\273\275</span>\n                          </>\n                        )}\n                      </button>\n\n                      <button\n                        onClick={handleLogout}\n                        className=\"w-full bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold py-2.5 rounded-xl text-xs transition-colors cursor-pointer\"\n                      >\n                        \351\200\200\345\207\272\345\275\223\345\211\215\350\264\246\345\217\267\347\231\273\345\275\225\n                      </button>\n                    </div>\n\n                    {syncStatus && (\n                      <p className=\"text-[10.5px] text-emerald-800 bg-emerald-50 border border-emerald-100 p-2.5 rounded-xl font-medium text-center\">\n                        {syncStatus}\n                      </p>\n                    )}\n                  </div>\n                ) : (\n                  /* Login / Register UI form cardboard */\n                  <div className=\"bg-white border border-slate-200 rounded-2xl p-6 shadow-lg space-y-5\">\n                    \n                    <div className=\"text-center space-y-1 pb-2 border-b border-slate-50\">\n                      <Lock size={22} className=\"mx-auto text-slate-800\" />\n                      <h3 className=\"text-sm font-black text-slate-900\">\n                        {isLoginView ? \"\347\231\273\345\275\225\346\210\221\347\232\204\350\207\252\345\276\213\344\277\256\350\241\214\350\264\246\345\217\267\" : \"\346\226\260\345\210\233\344\277\256\350\241\214\346\210\220\345\221\230\344\270\223\345\261\236\350\264\246\345\217\267\"}\n                      </h3>\n                      <p className=\"text-[10.5px] text-slate-400\">\347\231\273\345\205\245\345\220\216\346\277\200\346\264\273\351\225\277\345\221\250\346\234\237\346\211\223\345\215\241\343\200\201\350\207\252\345\212\250\345\244\207\344\273\275\357\274\214\345\256\236\347\216\260\345\256\214\347\276\216\345\220\214\346\255\245\343\200\202</p>\n                    </div>\n\n                    <form onSubmit={handleAuthSubmit} className=\"space-y-3.5 text-left text-xs text-slate-800\">\n                      <div className=\"space-y-1\">\n                        <label className=\"text-[11px] text-slate-500 font-bold\">\350\264\246\345\217\267\347\231\273\345\275\225\345\220\215 <span className=\"text-rose-500\">*</span></label>\n                        <input\n                          type=\"text\"\n                          required\n                          placeholder=\"\344\276\213\345\246\202: slf_warrior\"\n                          value={authUsername}\n                          onChange={(e) => setAuthUsername(e.target.value.toLowerCase().replace(/[^a-z0-9_]/g, \"\"))}\n                          className=\"w-full border border-slate-205 rounded-xl p-2.5 focus:outline-none focus:ring-1 focus:ring-slate-500 bg-slate-50\"\n                        />\n                      </div>\n\n                      {!isLoginView && (\n                        <div className=\"space-y-1\">\n                          <label className=\"text-[11px] text-slate-500 font-bold\">\350\207\252\345\276\213\344\277\256\350\241\214\346\230\265\347\247\260 (\351\200\211\345\241\253)</label>\n                          <input\n                            type=\"text\"\n                            placeholder=\"\344\276\213\345\246\202: \346\257\217\346\227\245\346\227\251\350\265\267\345\260\217\350\276\276\344\272\272\"\n                            value={authNickname}\n                            onChange={(e) => setAuthNickname(e.target.value)}\n                            className=\"w-full border border-slate-205 rounded-xl p-2.5 focus:outline-none focus:ring-1 focus:ring-slate-500 bg-slate-50\"\n                          />\n                        </div>\n                      )}\n\n                      <div className=\"space-y-1\">\n                        <label className=\"text-[11px] text-slate-500 font-bold\">\350\256\277\351\227\256\345\256\211\345\205\250\345\257\206\347\240\201 <span className=\"text-rose-500\">*</span></label>\n                        <input\n                          type=\"password\"\n                          required\n                          placeholder=\"******\"\n                          value={authPassword}\n                          onChange={(e) => setAuthPassword(e.target.value)}\n                          className=\"w-full border border-slate-205 rounded-xl p-2.5 focus:outline-none focus:ring-1 focus:ring-slate-500 bg-slate-50\"\n                        />\n                      </div>\n\n                      {authError && <p className=\"text-[10.5px] text-rose-500 font-semibold\">{authError}</p>}\n                      {authSuccess && <p className=\"text-[10.5px] text-emerald-800 bg-emerald-50 p-2 rounded-lg\">{authSuccess}</p>}\n\n                      <button\n                        type=\"submit\"\n                        className=\"w-full bg-slate-900 hover:bg-slate-950 text-white font-bold py-2.5 rounded-xl tracking-wide shadow transition-all cursor-pointer mt-4\"\n                      >\n                        {isLoginView ? \"\347\253\213\345\210\273\347\231\273\345\275\225\345\274\200\345\220\257\346\227\205\347\250\213\" : \"\345\220\214\346\204\217\345\271\266\346\263\250\345\206\214\346\226\260\350\264\246\345\217\267\"}\n                      </button>\n                    </form>\n\n                    <div className=\"pt-3 border-t border-slate-100 text-center select-none\">\n                      <button\n                        onClick={() => {\n                          setIsLoginView(!isLoginView);\n                          setAuthError(\"\");\n                          setAuthSuccess(\"\");\n                        }}\n                        className=\"text-[11px] text-slate-500 hover:text-slate-900 font-bold hover:underline cursor-pointer\"\n                      >\n                        {isLoginView ? \"\360\237\222\241 \350\277\230\346\262\241\346\234\211\350\264\246\345\217\267\357\274\237\347\202\271\345\207\273\346\255\244\345\244\204\345\205\215\350\264\271\346\263\250\345\206\214\346\226\260\350\264\246\345\217\267\" : \"\360\237\222\241 \345\267\262\346\234\211\350\264\246\345\217\267\357\274\237\347\202\271\345\207\273\346\255\244\345\244\204\350\277\233\350\241\214\345\277\253\351\200\237\347\231\273\345\275\225\"}\n                      </button>\n                    </div>\n\n                    <div className=\"p-3 bg-slate-50 rounded-xl border border-dashed border-slate-200 text-[10px] text-slate-500 leading-relaxed text-justify mt-1\">\n                      \360\237\222\241 <span className=\"font-bold\">\346\227\205\345\256\242\350\257\225\347\224\250\346\217\220\351\206\222\357\274\232</span>\345\246\202\346\236\234\346\202\250\347\216\260\345\234\250\347\233\264\346\216\245\344\275\277\347\224\250\342\200\234\344\270\200\351\224\256\346\211\223\345\215\241\342\200\235\357\274\214\346\202\250\347\232\204\346\225\260\346\215\256\344\274\232\350\207\252\345\212\250\346\214\201\344\271\205\345\214\226\344\277\235\345\255\230\344\272\216\345\275\223\345\211\215\346\211\213\346\234\272\347\232\204\346\234\254\345\234\260\346\225\260\346\215\256\345\272\223\344\270\255\357\274\214\351\232\217\346\227\266\345\217\257\344\273\245\345\234\250\342\200\234\350\256\276\347\275\256\351\241\265\342\200\235\344\270\255\350\277\201\345\207\272\345\244\207\344\273\275 JSON\343\200\202\n                    </div>\n\n                  </div>\n                )}\n              </motion.div>\n            )}\n\n            {/* TAB 3: SETTINGS PAGE */}\n            {activeTab === \"settings\" && (\n              <motion.div\n                key=\"settings\"\n                initial={{ opacity: 0, y: 5 }}\n                animate={{ opacity: 1, y: 0 }}\n                exit={{ opacity: 0, y: -5 }}\n                transition={{ duration: 0.1 }}\n                className=\"max-w-md mx-auto space-y-6 text-left\"\n              >\n                \n                {/* Visual Settings Card */}\n                <form onSubmit={handleSettingsSave} className=\"bg-white border border-slate-200/80 rounded-2xl p-6 shadow-md space-y-5\">\n                  <div className=\"border-b border-slate-50 pb-2 flex items-center justify-between\">\n                    <h3 className=\"font-black text-slate-900 text-sm flex items-center gap-1.5 select-none\">\n                      <Settings size={15} />\n                      <span>\344\270\252\344\272\272\350\265\204\346\226\231\344\270\216\346\216\245\345\217\243\351\205\215\347\275\256\346\216\247\345\210\266\345\217\260</span>\n                    </h3>\n                  </div>\n\n                  {/* Profile section */}\n                  <div className=\"space-y-4\">\n                    \n                    {/* Avatar selection */}\n                    <div className=\"space-y-1.5 select-none text-xs\">\n                      <label className=\"text-[11px] text-slate-500 font-bold\">\351\200\211\346\213\251\344\277\256\350\241\214\345\244\264\345\203\217</label>\n                      <div className=\"flex gap-2 items-center py-1\">\n                        <img\n                          src={settingsAvatar}\n                          alt=\"Current avatar\"\n                          className=\"h-14 w-14 rounded-full border-2 border-slate-900 object-cover shrink-0\"\n                        />\n                        <div className=\"flex flex-wrap gap-1.5\">\n                          {DEFAULT_AVATARS.map((av, idx) => (\n                            <button\n                              key={idx}\n                              type=\"button\"\n                              onClick={() => setSettingsAvatar(av)}\n                              className={`h-7.5 w-7.5 rounded-full overflow-hidden border-2 transition-all cursor-pointer hover:scale-105 ${\n                                settingsAvatar === av ? \"border-slate-800 scale-102\" : \"border-slate-200\"\n                              }`}\n                            >\n                              <img src={av} alt=\"avatar option\" className=\"h-full w-full object-cover\" />\n                            </button>\n                          ))}\n                        </div>\n                      </div>\n                    </div>\n\n                    {/* Nickname field */}\n                    <div className=\"space-y-1 text-xs\">\n                      <label className=\"text-[11px] text-slate-500 font-bold\">\347\224\250\346\210\267\346\230\276\347\244\272\346\230\265\347\247\260 (\350\207\252\345\276\213\345\220\215\345\217\267)</label>\n                      <input\n                        type=\"text\"\n                        required\n                        value={settingsName}\n                        onChange={(e) => setSettingsName(e.target.value)}\n                        className=\"w-full border border-slate-205 rounded-xl p-2.5 focus:outline-none bg-slate-50 font-semibold\"\n                      />\n                    </div>\n\n                    <div className=\"grid grid-cols-2 gap-3 text-xs\">\n                      <div>\n                        <span className=\"text-[10px] text-slate-400 font-bold uppercase select-none\">\344\277\256\350\241\214\350\200\205 ID</span>\n                        <p className=\"font-bold font-mono text-slate-700 bg-slate-50 border p-2 rounded-xl mt-1 select-all truncate\">\n                          {session.id}\n                        </p>\n                      </div>\n                      <div>\n                        <span className=\"text-[10px] text-slate-400 font-bold uppercase select-none\">\350\264\246\345\217\267\345\205\263\350\201\224</span>\n                        <p className=\"font-bold font-mono text-slate-700 bg-slate-50 border p-2 rounded-xl mt-1 select-all truncate\">\n                          @{session.username}\n                        </p>\n                      </div>\n                    </div>\n\n                    {/* API keys provider */}\n                    <div className=\"border-t border-slate-100 pt-3 space-y-3.5\">\n                      <div className=\"space-y-1 text-xs\">\n                        <label className=\"text-[11px] text-slate-500 font-bold\">API \346\217\220\344\276\233\345\225\206</label>\n                        <select\n                          value={settingsProvider}\n                          onChange={(e) => setSettingsProvider(e.target.value)}\n                          className=\"w-full border border-slate-205 rounded-xl p-2.5 bg-slate-50 focus:outline-none font-bold\"\n                        >\n                          <option value=\"Google AI Studio\">\360\237\233\241\357\270\217 Google AI Studio (\346\216\250\350\215\220\345\206\205\347\275\256\346\234\215\345\212\241\345\231\250\344\273\243\347\220\206)</option>\n                          <option value=\"OpenAI Sandbox\">\360\237\214\220 OpenAI Sandbox \346\241\206\346\236\266\344\273\243\347\220\206</option>\n                        </select>\n                      </div>\n\n                      <div className=\"space-y-1 text-xs\">\n                        <div className=\"flex justify-between items-center\">\n                          <label className=\"text-[11px] text-slate-500 font-bold\">API Key \346\216\210\346\235\203\347\247\230\351\222\245 (\351\200\211\345\241\253)</label>\n                          <button\n                            type=\"button\"\n                            onClick={() => setShowKey(!showKey)}\n                            className=\"text-[9.5px] text-slate-450 hover:text-slate-700 font-bold cursor-pointer select-none\"\n                          >\n                            {showKey ? \"\351\232\220\350\227\217\" : \"\346\230\276\347\244\272\346\230\216\346\226\207\"}\n                          </button>\n                        </div>\n                        <div className=\"relative\">\n                          <input\n                            type={showKey ? \"text\" : \"password\"}\n                            placeholder=\"\345\246\202\351\234\200\346\234\254\345\234\260\347\233\264\350\277\236\345\210\206\346\236\220\350\257\267\350\276\223\345\205\245 API \347\247\230\351\222\245\357\274\214\347\251\272\347\235\200\345\210\231\344\275\277\347\224\250\346\234\215\345\212\241\345\231\250\347\273\237\344\270\200\347\275\221\345\205\263\"\n                            value={settingsKey}\n                            onChange={(e) => setSettingsKey(e.target.value)}\n                            className=\"w-full border border-slate-205 rounded-xl p-2.5 pr-8 focus:outline-none bg-slate-50 font-mono\"\n                          />\n                          <Key size={12} className=\"absolute right-3.5 top-3.5 text-slate-400 pointer-events-none\" />\n                        </div>\n                      </div>\n                    </div>\n\n                    <button\n                      type=\"submit\"\n                      className=\"w-full bg-slate-900 hover:bg-slate-950 text-white font-bold py-2.5 rounded-xl text-xs tracking-wide transition-colors shadow cursor-pointer uppercase select-none\"\n                    >\n                      \344\277\235\345\255\230\344\270\252\344\272\272\351\205\215\347\275\256\345\217\202\346\225\260\n                    </button>\n\n                  </div>\n                </form>\n\n                {/* Portability / Backup block */}\n                <div className=\"bg-white border border-slate-200 rounded-2xl p-6 shadow-sm space-y-4\">\n                  <h4 className=\"font-bold text-slate-900 text-xs flex items-center gap-1.5 select-none\">\n                    <Database size={13} className=\"text-slate-500\" />\n                    <span>\346\225\260\346\215\256\345\244\207\344\273\275\346\211\223\346\211\223\345\215\241\345\214\205\347\256\241\346\235\237\345\215\241\347\211\207</span>\n                  </h4>\n\n                  <p className=\"text-[10.5px] text-slate-500 leading-relaxed text-justify\">\n                    \347\263\273\347\273\237\347\273\235\344\270\215\351\224\201\346\255\273\344\273\273\344\275\225\346\211\223\345\215\241\350\252\223\346\204\277\357\274\201\346\202\250\345\217\257\344\273\245\351\200\232\350\277\207\345\257\274\345\207\272\347\224\237\346\210\220\345\244\207\344\273\275 JSON \345\257\271\346\216\245\345\210\260\346\211\213\346\234\272\345\205\266\345\256\203\350\256\276\345\244\207\357\274\214\346\210\226\344\273\216\345\244\226\351\203\250\345\212\240\350\275\275\344\277\256\350\241\214\346\225\260\346\215\256\343\200\202\n                  </p>\n\n                  <div className=\"grid grid-cols-2 gap-2 text-xs\">\n                    <button\n                      onClick={handleExportJSON}\n                      type=\"button\"\n                      className=\"bg-slate-50 hover:bg-slate-100 border border-slate-200 rounded-xl py-2.5 font-semibold text-slate-700 flex items-center justify-center gap-1.5 transition-colors cursor-pointer select-none\"\n                    >\n                      <ArrowDownToLine size={13} className=\"text-slate-400\" />\n                      <span>\345\257\274\345\207\272\346\211\223\345\215\241 JSON</span>\n                    </button>\n\n                    <div className=\"relative\">\n                      <button\n                        type=\"button\"\n                        className=\"w-full bg-slate-50 hover:bg-slate-100 border border-slate-200 rounded-xl py-2.5 font-semibold text-slate-700 flex items-center justify-center gap-1.5 transition-colors cursor-pointer select-none\"\n                      >\n                        <ArrowUpToLine size={13} className=\"text-slate-400\" />\n                        <span>\345\257\274\345\205\245\346\211\223\345\215\241 JSON</span>\n                      </button>\n                      \n                      <input\n                        type=\"file\"\n                        accept=\".json\"\n                        onChange={handleImportJSON}\n                        className=\"absolute inset-0 opacity-0 cursor-pointer w-full h-full\"\n                      />\n                    </div>\n                  </div>\n\n                  <div className=\"pt-2\">\n                    <button\n                      onClick={handleLogout}\n                      type=\"button\"\n                      className=\"w-full bg-rose-50 hover:bg-rose-100 border border-rose-100 hover:border-rose-200 text-rose-700 rounded-xl py-2.5 text-xs font-bold transition-colors cursor-pointer text-center select-none flex items-center justify-center gap-1.5\"\n                    >\n                      <LogOut size={13} className=\"text-rose-500\" />\n                      <span>\351\200\200\345\207\272\345\275\223\345\211\215\344\277\256\350\241\214\350\264\246\346\210\267\345\271\266\346\270\205\347\220\206\346\234\254\345\234\260\347\274\223\345\255\230</span>\n                    </button>\n                  </div>\n                </div>\n\n                {syncStatus && (\n                  <p className=\"text-[10.5px] text-emerald-800 bg-emerald-50 border border-emerald-100 p-3 rounded-xl font-medium text-center select-none\">\n                    {syncStatus}\n                  </p>\n                )}\n\n              </motion.div>\n            )}\n\n          </AnimatePresence>\n          \n        </div>\n      </main>\n\n      {/* Styled Mobile Bottom Navigation Tab Bar (3 tabs representation) */}\n      <nav className=\"fixed bottom-0 left-0 right-0 z-40 bg-white border-t border-slate-200 px-3 py-1.5 shadow-lg select-none pb-safe\">\n        <div className=\"max-w-md mx-auto grid grid-cols-3 text-center gap-1.5\">\n          \n          {/* Tab 1: Home page (\344\270\273\351\241\265) */}\n          <button\n            onClick={() => setActiveTab(\"home\")}\n            className={`py-2 px-1 flex flex-col items-center justify-center rounded-xl transition-all cursor-pointer ${\n              activeTab === \"home\"\n                ? \"bg-slate-100 text-slate-900 font-bold scale-[1.01]\"\n                : \"text-slate-500 hover:text-slate-800\"\n            }`}\n          >\n            <ListTodo size={17} className={activeTab === \"home\" ? \"stroke-[2.5] text-slate-900\" : \"stroke-2\"} />\n            <span className=\"text-[10px] mt-0.5 tracking-tight font-sans\">\350\207\252\345\276\213\344\277\256\350\241\214\345\235\212</span>\n          </button>\n\n          {/* Tab 2: Login and registry (\347\231\273\345\275\225\346\263\250\345\206\214\351\241\265) */}\n          <button\n            onClick={() => setActiveTab(\"auth\")}\n            className={`py-2 px-1 flex flex-col items-center justify-center rounded-xl transition-all cursor-pointer ${\n              activeTab === \"auth\"\n                ? \"bg-slate-100 text-slate-900 font-bold scale-[1.01]\"\n                : \"text-slate-500 hover:text-slate-800\"\n            }`}\n          >\n            <User size={17} className={activeTab === \"auth\" ? \"stroke-[2.5] text-slate-909\" : \"stroke-2\"} />\n            <span className=\"text-[10px] mt-0.5 tracking-tight font-sans\">\347\231\273\345\275\225\344\270\216\346\263\250\345\206\214</span>\n          </button>\n\n          {/* Tab 3: Configuration Settings (\350\256\276\347\275\256\351\241\265) */}\n          <button\n            onClick={() => setActiveTab(\"settings\")}\n            className={`py-2 px-1 flex flex-col items-center justify-center rounded-xl transition-all cursor-pointer ${\n              activeTab === \"settings\"\n                ? \"bg-slate-100 text-slate-900 font-bold scale-[1.01]\"\n                : \"text-slate-500 hover:text-slate-800\"\n            }`}\n          >\n            <Settings size={17} className={activeTab === \"settings\" ? \"stroke-[2.5] text-slate-905\" : \"stroke-2\"} />\n            <span className=\"text-[10px] mt-0.5 tracking-tight font-sans\">\350\256\276\347\275\256\344\270\255\345\277\203</span>\n          </button>\n\n        </div>\n      </nav>\n\n      {/* Check In Pop-up Module */}\n      <CheckInModal\n        isOpen={isCheckInOpen}\n        onClose={() => setIsCheckInOpen(false)}\n        todayMealsCount={mealItems.filter(m => m.date === todayStr).length}\n        onAddSleep={handleAddSleep}\n        onAddDiet={handleAddDiet}\n        onAddWorkout={handleAddWorkout}\n        onAddStudy={handleAddStudy}\n        isAnalyzingImage={isAnalyzingImage}\n        setIsAnalyzingImage={setIsAnalyzingImage}\n      />\n\n    </div>\n  );\n}\n"
    }
